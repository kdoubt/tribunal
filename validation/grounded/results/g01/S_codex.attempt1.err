     3	function timeAgo(iso: string): string {
     4	  const seconds = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
     5	  if (seconds < 60) return "just now";
     6	  const minutes = Math.floor(seconds / 60);
     7	  if (minutes < 60) return `${minutes}m ago`;
     8	  const hours = Math.floor(minutes / 60);
     9	  if (hours < 24) return `${hours}h ago`;
    10	  const days = Math.floor(hours / 24);
    11	  if (days < 30) return `${days}d ago`;
    12	  return new Date(iso).toLocaleDateString();
    13	}
