   551	  const plan = auth.plan;
   552	  const ttl = resolvedTtlHours(body.ttl_hours, plan);
   553	
   554	  // Take screenshots at each viewport + extract sitemap from first page
   555	  const fileRecords: Array<{ filename: string; bytes: number; r2_key: string; sha256: string }> = [];
   556	  const itemId = generateId();
   557	  let totalBytes = 0;
   558	  let sitemapText = "";
   559	
   560	  // Determine wait strategy based on host
   561	  const targetHost = new URL(url).hostname.toLowerCase();
   562	  const isHeavySpa = HEAVY_SPA_HOSTS.has(targetHost);
   563	
   564	  try {
   565	    const browser = await puppeteer.launch(env.BROWSER);
   566	
   567	    for (let i = 0; i < viewportNames.length; i++) {
   568	      const vpName = viewportNames[i];
