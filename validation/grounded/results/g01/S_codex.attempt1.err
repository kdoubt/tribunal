   395	    }
   985	// ── whipnode_capture ────────────────────────────────────────
   986	
   987	async function toolCapture(
   988	  args: Record<string, unknown>,
   989	  env: Env,
   990	  auth: AuthIdentity
   991	): Promise<{ content: Array<{ type: string; text: string }> }> {
   992	  const url = String(args.url ?? "");
   993	  if (!url || !/^https?:\/\/.+/.test(url)) {
   994	    return toolError("Error: url is required and must start with http:// or https://.");
   995	  }
   996	
   997	  const fullPage = Boolean(args.full_page ?? false);
   998	  const note = args.note ? String(args.note).slice(0, 4000) : undefined;
   999	
  1000	  // Support both single viewport and multi-viewport
  1001	  const body: Record<string, unknown> = { url, full_page: fullPage, note };
  1002	  if (Array.isArray(args.viewports) && args.viewports.length > 0) {
  1003	    body.viewports = args.viewports.map(String);
  1004	  } else if (args.viewport) {
  1005	    body.viewport = String(args.viewport);
  1006	  }
  1007	
  1008	  // Build an internal Request and call handleCapture directly
  1009	  const fakeRequest = new Request("https://internal/api/v1/captures", {
  1010	    method: "POST",
  1011	    headers: { "Content-Type": "application/json" },
  1012	    body: JSON.stringify(body),
  1013	  });
  1014	
  1015	  // Use a no-op execution context for the direct call
  1016	  const ctx = { waitUntil: () => {}, passThroughOnException: () => {} } as unknown as ExecutionContext;
  1017	
  1018	  try {
  1019	    const resp = await handleCapture(fakeRequest, env, ctx, auth);
  1020	
  1021	    if (resp.status !== 201) {
  1022	      const errData = await resp.json().catch(() => null) as { error?: { message?: string } } | null;
  1023	      return toolError(errData?.error?.message ?? `Capture failed: ${resp.status}`);
  1024	    }
  1025	
  1026	    const data = await resp.json() as {
  1027	      id: string;
  1028	      url: string;
  1029	      captured_url: string;
  1030	      viewports: string[];
  1031	      prompt_url: string;
  1032	    };
  1033	
  1034	    const viewportStr = data.viewports?.length > 0 ? data.viewports.join(", ") : "desktop";
  1035	    const isGoogleSheet = data.captured_url.includes("docs.google.com/spreadsheets");
  1036	
  1037	    const lines = isGoogleSheet
  1038	      ? [
  1039	          `Google Sheet exported as CSV: ${data.captured_url}`,
  1040	          `View: ${data.url}`,
  1041	          `Prompt pack: ${data.prompt_url}`,
  1042	          "",
  1043	          "The CSV data is ready. Fetch the prompt pack URL to get the structured content.",
  1044	        ]
  1045	      : [
  1046	          `Screenshot captured: ${data.captured_url}`,
  1047	          `Viewports: ${viewportStr}`,
  1048	          `View: ${data.url}`,
  1049	          `Live preview: ${env.APP_BASE_URL}/live/${data.id}`,
  1050	          `Prompt pack: ${data.prompt_url}`,
  1051	          "",
  1052	          "The screenshot is being processed with OCR. A sitemap of the page's navigation has also been extracted.",
  1053	          "Fetch the prompt pack URL in a few seconds to get the extracted text and site structure.",
  1054	        ];
  1055	
  1056	    return {
  1057	      content: [{ type: "text", text: lines.join("\n") }],
  1058	    };
  1059	  } catch (err) {
  1060	    console.error("MCP toolCapture error:", err);
  1061	    return toolError("Failed to capture URL. The page may be unreachable or took too long to load.");
  1062	  }
  1063	}
