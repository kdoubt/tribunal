    25	function CopyBlock({ code, isPlaceholder }: { code: string; isPlaceholder: boolean }) {
    26	  const [status, setStatus] = useState<"idle" | "copied" | "warn">("idle");
    27	
    28	  const handleCopy = async () => {
    29	    if (isPlaceholder) {
    30	      setStatus("warn");
    31	      setTimeout(() => setStatus("idle"), 3000);
    32	      return;
    33	    }
    34	    await navigator.clipboard.writeText(code);
    35	    setStatus("copied");
    36	    setTimeout(() => setStatus("idle"), 2000);
    37	  };
    38	
    39	  return (
    40	    <div className="copy-block">
    41	      <pre><code>{code}</code></pre>
    42	      <button className="copy-block-btn" onClick={handleCopy} aria-label="Copy code">
    43	        {status === "copied" ? "Copied!" : status === "warn" ? "Replace key first" : "Copy code"}
    44	      </button>
    45	      {status === "warn" && (
    46	        <p className="copy-block-warn">
    47	          This command uses a placeholder. Create a new key or copy your existing key from above, then replace YOUR_API_KEY before running.
    48	        </p>
    49	      )}
    50	    </div>
    51	  );
    52	}
