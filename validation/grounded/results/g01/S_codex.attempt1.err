   609	      const filename = `capture-${vpName}.png`;
   610	      const r2Key = r2Keys.original(itemId, filename);
   611	      const fileHash = await sha256Bytes(screenshotBytes.buffer as ArrayBuffer);
   612	
   613	      await env.R2.put(r2Key, screenshotBytes, {
   614	        httpMetadata: { contentType: "image/png" },
   615	      });
