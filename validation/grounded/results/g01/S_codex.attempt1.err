   570	      const page = await browser.newPage();
   571	      await page.setUserAgent(CHROME_UA);
   572	      await page.setViewport(vp);
   573	
   574	      // Navigate with adaptive wait strategy
   575	      if (isHeavySpa) {
   576	        // Heavy SPAs keep connections alive — use networkidle2 + extra settle time
   577	        await page.goto(url, { waitUntil: "networkidle2", timeout: MAX_WAIT_MS });
   578	        // Give the SPA extra time to render after network settles
   579	        await new Promise((r) => setTimeout(r, 3000));
   580	      } else {
   581	        // Standard sites — try networkidle0, fall back to networkidle2
   582	        try {
   583	          await page.goto(url, { waitUntil: "networkidle0", timeout: MAX_WAIT_MS });
   584	        } catch (navErr: any) {
   585	          if (navErr?.message?.includes("timeout")) {
   586	            // Page loaded but still has active connections — take what we have
   587	            console.log(`networkidle0 timeout for ${url}, proceeding with current state`);
   588	          } else {
   589	            throw navErr;
   590	          }
   591	        }
   592	      }
