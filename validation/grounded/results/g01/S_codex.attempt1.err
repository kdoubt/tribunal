   652	  // Hash client metadata
   653	  const ip = request.headers.get("CF-Connecting-IP") ?? "";
   654	  const ua = request.headers.get("User-Agent") ?? "";
   655	  const ipHash = ip ? await hashIp(ip) : null;
   656	  const uaHash = ua ? await hashUserAgent(ua) : null;
   657	
   658	  const defaultNote = viewportNames.length === 1
   659	    ? `Screenshot of ${url} (${viewportNames[0]})`
   660	    : `Screenshots of ${url} (${viewportNames.join(", ")})`;
   661	
   662	  // Insert item
   663	  await env.DB.prepare(
   664	    `INSERT INTO items (id, account_id, created_at, expires_at, status, note,
   665	     client_type, origin, file_count, total_bytes, ocr_status, moderation_status,
   666	     public_token, source_ip_hash, user_agent_hash, device_id)
   667	     VALUES (?, ?, ?, ?, 'processing', ?, 'agent', 'capture', ?, ?, 'pending', 'pending', ?, ?, ?, ?)`
   668	  )
   669	    .bind(
   670	      itemId,
   671	      auth.accountId,
   672	      now,
   673	      expiresAt,
   674	      note ?? defaultNote,
