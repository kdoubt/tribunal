   681	    )
   682	    .run();
   683	
   684	  // Insert file records
   685	  for (const f of fileRecords) {
   686	    const mimeType = f.filename.endsWith(".txt") ? "text/plain" : "image/png";
   687	    await env.DB.prepare(
   688	      `INSERT INTO item_files (item_id, filename, mime_type, bytes, r2_key, sha256, kind)
   689	       VALUES (?, ?, ?, ?, ?, ?, 'original')`
   690	    )
   691	      .bind(itemId, f.filename, mimeType, f.bytes, f.r2_key, f.sha256)
   692	      .run();
   693	  }
   694	
   695	  // Enqueue for OCR + output generation (only image files need processing)
   696	  const queueMsg: ItemProcessingMessage = {
   697	    item_id: itemId,
   698	    files: fileRecords
   699	      .filter((f) => f.filename.endsWith(".png"))
   700	      .map((f) => ({
   701	        filename: f.filename,
   702	        mime_type: "image/png",
   703	        r2_key: f.r2_key,
   704	      })),
   705	  };
   706	  await env.QUEUE.send(queueMsg);
   707	
   708	  const base = env.APP_BASE_URL;
   709	  return Response.json({
   710	    id: itemId,
   711	    status: "processing",
   712	    captured_url: url,
   713	    viewports: viewportNames,
   714	    url: `${base}/p/${itemId}`,
   715	    json_url: `${base}/api/v1/items/${itemId}`,
   716	    markdown_url: `${base}/api/v1/items/${itemId}.md`,
   717	    prompt_url: `${base}/api/v1/items/${itemId}/prompt.md`,
   718	    expires_at: expiresAt,
   719	  }, { status: 201 });
   720	}

