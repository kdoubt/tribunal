   617	      totalBytes += screenshotBytes.byteLength;
   618	      fileRecords.push({ filename, bytes: screenshotBytes.byteLength, r2_key: r2Key, sha256: fileHash });
   619	    }
   620	
   621	    await browser.close();
   622	  } catch (err) {
   623	    console.error("Browser Rendering error:", err);
   624	    return apiError(ErrorCodes.INTERNAL_ERROR, "Failed to capture URL. The page may be unreachable or took too long to load.");
   625	  }
