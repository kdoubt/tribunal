    47	export async function handleRevokeMcpDevice(
    48	  deviceId: string,
    49	  env: Env,
    50	  auth: AuthIdentity | null
    51	): Promise<Response> {
    52	  if (!auth) {
    53	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    54	  }
    55	
    56	  const device = await env.DB.prepare(
    57	    "SELECT id, status FROM mcp_devices WHERE id = ? AND account_id = ?"
    58	  )
    59	    .bind(deviceId, auth.accountId)
    60	    .first<{ id: string; status: string }>();
    61	
    62	  if (!device) {
    63	    return apiError(ErrorCodes.ITEM_NOT_FOUND, "Device not found.");
    64	  }
    65	
    66	  if (device.status !== "active") {
    67	    return Response.json({ ok: true, message: "Device is already revoked." });
    68	  }
    69	
    70	  await env.DB.prepare("UPDATE mcp_devices SET status = 'revoked' WHERE id = ?")
    71	    .bind(deviceId)
    72	    .run();
    73	
    74	  return Response.json({ ok: true, message: "Device revoked. It will need to re-authenticate on next request." });
    75	}
