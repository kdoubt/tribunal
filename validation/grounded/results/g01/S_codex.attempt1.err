    77	    for (const a of Array.from(anchors)) {
    78	      const href = (a as HTMLAnchorElement).href;
    79	      if (!href || href.startsWith("javascript:") || href.startsWith("#") || href === "about:blank") continue;
    80	
    81	      const text = (a.textContent || "").trim().slice(0, 80);
    82	      if (!text) continue;
    83	
    84	      // Determine context
    85	      let context = "other";
    86	      let el: HTMLElement | null = a as HTMLElement;
    87	      while (el) {
    88	        const tag = el.tagName?.toLowerCase();
    89	        if (tag === "nav") { context = "nav"; break; }
    90	        if (tag === "header") { context = "header"; break; }
    91	        if (tag === "footer") { context = "footer"; break; }
    92	        if (tag === "main" || tag === "article") { context = "main"; break; }
    93	        el = el.parentElement;
    94	      }
    95	
    96	      results.push({ href, text, context });
    97	    }
    98	    return results;
    99	  });
