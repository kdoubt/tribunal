     1	#!/usr/bin/env bash
     2	# Alert if any estate-spine node's JetStream file store exceeds 80% of its 15GB limit.
     3	LIMIT=$((15*1024*1024*1024)); THRESH=80; LOG=/var/log/nats-monitor.log
     4	for n in <lan-address> <lan-address> <lan-address>; do
     5	  used=$(curl -s --max-time 6 "http://$n:8222/jsz" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("store",0))' 2>/dev/null)
     6	  [ -z "$used" ] && { echo "$(date -u +%FT%TZ) WARN $n unreachable" | tee -a "$LOG"; continue; }
     7	  pct=$(( used*100/LIMIT ))
     8	  msg="$(date -u +%FT%TZ) $n store ${pct}% ($((used/1024/1024))MB/15GB)"
     9	  if [ "$pct" -ge "$THRESH" ]; then echo "$msg ALERT>=${THRESH}%" | tee -a "$LOG"; else echo "$msg" >> "$LOG"; fi
    10	done

