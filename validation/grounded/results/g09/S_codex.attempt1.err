    20	export function CrmSimulator() {
    21	  const [state, dispatch] = useReducer(simReducer, initialState);
    22	  const [activeTab, setActiveTab] = useState<Tab>('dashboard');
    23	
    24	  // Listen for CRM events from the simulator bridge
    25	  useEffect(() => {
    26	    function onInit(e: Event) {
    27	      const detail = (e as CustomEvent).detail;
    28	      dispatch({ type: 'INIT', payload: detail });
    29	    }
    30	    function onMessage(e: Event) {
    31	      const detail = (e as CustomEvent).detail;
    32	      dispatch({ type: 'MESSAGE', payload: detail });
    33	    }
    34	    function onDone(e: Event) {
    35	      const detail = (e as CustomEvent).detail;
    36	      dispatch({ type: 'DONE', payload: detail });
    37	    }
    38	
    39	    document.addEventListener('crm:init', onInit);
    40	    document.addEventListener('crm:message', onMessage);
    41	    document.addEventListener('crm:done', onDone);
    42	
    43	    // Flush any events that arrived before React mounted
    44	    flushSimulatorBuffer();
    45	
    46	    return () => {
    47	      document.removeEventListener('crm:init', onInit);
    48	      document.removeEventListener('crm:message', onMessage);
    49	      document.removeEventListener('crm:done', onDone);
    50	    };
    51	  }, []);
    52	
    53	  // Clear highlight fields after animation
    54	  useEffect(() => {
    55	    if (state.highlightFields.length > 0) {
    56	      const timer = setTimeout(() => dispatch({ type: 'CLEAR_HIGHLIGHTS' }), 1500);
    57	      return () => clearTimeout(timer);
    58	    }
    59	  }, [state.highlightFields]);
    60	
    61	  // Listen for reset event (when "Try Another URL" is clicked)
    62	  useEffect(() => {
    63	    function onReset() {
    64	      dispatch({ type: 'RESET' });
    65	    }
    66	    document.addEventListener('crm:reset', onReset);
    67	    return () => document.removeEventListener('crm:reset', onReset);
    68	  }, []);
    69	
    70	  const handleTabClick = useCallback((tab: Tab) => {
    71	    setActiveTab(tab);
    72	  }, []);
    73	
    74	  return (
    75	    <div className="rounded-xl border border-gray-200 bg-gray-50 shadow-sm">
    76	      {/* Tab Navigation */}
    77	      <div className="border-b border-gray-200 bg-white rounded-t-xl">
    78	        <nav className="flex overflow-x-auto px-4" aria-label="CRM Simulator Tabs">
    79	          {TABS.map((tab) => (
    80	            <button
    81	              key={tab.key}
    82	              type="button"
    83	              onClick={() => handleTabClick(tab.key)}
    84	              className={`shrink-0 border-b-2 px-4 py-3 text-sm font-medium transition-colors ${
    85	                activeTab === tab.key
    86	                  ? 'border-blue-600 text-blue-600'
    87	                  : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700'
    88	              }`}
    89	            >
    90	              {tab.label}
    91	              {tab.key === 'leads' && state.lead && (
    92	                <span className="ml-1.5 inline-flex h-4 w-4 items-center justify-center rounded-full bg-green-100 text-[10px] font-bold text-green-700">
    93	                  1
    94	                </span>
    95	              )}
    96	              {tab.key === 'conversation' && state.conversation.messages.length > 0 && (
    97	                <span className="ml-1.5 inline-flex h-4 w-4 items-center justify-center rounded-full bg-blue-100 text-[10px] font-bold text-blue-700">
    98	                  {state.conversation.messages.length}
    99	                </span>
   100	              )}
   101	            </button>
   102	          ))}
   103	        </nav>
   104	      </div>
   105	
   106	      {/* Tab Content */}
   107	      <div className="p-4">
   108	        {activeTab === 'dashboard' && <DashboardTab state={state} />}
   109	        {activeTab === 'contacts' && <ContactsTab state={state} />}
   110	        {activeTab === 'leads' && <LeadsTab state={state} />}
   111	        {activeTab === 'conversation' && <ConversationTab state={state} />}
   112	        {activeTab === 'pipeline' && <PipelineTab state={state} />}
   113	      </div>
   114	
   115	      {/* Footer */}
   116	      {state.lastUpdate && (
   117	        <div className="border-t border-gray-200 bg-white rounded-b-xl px-4 py-2">
   118	          <p className="text-xs text-gray-400">
   119	            Last updated: {new Date(state.lastUpdate).toLocaleTimeString()}
   120	          </p>
   121	        </div>
   122	      )}
   123	    </div>
   124	  );
   125	}
