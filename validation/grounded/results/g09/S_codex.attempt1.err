   281	      />
   282	    );
   283	  }
   284	
   285	  if (error) {
   286	    return (
   287	      <div className="flex h-full items-center justify-center bg-white p-6 text-center">
   288	        <p className="text-sm text-gray-500">{error}</p>
   289	      </div>
   290	    );
   291	  }
   292	
   293	  // LAUNCH-03 RATE_LIMITED send-button gating is parent-owned via
   294	  // rateLimitedUntil + a 1Hz tick. ErrorMessage receives remaining seconds
   295	  // as a presentational prop so disable state re-evaluates live.
