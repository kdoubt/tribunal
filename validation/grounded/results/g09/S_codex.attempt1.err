   470	
   471	/** Load prefetch metadata if the screenshot + JSON exist and URL matches. */
   472	async function loadPrefetch(id: string, expectedUrl: string): Promise<PrefetchMeta | null> {
   473	  try {
   474	    const screenshot = await getScreenshot(id);
   475	    if (!screenshot) return null;
   476	    const raw = await getMetadata(id);
   477	    if (!raw) return null;
   478	    const meta = raw as unknown as PrefetchMeta;
   479	    if (meta.url !== expectedUrl) return null;
   480	    const createdAt = typeof meta.createdAt === 'number' ? meta.createdAt : 0;
   481	    if (createdAt && Date.now() - createdAt > PREFETCH_TTL_MS) return null;
   482	    return meta;
   483	  } catch {
   484	    return null;
   485	  }
   486	}

