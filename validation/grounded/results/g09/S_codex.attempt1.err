    20	  _request: NextRequest,
    21	  { params }: { params: Promise<{ id: string }> },
    22	) {
    23	  try {
    24	    const { id: token } = await params;
    25	
    26	    // Hard-cutover backstop: bare 32-hex IDs return 403, with best-effort audit row.
    27	    // /i flag matches both lowercase and uppercase hex so the audit trail stays
    28	    // consistent with extractScreenshotIdFromUrl() in screenshot-signing.ts which
    29	    // also matches case-insensitively. Without /i, an uppercase 32-hex id would
    30	    // fall through to verifyScreenshotToken() and 403 silently with NO audit row,
    31	    // breaking the legacy-access forensic trail (WR-08).
