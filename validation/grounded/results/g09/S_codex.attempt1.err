    11	
    12	export async function persistAndFinalize(
    13	  session: ChatSession,
    14	  sessionId: string,
    15	  sanitized: string,
    16	  reply: string,
    17	  done: boolean,
    18	  leadToolArgs: Record<string, unknown> | null,
    19	  ip: string,
    20	): Promise<{ crmData?: Record<string, unknown> }> {
    21	  // Save assistant reply — encrypt before insert (HIPAA-01 write boundary).
    22	  await prisma.chatMessage.create({
    23	    data: {
    24	      conversationId: session.conversationId,
    25	      organizationId: session.organizationId,
    26	      role: 'ASSISTANT',
    27	      content: encryptPHI(reply),
    28	    },
    29	  });
    30	
    31	  // Update session
    32	  session.messageCount += 1;
    33	  if (done) {
    34	    session.done = true;
    35	    const isDemoConversation = session.type === 'WIDGET_QUALIFIER' && !!session.metadata?.demoMode;
    36	    await prisma.$transaction(async (tx) => {
    37	      await tx.conversation.update({
    38	        where: { id: session.conversationId },
    39	        data: { status: 'COMPLETED', completedAt: new Date() },
    40	      });
    41	
    42	      await enqueueOutboxEvent(tx, {
    43	        organizationId: session.organizationId,
    44	        event: {
    45	          type: 'CHAT_CONVERSATION_COMPLETED',
    46	          payload: {
    47	            organizationId: session.organizationId,
    48	            conversationId: session.conversationId,
    49	            isDemoConversation,
    50	          },
    51	        },
    52	      });
    53	    });
    54	  }
    55	  await setSession(sessionId, session);
    56	
    57	  // HIPAA audit log
    58	  logEvent('audit:chat_message', { ip, sessionId, messageCount: session.messageCount });
    59	
    60	  // Analytics
    61	  const demoTokenFromSession = session.metadata?.demoToken as string | undefined;
    62	  try {
    63	    const posthog = getPostHog();
    64	    if (posthog) {
    65	      posthog.capture({
    66	        distinctId: demoTokenFromSession || sessionId,
    67	        event: EVENTS.CHAT_WIDGET_MESSAGE,
    68	        properties: { organizationId: session.organizationId, messageCount: session.messageCount, sessionId, demoToken: demoTokenFromSession },
    69	      });
    70	    }
    71	  } catch (posthogErr) {
    72	    console.error('[posthog] Message tracking failed:', posthogErr);
    73	  }
    74	
    75	  // Build crmData for demo sessions
    76	  let crmData: Record<string, unknown> | undefined;
    77	  if (session.metadata?.demoMode) {
    78	    const preChatMeta = session.metadata?.preChatData as
    79	      | { firstName?: string; lastName?: string; email?: string; paymentType?: string }
    80	      | undefined;
    81	    crmData = {
    82	      contact: {
    83	        firstName: preChatMeta?.firstName || null,
    84	        lastName: preChatMeta?.lastName || null,
    85	        email: preChatMeta?.email || null,
    86	        phone: typeof (session.metadata as Record<string, unknown>)?.phone === 'string'
    87	          ? (session.metadata as Record<string, unknown>).phone
    88	          : null,
    89	        company: (session.metadata as Record<string, unknown>)?.orgName || null,
    90	      },
    91	      lead: session.leadId
    92	        ? {
    93	            id: session.leadId,
    94	            status: done ? 'QUALIFIED' : 'IN_PROGRESS',
    95	            serviceInterest: leadToolArgs?.serviceInterest ?? null,
    96	            paymentType: leadToolArgs?.paymentType ?? null,
    97	            insuranceProvider: leadToolArgs?.insuranceProvider ?? null,
    98	            relationship: leadToolArgs?.relationship ?? null,
    99	          }
   100	        : null,
   101	      conversation: {
   102	        id: session.conversationId,
   103	        messageCount: session.messageCount,
   104	        status: done ? 'COMPLETED' : 'ACTIVE',
   105	      },
   106	      lastUserMessage: sanitized,
   107	      lastAssistantMessage: reply,
   108	    };
   109	  }
   110	
   111	  // Record messages to DemoShare for replay
   112	  if (session.metadata?.demoMode && demoTokenFromSession) {
   113	    try {
   114	      await appendShareMessage(demoTokenFromSession, { role: 'user', content: sanitized });
   115	      await appendShareMessage(demoTokenFromSession, { role: 'assistant', content: reply }, crmData);
   116	      if (done) {
   117	        await completeDemoShare(demoTokenFromSession, session.conversationId);
   118	      }
   119	    } catch (shareErr) {
   120	      console.error('[demo-share] Failed to record message:', shareErr);
   121	    }
   122	  }
   123	
   124	  return { crmData };
   125	}
     1	import {
     2	  getSession as getSessionFromStore,
     3	  setSession,
     4	  recoverSessionFromDB,
     5	  type ChatSession,
     6	} from '@triagecrm/ai';
     7	import { apiError } from '@/lib/request/errors';
     8	
     9	export async function loadAndValidateSession(
    10	  sessionId: string,
    11	  ip: string,
    12	): Promise<{ session: ChatSession } | { error: Response }> {
    13	  let session = await getSessionFromStore(sessionId);
    14	  if (!session) {
    15	    const recovery = await recoverSessionFromDB(sessionId);
    16	    if (!recovery) {
    17	      return { error: apiError('SESSION_EXPIRED', 'Session expired or invalid', 404) };
    18	    }
    19	    if ('abandoned' in recovery) {
    20	      return { error: Response.json({ reply: 'This conversation has ended due to inactivity. Please start a new chat.', done: true }) };
    21	    }
    22	    // Use recovered session; continue to IP and done/maxMessages checks below
    23	    session = recovery.session;
    24	  }
    25	
    26	  if (session.ipAddress && session.ipAddress !== ip) {
    27	    return { error: apiError('FORBIDDEN', 'Session IP mismatch', 403) };
    28	  }
    29	
    30	  if (session.done) {
    31	    return { error: Response.json({ reply: 'This conversation has ended. Thank you!', done: true }) };
    32	  }
    33	
    34	  if (session.messageCount >= session.maxMessages) {
    35	    await setSession(sessionId, { ...session, done: true });
    36	    return {
    37	      error: Response.json({
    38	        reply: "Thank you for chatting with us! We have all the information we need. A member of our team will be in touch soon.",
    39	        done: true,
    40	      }),
    41	    };
    42	  }
    43	
    44	  return { session };
    45	}
     1	import { randomUUID } from 'crypto';
     2	import { chatSessionLockFailedTotal, getPromRegistry, getRedis } from '@triagecrm/ai';
     3	
     4	const LOCK_TTL_S = 90;
     5	
     6	export async function acquireSessionLock(
     7	  sessionId: string,
     8	): Promise<{ lockKey: string; lockToken: string; heartbeat: ReturnType<typeof setInterval> } | null> {
     9	  const redis = getRedis();
    10	  const lockKey = `chat:lock:${sessionId}`;
    11	  const lockToken = randomUUID();
    12	  let acquired: string | null;
    13	  try {
    14	    acquired = await redis.set(lockKey, lockToken, 'EX', LOCK_TTL_S, 'NX');
    15	  } catch (err) {
    16	    if (getPromRegistry()) {
    17	      chatSessionLockFailedTotal.labels('acquire').inc();
    18	    }
    19	    throw err;
    20	  }
    21	  if (!acquired) return null;
    22	
    23	  const heartbeat = setInterval(async () => {
    24	    try {
    25	      await redis.eval(
    26	        "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('expire', KEYS[1], ARGV[2]) else return 0 end",
    27	        1,
    28	        lockKey,
    29	        lockToken,
    30	        String(LOCK_TTL_S),
    31	      );
    32	    } catch {
    33	      if (getPromRegistry()) {
    34	        chatSessionLockFailedTotal.labels('renew').inc();
    35	      }
    36	      // Best-effort renewal
    37	    }
    38	  }, 20_000);
    39	
    40	  return { lockKey, lockToken, heartbeat };
    41	}
    42	
    43	export async function releaseSessionLock(
    44	  lockKey: string,
    45	  lockToken: string,
    46	  heartbeat: ReturnType<typeof setInterval>,
    47	): Promise<void> {
    48	  clearInterval(heartbeat);
    49	  try {
    50	    const redis = getRedis();
    51	    await redis.eval(
    52	      "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end",
    53	      1,
    54	      lockKey,
    55	      lockToken,
    56	    );
    57	  } catch {
    58	    if (getPromRegistry()) {
    59	      chatSessionLockFailedTotal.labels('release').inc();
    60	    }
    61	    // Best-effort unlock — TTL will expire the key
    62	  }
    63	}
