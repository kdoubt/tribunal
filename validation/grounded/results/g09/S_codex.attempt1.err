    28	/**
    29	 * Lightweight prefetch: capture screenshot + extract page text for industry detection.
    30	 * No contact creation, no demo token — just the slow work.
    31	 *
    32	 * Uses shared fetchPageText() which includes SSRF validation and timer cleanup.
    33	 */
    34	export async function POST(request: NextRequest) {
    35	  // Phase 27 DELIVERY-03: fail-closed posture matching chat widget.
    36	  // ip === 'unknown' returns 400 IP_REQUIRED; Redis throw returns 503
    37	  // SERVICE_UNAVAILABLE. No fail-OPEN swallow remains.
    38	  const ip = getRateLimitIp(request);
    39	  if (ip === 'unknown') return apiError('IP_REQUIRED', 'Unable to identify client', 400);
    40	  try {
    41	    try {
    42	      const { allowed } = await checkRateLimitInstrumented(`demo:prefetch:${ip}`, 30, 3600000, 'demo:prefetch');
    43	      if (!allowed) {
    44	        return apiError('RATE_LIMITED', 'Too many requests.', 429);
    45	      }
    46	    } catch (err) {
    47	      console.error('Rate limit check failed (fail-closed):', err);
    48	      return apiError('SERVICE_UNAVAILABLE', 'Service temporarily unavailable', 503);
    49	    }
    50	
    51	    const jsonResult = await safeParseJson(request);
    52	    if (!jsonResult.ok) return jsonResult.response;
    53	    const body = jsonResult.data;
    54	    const parsed = prefetchSchema.safeParse(body);
    55	    if (!parsed.success) {
    56	      return apiError('INVALID_INPUT', 'Invalid URL', 400);
    57	    }
    58	
    59	    const { url } = parsed.data;
    60	
    61	    // SSRF validation before sending URL to screenshot service
    62	    try {
    63	      await validateNotInternal(url);
    64	    } catch {
    65	      return apiError('URL_BLOCKED', 'This URL cannot be processed.', 400);
    66	    }
    67	
    68	    const holder = await acquireSemaphore('live-preview', MAX_CONCURRENT, SEMAPHORE_TTL_MS);
    69	    if (!holder) {
    70	      return apiError('BUSY', 'Service is busy.', 503);
    71	    }
    72	
    73	    try {
    74	      // Run screenshot capture (with retry) in parallel with page text extraction
    75	      const [captureResult, pageText] = await Promise.all([
    76	        captureAndStore(url, { retries: 1 }),
    77	        fetchPageText(url),
    78	      ]);
    79	
    80	      if (!captureResult.ok) {
    81	        return apiError(captureResult.code, captureResult.error, captureResult.status);
    82	      }
    83	
    84	      const { screenshotId: prefetchId, brandColor, siteName, bookingUrl } = captureResult;
    85	
    86	      // Detect industry from page text (most reliable), fall back to URL + site name
    87	      const detectedIndustry = detectIndustry(`${pageText} ${url} ${siteName}`);
    88	
    89	      await storeMetadata(prefetchId, { brandColor, siteName, bookingUrl, url, detectedIndustry, createdAt: Date.now() });
    90	
    91	      // Warm the 7-day domain cache too: prefetch does the same full capture as
    92	      // submit, so a later submission (or a different visitor) for this domain
    93	      // can reuse it. Best-effort; never throws into the response path.
    94	      await storeDomainCache(url, { screenshotId: prefetchId, brandColor, siteName, bookingUrl, detectedIndustry });
    95	
    96	      return NextResponse.json({
    97	        prefetchId,
    98	        screenshotUrl: `/app/api/public/live-preview/screenshot/${prefetchId}`,
    99	        brandColor,
   100	        siteName,
   101	        detectedIndustry,
   102	      });
   103	    } finally {
   104	      await releaseSemaphore('live-preview', holder);
   105	    }
   106	  } catch (err) {
   107	    console.error('Prefetch error:', err);
   108	    return apiError('INTERNAL_ERROR', 'Unexpected error.', 500);
   109	  }
   110	}
