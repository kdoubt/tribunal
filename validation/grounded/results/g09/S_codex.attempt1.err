     3	export interface DemoMetadata {
     4	  websiteUrl: string;
     5	  brandColor: string;
     6	  siteName: string;
     7	  detectedIndustry: string | null;
     8	  templateId?: string;
     9	}
    10	
    11	export interface DemoMetadataLookupResult {
    12	  contactId: string;
    13	  metadata: DemoMetadata;
    14	  conversationId?: string;
    15	}
    16	
    17	const DEMO_ORG_SLUG = 'triagecrm-demo';
    18	
    19	export async function persistDemoMetadata(
    20	  contactId: string,
    21	  metadata: DemoMetadata,
    22	): Promise<void> {
    23	  const contact = await prisma.contact.findUnique({
    24	    where: { id: contactId },
    25	    select: { customFields: true },
    26	  });
    27	
    28	  const existing = (contact?.customFields as Record<string, unknown>) || {};
    29	
    30	  await prisma.contact.update({
    31	    where: { id: contactId },
    32	    data: {
    33	      customFields: {
    34	        ...existing,
    35	        demoMetadata: {
    36	          websiteUrl: metadata.websiteUrl,
    37	          brandColor: metadata.brandColor,
    38	          siteName: metadata.siteName,
    39	          detectedIndustry: metadata.detectedIndustry,
    40	          templateId: metadata.templateId || null,
    41	          capturedAt: new Date().toISOString(),
    42	        },
    43	      },
    44	    },
    45	  });
    46	}
    47	
    48	export async function findDemoMetadataByEmail(
    49	  email: string,
    50	): Promise<DemoMetadataLookupResult | null> {
    51	  const demoOrg = await prisma.organization.findUnique({
    52	    where: { slug: DEMO_ORG_SLUG },
    53	    select: { id: true },
    54	  });
    55	  if (!demoOrg) return null;
    56	
    57	  const contact = await prisma.contact.findFirst({
    58	    where: { organizationId: demoOrg.id, email: email.toLowerCase() },
    59	    orderBy: { updatedAt: 'desc' },
    60	    select: {
    61	      id: true,
    62	      customFields: true,
    63	    },
    64	  });
    65	  if (!contact) return null;
    66	
    67	  const fields = contact.customFields as Record<string, unknown> | null;
    68	  const demo = fields?.demoMetadata as Record<string, unknown> | undefined;
    69	  if (!demo) return null;
    70	
    71	  // Find most recent conversation for this contact
    72	  const conversation = await prisma.conversation.findFirst({
    73	    where: {
    74	      organizationId: demoOrg.id,
    75	      contactId: contact.id,
    76	    },
    77	    orderBy: { createdAt: 'desc' },
    78	    select: { id: true },
    79	  });
    80	
    81	  return {
    82	    contactId: contact.id,
    83	    metadata: {
    84	      websiteUrl: typeof demo.websiteUrl === 'string' ? demo.websiteUrl : '',
    85	      brandColor: typeof demo.brandColor === 'string' ? demo.brandColor : '#3B82F6',
    86	      siteName: typeof demo.siteName === 'string' ? demo.siteName : '',
    87	      detectedIndustry: typeof demo.detectedIndustry === 'string' ? demo.detectedIndustry : null,
    88	      templateId: typeof demo.templateId === 'string' ? demo.templateId : undefined,
    89	    },
    90	    conversationId: conversation?.id,
    91	  };
    92	}
     1	/** Industry detection: ordered from most specific to least to avoid false positives */
     2	export const INDUSTRY_PATTERNS: Array<{ templateId: string; patterns: RegExp[] }> = [
     3	  {
     4	    templateId: 'physical-therapy',
     5	    patterns: [
     6	      /physical\s*therap/i, /\bpt\s+(clinic|center|office)/i, /\brehabilitation/i,
     7	      /physiotherap/i, /orthopedic/i, /sports\s*medicine/i,
     8	      /\brange\s*of\s*motion/i, /post.?surgical\s*rehab/i,
     9	    ],
    10	  },
    11	  {
    12	    templateId: 'med-spa',
    13	    patterns: [
    14	      /med\s*spa/i, /medspa/i, /medical\s*spa/i, /aestheti/i,
    15	      /\bbotox\b/i, /\bfiller/i, /dermal/i, /cosmetic(?!\s*dentist)/i,
    16	      /laser\s*(?:clinic|center|treatment)/i, /skin\s*(?:clinic|center|care|rejuv)/i,
    17	      /rejuvenat/i, /\bmicroneedl/i, /\bcoolsculpt/i, /body\s*contour/i,
    18	    ],
    19	  },
    20	  {
    21	    templateId: 'dental',
    22	    patterns: [
    23	      /dental/i, /dentist/i, /dentistry/i, /orthodonti/i,
    24	      /oral\s*(?:surgery|health|care)/i, /endodont/i, /periodont/i,
    25	      /\bteeth\s*whiten/i, /\bveneers?\b/i, /\bimplants?\b/i,
    26	      /\bcrowns?\b.*\bbridges?\b/i, /\broot\s*canal/i,
    27	    ],
    28	  },
    29	  {
    30	    templateId: 'chiropractic',
    31	    patterns: [
    32	      /chiro/i, /spinal\s*(?:adjust|decompress|align)/i,
    33	      /spine\s*(?:center|clinic|care)/i, /\badjustment/i,
    34	      /subluxation/i, /\bvertebr/i,
    35	    ],
    36	  },
    37	  {
    38	    templateId: 'psychology-practice',
    39	    patterns: [
    40	      /psycholog/i, /psychiatr/i, /neuropsych/i, /\bpsych(?!otherap)\w/i,
    41	      /\bpsychiatric\s*evaluation/i, /\bpsychological\s*testing/i,
    42	    ],
    43	  },
    44	  {
    45	    templateId: 'therapy-counseling',
    46	    patterns: [
    47	      /\b(?:individual|couples?|family|group)\s*therap/i,
    48	      /\b(?:licensed\s*)?therap(?:y|ist)/i, /counsel(?:ing|or)/i,
    49	      /mental\s*health/i, /\blmft\b/i, /\blcsw\b/i, /\blpc\b/i,
    50	      /behavioral\s*health/i, /social\s*work/i, /psychotherap/i,
    51	      /\banxiety\b/i, /\bdepression\b/i, /\btrauma\b/i, /\bptsd\b/i,
    52	      /\bcbt\b/i, /\bemdr\b/i,
    53	    ],
    54	  },
    55	];
    56	
    57	export function detectIndustry(text: string): string | null {
    58	  for (const { templateId, patterns } of INDUSTRY_PATTERNS) {
    59	    for (const pattern of patterns) {
    60	      if (pattern.test(text)) return templateId;
    61	    }
    62	  }
    63	  return null;
    64	}
