    13	import { apiError, safeParseJson } from '@/lib/request/errors';
    14	import { checkContentLength } from '@/lib/request/body-guard';
    15	
    16	export async function POST(request: NextRequest) {
    17	  try {
    18	    // Fail-closed rate limiting
    19	    const ip = getRateLimitIp(request);
    20	    if (ip === 'unknown') return apiError('IP_REQUIRED', 'Unable to identify client', 400);
    21	    const sizeCheck = checkContentLength(request);
    22	    if (sizeCheck) return sizeCheck;
    23	    try {
    24	      const { allowed } = await checkRateLimitInstrumented(`demo:quickstart:${ip}`, 10, 3600000, 'demo:quickstart');
    25	      if (!allowed) {
    26	        return apiError('RATE_LIMITED', 'Too many requests. Please try again later.', 429);
    27	      }
    28	    } catch (err) {
    29	      console.error('Rate limit check failed (fail-closed):', err);
    30	      return apiError('SERVICE_UNAVAILABLE', 'Service temporarily unavailable', 503);
    31	    }
    32	
    33	    const jsonResult = await safeParseJson(request);
    34	    if (!jsonResult.ok) return jsonResult.response;
    35	    const rawBody = jsonResult.data as any;
    36	    const turnstileToken = rawBody['cf-turnstile-response'] || '';
    37	    const honeypot = rawBody._hp || '';
    38	
    39	    const parsed = quickStartSchema.safeParse(rawBody);
    40	    if (!parsed.success) {
    41	      return apiError('INVALID_INPUT', 'Invalid input', 400);
    42	    }
    43	
    44	    const { templateId } = parsed.data;
    45	
    46	    // Validate template ID against known templates
    47	    const template = FLOW_TEMPLATES.find((t) => t.id === templateId);
    48	    if (!template) {
    49	      return apiError('INVALID_INPUT', 'Unknown template', 400);
    50	    }
    51	
    52	    // Trust controls: honeypot only (no prefetch timing needed for quick-start)
    53	    const trustResult = evaluateTrust({
    54	      honeypotFilled: !!honeypot,
    55	      prefetchElapsedMs: null,
    56	      skipTimingCheck: true,
    57	    });
    58	
    59	    if (!trustResult.trusted) {
    60	      console.log(`[trust:rejected] ip=${ip} reason=${trustResult.reason}`);
    61	      return apiError('REJECTED', 'Unable to process request.', 400);
    62	    }
    63	
    64	    // Turnstile verification — enforce only when configured
    65	    const turnstileConfigured = !!process.env.TURNSTILE_SECRET_KEY;
    66	    if (turnstileConfigured && !turnstileToken) {
    67	      return apiError('TURNSTILE_MISSING', 'Bot verification required.', 403);
    68	    }
    69	    if (turnstileToken) {
    70	      const turnstileValid = await verifyTurnstile(turnstileToken, ip);
    71	      if (!turnstileValid) {
    72	        return apiError('TURNSTILE_FAILED', 'Bot verification failed. Please try again.', 403);
    73	      }
    74	    }
    75	
    76	    // HIPAA audit log
    77	    logEvent('audit:demo_quickstart', { ip, templateId });
    78	
    79	    // Look up demo org
    80	    const demoOrg = await prisma.organization.findUnique({
    81	      where: { slug: 'triagecrm-demo' },
    82	      include: {
    83	        chatbotSettings: { select: { chatbotToken: true } },
    84	      },
    85	    });
    86	
    87	    if (!demoOrg || !demoOrg.chatbotSettings) {
    88	      return apiError('DEMO_NOT_CONFIGURED', 'Demo not configured. Please contact support.', 500);
    89	    }
    90	
    91	    const chatbotToken = demoOrg.chatbotSettings.chatbotToken;
    92	    const brandColor = '#3B82F6'; // Default blue
    93	
    94	    const demoSessionId = await createDemoSession({
    95	      contactId: '', // No contact for quick-start
    96	      orgId: demoOrg.id,
    97	      brandColor,
    98	      orgName: template.name,
    99	      chatbotToken,
   100	    });
   101	
   102	    return Response.json({
   103	      widgetUrl: `/chat/widget/${chatbotToken}?demoSession=${encodeURIComponent(demoSessionId)}&templateId=${encodeURIComponent(templateId)}`,
   104	      templateName: template.name,
   105	      brandColor,
   106	    });
   107	  } catch (err) {
   108	    console.error('Quick-start error:', err);
   109	    return apiError('INTERNAL_ERROR', 'An unexpected error occurred. Please try again.', 500);
   110	  }
   111	}

