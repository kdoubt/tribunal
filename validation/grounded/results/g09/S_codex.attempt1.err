     2	  name: string;
     3	  value: number;
     4	  timestamp: number;
     5	  tags?: Record<string, string>;
     6	}
     7	
     8	interface LatencyRecord {
     9	  name: string;
    10	  durationMs: number;
    11	  timestamp: number;
    12	  tags?: Record<string, string>;
    13	}
    14	
    15	const metrics: Metric[] = [];
    16	const latencies: LatencyRecord[] = [];
    17	const MAX_BUFFER_SIZE = 1000;
    18	
    19	/**
    20	 * Record a counter or gauge metric.
    21	 */
    22	export function recordMetric(
    23	  name: string,
    24	  value: number,
    25	  tags?: Record<string, string>,
    26	): void {
    27	  if (metrics.length >= MAX_BUFFER_SIZE) {
    28	    metrics.shift();
    29	  }
    30	  metrics.push({ name, value, timestamp: Date.now(), tags });
    31	}
    32	
    33	/**
    34	 * Record a latency measurement.
    35	 */
    36	export function recordLatency(
    37	  name: string,
    38	  durationMs: number,
    39	  tags?: Record<string, string>,
    40	): void {
    41	  if (latencies.length >= MAX_BUFFER_SIZE) {
    42	    latencies.shift();
    43	  }
    44	  latencies.push({ name, durationMs, timestamp: Date.now(), tags });
    45	}
    46	
    47	/**
    48	 * Log a structured event for observability.
    49	 */
    50	export function logEvent(
    51	  event: string,
    52	  data?: Record<string, unknown>,
    53	): void {
    54	  console.log(JSON.stringify({
    55	    event,
    56	    timestamp: new Date().toISOString(),
    57	    ...data,
    58	  }));
    59	}
    60	
    61	/**
    62	 * Get a summary of collected metrics (for health/debug endpoints).
    63	 */
    64	export function getMetricsSummary(): {
    65	  metrics: Metric[];
    66	  latencies: LatencyRecord[];
    67	  bufferSize: { metrics: number; latencies: number };
    68	} {
    69	  return {
    70	    metrics: [...metrics],
    71	    latencies: [...latencies],
    72	    bufferSize: {
    73	      metrics: metrics.length,
    74	      latencies: latencies.length,
    75	    },
    76	  };
    77	}
