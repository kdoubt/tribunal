   214	    // replay it from the BUSY error card's "Retry now" button.
   215	    lastUserMessageRef.current = message;
   216	    setMessages((prev) => [...prev, createMessage('user', message)]);
   217	    setSending(true);
   218	
   219	    try {
   220	      const data = await sendWidgetMessage(sessionId, message);
   221	      setMessages((prev) => [...prev, createMessage('assistant', data.reply)]);
   222	      if (data.done) setDone(true);
   223	
   224	      // Forward CRM data to parent window for the live CRM simulator
   225	      if (data.crmData) {
   226	        window.parent.postMessage(
   227	          { type: 'triagecrm:chat-message', payload: data.crmData },
   228	          '*',
   229	        );
   230	      }
   231	      if (data.done) {
   232	        window.parent.postMessage(
   233	          { type: 'triagecrm:chat-done', payload: data.crmData || {} },
