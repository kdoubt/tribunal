   161	  const jpegBuffer = Buffer.from(await screenshotRes.arrayBuffer());
   162	  const brandColor = sanitizeBrandColor(screenshotRes.headers.get('x-brand-color') || '#3B82F6');
   163	  const siteName = sanitizeSiteName(safeDecodeURIComponent(screenshotRes.headers.get('x-site-name') || ''));
   164	  const rawBookingUrl = sanitizeBookingUrl(screenshotRes.headers.get('x-booking-url') || '');
   165	  const bookingUrl = rawBookingUrl ? (await verifyBookingUrl(rawBookingUrl)) ?? '' : '';
   166	
   167	  const screenshotId = randomBytes(16).toString('hex');
   168	
   169	  // Phase 29 DEPLOY-03: storage calls previously propagated uncaught and would
   170	  // crash the route handler. Now caught + emit storage_failed terminal state +
   171	  // return a well-typed failure code. Codex 2026-05-25.
   172	  try {
   173	    await storeScreenshot(screenshotId, jpegBuffer);
   174	    if (options?.storeMetadataPayload) {
   175	      await storeMetadata(screenshotId, {
   176	        ...options.storeMetadataPayload,
   177	        brandColor,
   178	        siteName,
   179	      });
   180	    }
   181	  } catch (err) {
   182	    recordScreenshotOutcome('storage_failed');
   183	    const errorMessage = err instanceof Error ? err.message : 'Storage failure';
   184	    return {
   185	      ok: false,
   186	      error: `Screenshot storage failed: ${errorMessage}`,
   187	      code: 'SCREENSHOT_STORAGE_FAILED',
   188	      status: 503,
   189	    };
   190	  }
   191	
   192	  recordScreenshotOutcome('success');
   193	  return { ok: true, screenshotId, brandColor, siteName, bookingUrl };
   194	}

