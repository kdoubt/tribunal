     3	
     4	/**
     5	 * Domain-level cache for live-preview results.
     6	 *
     7	 * The screenshot capture + page crawl + industry detection is the slow,
     8	 * expensive part of a demo submission (multi-second screenshot service call +
     9	 * full-page fetch). Screenshots are stored persistently in R2 but keyed by a
    10	 * random id, so before this cache every repeat submission of the same site
    11	 * re-screenshotted and re-crawled from scratch.
    12	 *
    13	 * This caches the capture *outputs* keyed by normalized domain for 7 days, so a
    14	 * second visitor submitting the same site reuses the existing screenshot id +
    15	 * extracted branding/industry. The per-submission, per-visitor artifacts (demo
    16	 * session, contact, DemoShare token) are still created fresh downstream — only
    17	 * the screenshot/crawl work is short-circuited.
    18	 */
    19	
    20	const PREFIX = 'live-preview:domain:';
    21	const TTL_SECONDS = 7 * 24 * 60 * 60; // 7 days
    22	
    23	export interface DomainCacheEntry {
    24	  screenshotId: string;
    25	  brandColor: string;
    26	  siteName: string;
    27	  bookingUrl: string;
    28	  detectedIndustry: string | null;
    29	  /** The exact URL that produced this entry (audit / debugging). */
    30	  url: string;
    31	  cachedAt: number;
    32	}
    33	
    34	/**
    35	 * Normalizes a submitted URL to a canonical domain cache key component.
    36	 * Lowercases the host and strips a leading `www.` so https://Example.com,
    37	 * https://www.example.com/, and https://example.com/pricing?x=1 all collapse to
    38	 * `example.com`. Returns null if the URL can't be parsed.
    39	 */
    40	export function normalizeDomain(url: string): string | null {
    41	  try {
    42	    const host = new URL(url).hostname.trim().toLowerCase();
    43	    return host.replace(/^www\./, '') || null;
    44	  } catch {
    45	    return null;
    46	  }
    47	}
    48	
    49	/**
    50	 * Returns a cached capture for this URL's domain, or null on miss / parse
    51	 * failure / Redis error. Defensively verifies the referenced screenshot still
    52	 * exists in storage (R2 lifecycle rules could delete it before the 7-day Redis
    53	 * TTL elapses); a dangling entry is treated as a miss so the caller re-captures.
    54	 */
    55	export async function loadDomainCache(url: string): Promise<DomainCacheEntry | null> {
    56	  const domain = normalizeDomain(url);
    57	  if (!domain) return null;
    58	  try {
    59	    const raw = await getRedis().get(PREFIX + domain);
    60	    if (!raw) return null;
    61	    const entry = JSON.parse(raw) as DomainCacheEntry;
    62	    if (!entry?.screenshotId) return null;
    63	    // Ensure the screenshot blob is still retrievable before reusing it.
    64	    const screenshot = await getScreenshot(entry.screenshotId);
    65	    if (!screenshot) return null;
    66	    return entry;
    67	  } catch {
    68	    return null;
    69	  }
    70	}
    71	
    72	/**
    73	 * Stores a capture result under the URL's normalized domain for 7 days.
    74	 * Best-effort: never throws (caching must not break the request path).
    75	 */
    76	export async function storeDomainCache(
    77	  url: string,
    78	  entry: Omit<DomainCacheEntry, 'url' | 'cachedAt'>,
    79	): Promise<void> {
    80	  const domain = normalizeDomain(url);
    81	  if (!domain) return;
    82	  try {
    83	    const payload: DomainCacheEntry = { ...entry, url, cachedAt: Date.now() };
    84	    await getRedis().set(PREFIX + domain, JSON.stringify(payload), 'EX', TTL_SECONDS);
    85	  } catch {
    86	    /* cache write is best-effort */
    87	  }
    88	}
