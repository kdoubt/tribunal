    26	export function stripHtml(str: string): string {
    27	  return str.replace(/<[^>]*>/g, '').trim();
    28	}
    29	
    30	// ── LLM message building ────────────────────────────────────────────────────
    31	
    32	export async function buildLLMMessages(
    33	  session: ChatSession,
    34	  sanitized: string,
    35	): Promise<{ role: 'system' | 'user' | 'assistant'; content: string }[]> {
    36	  // Save user message — encrypt before insert (HIPAA-01 write boundary).
    37	  await prisma.chatMessage.create({
    38	    data: {
    39	      conversationId: session.conversationId,
    40	      organizationId: session.organizationId,
    41	      role: 'USER',
    42	      content: encryptPHI(sanitized),
    43	    },
    44	  });
    45	
    46	  // Load conversation history
    47	  const history = await prisma.chatMessage.findMany({
    48	    where: { conversationId: session.conversationId },
    49	    orderBy: { createdAt: 'asc' },
    50	  });
    51	
    52	  // System-context read — raw decryptPHI (NO audit per RESEARCH Pitfall 5).
    53	  // History reload happens on every USER message; auditing here would
    54	  // produce thousands of events per chat. Operator transcript views in
    55	  // Plan 25-03 use decryptPHIWithAudit / decryptPHIBatchWithAudit instead.
    56	  let messages: { role: 'system' | 'user' | 'assistant'; content: string }[];
    57	  try {
    58	    messages = history
    59	      .filter((m: { role: string }) => m.role !== 'TOOL')
    60	      .map((m: { role: string; content: string }) => ({
    61	        role: m.role.toLowerCase() as 'system' | 'user' | 'assistant',
    62	        content: decryptPHI(m.content),
    63	      }));
    64	  } catch (err) {
    65	    console.error('[crm:llm-pipeline] history decrypt failed:', err);
    66	    throw new Error('Failed to load conversation history');
    67	  }
    68	
    69	  // RAG context
    70	  let ragContext = '';
    71	  try {
    72	    ragContext = await retrieveContext(session.organizationId, sanitized, 2);
    73	  } catch {
    74	    // ChromaDB might not be available
    75	  }
    76	
    77	  if (ragContext) {
    78	    messages.push({ role: 'system', content: `Relevant information:\n${ragContext}` });
    79	  }
    80	
    81	  return messages;
    82	}
    83	
    84	// ── LLM call + tool handling ─────────────────────────────────────────────────
    85	
    86	export async function callLLMWithTools(
    87	  messages: { role: string; content: string }[],
    88	  session: ChatSession,
    89	  sessionId: string,
    90	): Promise<{ reply: string; done: boolean; leadToolArgs: Record<string, unknown> | null }> {
    91	  const client = getLLMClient();
    92	  // Cast messages to satisfy OpenAI's strict union type — roles are validated upstream
    93	  const typedMessages = messages as Parameters<typeof client.chat.completions.create>[0]['messages'];
    94	  // Phase 29 DEPLOY-03: route through instrumentedCompletion for histogram.
    95	  const completion = await withAbortableTimeout(
    96	    (signal) =>
    97	      instrumentedCompletion(
    98	        {
    99	          model: MODELS.CHAT,
   100	          messages: typedMessages,
   101	          tools: qualifierTools,
   102	          tool_choice: 'auto',
   103	          max_tokens: 1024,
   104	        },
   105	        { signal },
   106	      ),
   107	    30_000,
   108	    'LLM',
   109	  );
   110	
   111	  const assistantMessage = completion.choices[0].message;
   112	  let reply = assistantMessage.content || '';
   113	  let done = false;
   114	  let leadToolArgs: Record<string, unknown> | null = null;
   115	
   116	  // Phase 27 DELIVERY-04: validate native tool_calls against the strict Zod
   117	  // schema map BEFORE dispatch. The previous regex-based text-tool-call parser
   118	  // (which scanned the assistant's reply for inline HTML-style function markup
   119	  // and synthesized tool_calls from it) has been DELETED — that path let any
   120	  // LLM emitting such markup bypass the model's intended tool-use channel and
   121	  // inject arbitrary tool execution. Only provider-native tool_calls are
   122	  // honored now, and each one is dropped silently if:
   123	  //   - its function.name is not in qualifierToolSchemas, OR
   124	  //   - its function.arguments is not parseable JSON, OR
   125	  //   - its parsed arguments fail safeParse (strict schema rejects extras).
   126	  //
   127	  // Dropped calls are logged via console.warn (server-side) and the assistant
   128	  // text reply is preserved without acknowledgement. No retry, no user-visible
   129	  // error — matches the silent-ignore posture decided in Phase 27 CONTEXT.
   130	  if (assistantMessage.tool_calls && assistantMessage.tool_calls.length > 0) {
   131	    const validated: typeof assistantMessage.tool_calls = [];
   132	    for (const tc of assistantMessage.tool_calls) {
   133	      const schema =
   134	        qualifierToolSchemas[tc.function.name as keyof typeof qualifierToolSchemas];
   135	      if (!schema) {
   136	        if (getPromRegistry()) {
   137	          llmToolCallsDroppedTotal.labels('unknown_tool').inc();
   138	        }
   139	        console.warn(`[llm-pipeline] dropping unknown tool: ${tc.function.name}`);
   140	        continue;
   141	      }
   142	      let parsed: unknown;
   143	      try {
   144	        parsed = JSON.parse(tc.function.arguments);
   145	      } catch {
   146	        if (getPromRegistry()) {
   147	          llmToolCallsDroppedTotal.labels('parse_error').inc();
   148	        }
   149	        console.warn(
   150	          `[llm-pipeline] dropping tool with invalid JSON args: ${tc.function.name}`,
   151	        );
   152	        continue;
   153	      }
   154	      const result = schema.safeParse(parsed);
   155	      if (!result.success) {
   156	        if (getPromRegistry()) {
   157	          llmToolCallsDroppedTotal.labels('invalid_schema').inc();
   158	        }
   159	        console.warn(
   160	          `[llm-pipeline] dropping tool with invalid schema: ${tc.function.name}`,
   161	          result.error.flatten(),
   162	        );
   163	        continue;
   164	      }
   165	      validated.push(tc);
   166	    }
   167	    assistantMessage.tool_calls = validated.length > 0 ? validated : undefined;
   168	  }
   169	
   170	  // Handle tool calls
   171	  if (assistantMessage.tool_calls && assistantMessage.tool_calls.length > 0) {
   172	    const { toolResults, leadCreated, leadToolArgs: args } = await executeToolCalls(
   173	      assistantMessage.tool_calls as { id: string; type: string; function: { name: string; arguments: string } }[],
   174	      session, sessionId,
   175	    );
   176	    leadToolArgs = args;
   177	
   178	    if (toolResults.length > 0) {
   179	      try {
   180	        const followUpMessages = [
   181	          ...messages,
   182	          { role: 'assistant' as const, content: assistantMessage.content || '', tool_calls: assistantMessage.tool_calls },
   183	          ...toolResults,
   184	        ] as Parameters<typeof client.chat.completions.create>[0]['messages'];
   185	
   186	        // Phase 29 DEPLOY-03: route through instrumentedCompletion for histogram.
   187	        const followUp = await withAbortableTimeout(
   188	          (signal) =>
   189	            instrumentedCompletion(
   190	              { model: MODELS.CHAT, messages: followUpMessages, max_tokens: 1024 },
   191	              { signal },
   192	            ),
   193	          30_000,
   194	          'LLM follow-up',
   195	        );
   196	        reply = followUp.choices[0]?.message?.content || '';
   197	      } catch (followUpErr) {
   198	        console.error('LLM follow-up call failed:', followUpErr);
   199	        reply = buildToolFallbackReply(assistantMessage.tool_calls || [], toolResults);
   200	      }
   201	
   202	      if (leadCreated) {
   203	        done = true;
   204	        reply = reply || "Thank you! We've got your information and someone from our team will be in touch with you soon.";
   205	      } else if (!reply) {
   206	        reply = buildToolFallbackReply(assistantMessage.tool_calls || [], toolResults);
   207	      }
   208	    }
   209	  }
   210	
   211	  // Safety net: never return an empty reply. When the model emits a native
   212	  // tool_call (content=null → reply='') that then FAILS validation and is
   213	  // dropped (unknown tool / unparseable args / strict-schema reject), the
   214	  // tool-handling block above is skipped entirely and `reply` stays empty.
   215	  // The output guard flags that as `empty-response` and the widget surfaces a
   216	  // dead-end handoff — the "very poor performance" Clearwater symptom. Recover
   217	  // by driving back toward booking instead of returning nothing.
   218	  if (!reply.trim()) {
   219	    console.warn(
   220	      `[llm-pipeline] empty reply recovered with fallback (had_tool_calls=${!!assistantMessage.tool_calls})`,
   221	    );
   222	    reply =
   223	      "Sorry — I didn't quite catch that. To get you booked in, could you share a bit more about what you're looking for, plus a day and time that work? I'll get you scheduled as soon as possible.";
   224	  }
   225	
   226	  return { reply, done, leadToolArgs };
   227	}
     1	import {
     2	  retrieveContext,
     3	  createLeadFromChat,
     4	  getPostHog,
     5	  EVENTS,
     6	  type ChatSession,
     7	} from '@triagecrm/ai';
