   297	    rateLimitedUntil !== null
   298	      ? Math.max(0, Math.ceil((rateLimitedUntil - tickNow) / 1000))
   299	      : 0;
   300	
   301	  return (
   302	    <div className="flex h-full flex-col bg-white">
   303	      {/* Header */}
   304	      <div className="flex items-center gap-3 border-b border-gray-200 px-4 py-3" style={{ backgroundColor: brandColor, color: contrastText(brandColor) }}>
   305	        <div className="h-8 w-8 rounded-full flex items-center justify-center" style={{ backgroundColor: contrastText(brandColor) === '#ffffff' ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.1)' }}>
   306	          <svg className="h-4 w-4" style={{ color: contrastText(brandColor) }} fill="none" viewBox="0 0 24 24" strokeWidth={2} stroke="currentColor">
   307	            <path strokeLinecap="round" strokeLinejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z" />
