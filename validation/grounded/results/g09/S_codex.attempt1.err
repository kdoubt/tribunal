     1	export type CircuitState = 'closed' | 'open' | 'half-open';
     2	
     3	export interface CircuitBreakerConfig {
     4	  failureThreshold: number;
     5	  resetTimeMs: number;
     6	  halfOpenMaxAttempts: number;
     7	}
     8	
     9	const DEFAULT_CONFIG: CircuitBreakerConfig = {
    10	  failureThreshold: 3,
    11	  resetTimeMs: 30_000,
    12	  halfOpenMaxAttempts: 1,
    13	};
    14	
    15	export class CircuitBreaker {
    16	  private state: CircuitState = 'closed';
    17	  private failureCount = 0;
    18	  private lastFailureTime = 0;
    19	  private halfOpenAttempts = 0;
    20	  private readonly config: CircuitBreakerConfig;
    21	
    22	  constructor(config?: Partial<CircuitBreakerConfig>) {
    23	    this.config = { ...DEFAULT_CONFIG, ...config };
    24	  }
    25	
    26	  canAttempt(): boolean {
    27	    if (this.state === 'closed') return true;
    28	
    29	    if (this.state === 'open') {
    30	      if (Date.now() - this.lastFailureTime >= this.config.resetTimeMs) {
    31	        this.state = 'half-open';
    32	        this.halfOpenAttempts = 0;
    33	        return true;
    34	      }
    35	      return false;
    36	    }
    37	
    38	    // half-open — post-increment so first call passes, subsequent calls are blocked
    39	    return this.halfOpenAttempts++ < this.config.halfOpenMaxAttempts;
    40	  }
    41	
    42	  recordSuccess(): void {
    43	    this.failureCount = 0;
    44	    this.halfOpenAttempts = 0;
    45	    this.state = 'closed';
    46	  }
    47	
    48	  recordFailure(): void {
    49	    this.failureCount++;
    50	    this.lastFailureTime = Date.now();
    51	
    52	    if (this.state === 'half-open') {
    53	      this.state = 'open';
    54	      return;
    55	    }
    56	
    57	    if (this.failureCount >= this.config.failureThreshold) {
    58	      this.state = 'open';
    59	    }
    60	  }
    61	
    62	  getState(): CircuitState {
    63	    // Check if open circuit should transition to half-open
    64	    if (this.state === 'open' && Date.now() - this.lastFailureTime >= this.config.resetTimeMs) {
    65	      return 'half-open';
    66	    }
    67	    return this.state;
    68	  }
    69	}
