     1	// Phase 29 DEPLOY-03: chat-widget Sentry browser init.
     2	// Mirrors apps/chat/app/lib/posthog-init.ts (singleton, Vite-style env vars).
     3	//
     4	// The chat widget runs inside an iframe on client websites. Sentry captures
     5	// JS exceptions + component errors. NO session replay (PHI risk inside iframe).
     6	//
     7	// Codex correction (2026-05-25): beforeSend PHI redaction is REQUIRED from day 1.
     8	
     9	import * as Sentry from '@sentry/react';
    10	import { redactPhiFromSentryEvent } from '@triagecrm/shared/sentry/redact-phi';
    11	
    12	let initialized = false;
    13	
    14	function getDsn(): string | null {
    15	  const dsn = (import.meta as unknown as { env?: Record<string, unknown> }).env
    16	    ?.VITE_SENTRY_DSN_CHAT;
    17	  return typeof dsn === 'string' && dsn.length > 0 ? dsn : null;
    18	}
    19	
    20	function isProdMode(): boolean {
    21	  const mode = (import.meta as unknown as { env?: Record<string, unknown> }).env?.MODE;
    22	  return mode === 'production';
    23	}
    24	
    25	export function initSentry(): void {
    26	  if (initialized || typeof window === 'undefined') return;
    27	  const dsn = getDsn();
    28	  if (!dsn) return;
    29	  Sentry.init({
    30	    dsn,
    31	    environment: isProdMode() ? 'production' : 'development',
    32	    tracesSampleRate: 0.1,
    33	    // No replays — iframe + PHI chat content.
    34	    replaysSessionSampleRate: 0,
    35	    replaysOnErrorSampleRate: 0,
    36	    beforeSend(event) {
    37	      return redactPhiFromSentryEvent(
    38	        event as unknown as Record<string, unknown>,
    39	      ) as unknown as typeof event;
    40	    },
    41	  });
    42	  initialized = true;
    43	}

