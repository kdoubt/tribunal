    78	async function requestScreenshot(url: string): Promise<RawScreenshotResponse> {
    79	  const controller = new AbortController();
    80	  const timeout = setTimeout(() => controller.abort(), SCREENSHOT_TIMEOUT);
    81	
    82	  try {
    83	    const response = await fetch(`${SCREENSHOT_SERVICE_URL}/screenshot`, {
    84	      method: 'POST',
    85	      headers: { 'Content-Type': 'application/json' },
    86	      body: JSON.stringify({ url }),
    87	      signal: controller.signal,
    88	    });
    89	
    90	    if (!response.ok) {
    91	      const errBody = await response.json().catch(() => ({ code: 'ERROR' }));
    92	      const code = (errBody as { code?: string }).code || 'ERROR';
    93	      const mapped = ERROR_MAP[code] || ERROR_MAP.ERROR;
    94	      return {
    95	        ok: false,
    96	        error: mapped.message,
    97	        code: `SCREENSHOT_${code}`,
    98	        status: mapped.status,
    99	        retryable: code === 'BUSY',
   100	      };
   101	    }
   102	
   103	    return { ok: true, response };
   104	  } catch (err) {
   105	    const isAbort = err instanceof Error && err.name === 'AbortError';
   106	    return {
   107	      ok: false,
   108	      error: isAbort ? 'The website took too long to load. Please try again.' : 'Screenshot service unavailable.',
   109	      code: isAbort ? 'SCREENSHOT_TIMEOUT' : 'SCREENSHOT_UNAVAILABLE',
   110	      status: isAbort ? 504 : 503,
   111	      retryable: isAbort,
   112	    };
   113	  } finally {
   114	    clearTimeout(timeout);
   115	  }
   116	}
