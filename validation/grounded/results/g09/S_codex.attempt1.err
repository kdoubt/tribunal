    57	export async function completeDemoShare(
    58	  token: string,
    59	  conversationId: string,
    60	): Promise<void> {
    61	  await prisma.demoShare.update({
    62	    where: { token },
    63	    data: { conversationId, status: 'COMPLETED' },
    64	  });
    65	}
    66	
    67	export async function getDemoShare(token: string) {
    68	  // Check Redis cache first
    69	  try {
    70	    const redis = getRedis();
    71	    const cached = await redis.get(REDIS_PREFIX + token);
    72	    if (cached) return JSON.parse(cached);
