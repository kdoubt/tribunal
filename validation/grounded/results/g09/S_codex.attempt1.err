    19	export async function createDemoShare(data: DemoShareData): Promise<string> {
    20	  const token = randomBytes(15).toString('base64url').slice(0, 20);
    21	  const expiresAt = new Date(Date.now() + EXPIRY_DAYS * 24 * 60 * 60 * 1000);
    22	
    23	  await prisma.demoShare.create({
