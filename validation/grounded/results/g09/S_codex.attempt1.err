   149	              placeholder="Jane"
   150	              autoComplete="given-name"
   151	            />
   152	            {errors.firstName && <p className="mt-1 text-xs text-red-600">{errors.firstName}</p>}
   153	          </div>
   154	
   155	          <div>
   156	            <label htmlFor="prechat-lastName" className="mb-1 block text-xs font-medium text-gray-700">
   157	              Last Name
