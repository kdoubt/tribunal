    20	  cleanupTimers();
    21	
    22	  // Initialize the simulator bridge for CRM events
    23	  if (cleanupBridge) cleanupBridge();
    24	  cleanupBridge = initSimulatorBridge();
    25	
    26	  widget.classList.remove('widget-visible', 'widget-zoomed');
    27	  screenshot.classList.remove('screenshot-zoomed');
    28	  chrome.classList.remove('screenshot-zoomed');
    29	  overlay.classList.remove('bg-black/30');
    30	  overlay.classList.add('bg-black/0');
    31	
    32	  function triggerZoom(): void {
    33	    // Guard: only zoom once
    34	    if (widget.classList.contains('widget-zoomed')) return;
    35	    cleanupTimers();
    36	
    37	    widget.classList.add('widget-zoomed');
    38	    screenshot.classList.add('screenshot-zoomed');
    39	    chrome.classList.add('screenshot-zoomed');
    40	    overlay.classList.remove('bg-black/0');
    41	    overlay.classList.add('bg-black/30');
    42	  }
    43	
    44	  // T+300ms: widget becomes visible at small scale (pre-chat form shown inside)
    45	  widgetVisibleTimer = setTimeout(() => {
    46	    widget.classList.add('widget-visible');
    47	    widgetVisibleTimer = null;
    48	  }, 300);
    49	
    50	  // Listen for the iframe's pre-chat form animation to complete before zooming
    51	  zoomMessageHandler = (e: MessageEvent) => {
    52	    if (e.data?.type === 'triagecrm:prechat-complete') {
    53	      triggerZoom();
    54	    }
    55	  };
    56	  window.addEventListener('message', zoomMessageHandler);
    57	
    58	  // Fallback: if the iframe never sends the message (e.g. load failure), zoom after 5s
    59	  widgetZoomTimer = setTimeout(() => {
    60	    triggerZoom();
    61	    widgetZoomTimer = null;
    62	  }, 5000);
    63	}
