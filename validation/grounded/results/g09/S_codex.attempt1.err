   242	      const code = (err as { code?: string }).code;
   243	      const retryAfter = (err as { retryAfter?: number }).retryAfter;
   244	      const knownCodes: ErrorCode[] = ['RATE_LIMITED', 'BUSY', 'TIMEOUT', 'SERVICE_UNAVAILABLE'];
   245	      const resolvedCode: ErrorCode = knownCodes.includes(code as ErrorCode)
   246	        ? (code as ErrorCode)
   247	        : 'UNKNOWN';
   248	      if (resolvedCode === 'RATE_LIMITED' && typeof retryAfter === 'number' && retryAfter > 0) {
   249	        setRateLimitedUntil(Date.now() + retryAfter * 1000);
   250	      }
   251	      setMessages((prev) => [...prev, createErrorMessage(resolvedCode, retryAfter)]);
   252	    } finally {
   253	      setSending(false);
   254	    }
   255	  }
