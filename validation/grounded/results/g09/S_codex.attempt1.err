     3	export type SimAction =
     4	  | { type: 'INIT'; payload: { firstName?: string; lastName?: string; email?: string } }
     5	  | { type: 'MESSAGE'; payload: Record<string, unknown> }
     6	  | { type: 'DONE'; payload: Record<string, unknown> }
     7	  | { type: 'CLEAR_HIGHLIGHTS' }
     8	  | { type: 'RESET' };
