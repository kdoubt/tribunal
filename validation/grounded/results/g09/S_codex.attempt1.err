    30	export async function appendMessage(
    31	  token: string,
    32	  message: { role: string; content: string },
    33	  crmData?: Record<string, unknown>,
    34	): Promise<void> {
    35	  const timestamp = new Date().toISOString();
    36	  // Use raw SQL for atomic JSON array append (avoids race conditions)
    37	  // NOTE: Prisma maps `DemoShare.crmSnapshots` (no @map) to a camelCase column,
    38	  // so it MUST be double-quoted in raw SQL — unquoted `crm_snapshots` folds to
    39	  // lowercase and throws 42703 "column does not exist", silently breaking demo
    40	  // transcript replay on every message (caught by the caller, so it only showed
    41	  // up as prisma:error log spam).
    42	  await prisma.$executeRaw`
    43	    UPDATE demo_shares
    44	    SET messages = messages || ${JSON.stringify([{ ...message, timestamp }])}::jsonb,
    45	        "crmSnapshots" = "crmSnapshots" || ${JSON.stringify([{ crmData: crmData || null, timestamp }])}::jsonb
    46	    WHERE token = ${token}
    47	  `;
    48	  // Invalidate Redis cache
    49	  try {
    50	    const redis = getRedis();
    51	    await redis.del(REDIS_PREFIX + token);
    52	  } catch {
    53	    /* non-critical */
    54	  }
    55	}
