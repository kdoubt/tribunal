    10	export const initialState: SimState = {
    11	  contact: {
    12	    firstName: null,
    13	    lastName: null,
    14	    email: null,
    15	    phone: null,
    16	    company: null,
    17	    createdAt: new Date().toISOString(),
    18	  },
    19	  lead: null,
    20	  conversation: {
    21	    id: null,
    22	    status: 'ACTIVE',
    23	    messageCount: 0,
    24	    messages: [],
    25	  },
    26	  pipeline: 'new',
    27	  lastUpdate: null,
    28	  highlightFields: [],
    29	};
    30	
    31	function detectChanges(prev: SimState, next: SimState): string[] {
    32	  const changed: string[] = [];
    33	  const contactFields = ['firstName', 'lastName', 'email', 'phone', 'company'] as const;
    34	  for (const f of contactFields) {
    35	    if (prev.contact[f] !== next.contact[f]) changed.push(`contact.${f}`);
    36	  }
    37	  if (prev.lead?.status !== next.lead?.status) changed.push('lead.status');
    38	  if (prev.lead?.serviceInterest !== next.lead?.serviceInterest) changed.push('lead.serviceInterest');
    39	  if (prev.lead?.paymentType !== next.lead?.paymentType) changed.push('lead.paymentType');
    40	  if (prev.lead?.insuranceProvider !== next.lead?.insuranceProvider) changed.push('lead.insuranceProvider');
    41	  if (prev.lead?.relationship !== next.lead?.relationship) changed.push('lead.relationship');
    42	  if (prev.conversation.messageCount !== next.conversation.messageCount) changed.push('conversation.messageCount');
    43	  if (prev.conversation.status !== next.conversation.status) changed.push('conversation.status');
    44	  if (prev.pipeline !== next.pipeline) changed.push('pipeline');
    45	  if (!prev.lead && next.lead) changed.push('lead.created');
    46	  return changed;
    47	}
    48	
    49	export function simReducer(state: SimState, action: SimAction): SimState {
    50	  switch (action.type) {
    51	    case 'INIT': {
    52	      const next: SimState = {
    53	        ...state,
    54	        contact: {
    55	          ...state.contact,
    56	          firstName: action.payload.firstName || null,
    57	          lastName: action.payload.lastName || null,
    58	          email: action.payload.email || null,
    59	          createdAt: new Date().toISOString(),
    60	        },
    61	        lastUpdate: new Date().toISOString(),
    62	      };
    63	      next.highlightFields = detectChanges(state, next);
    64	      return next;
    65	    }
    66	
    67	    case 'MESSAGE': {
    68	      const p = action.payload;
    69	      const contact = p.contact as Record<string, unknown> | undefined;
    70	      const lead = p.lead as Record<string, unknown> | undefined;
    71	      const conv = p.conversation as Record<string, unknown> | undefined;
    72	      const now = new Date().toISOString();
    73	
    74	      const newMessages = [...state.conversation.messages];
    75	      if (typeof p.lastUserMessage === 'string' && p.lastUserMessage) {
    76	        newMessages.push({ role: 'user', content: p.lastUserMessage, timestamp: now });
    77	      }
    78	      if (typeof p.lastAssistantMessage === 'string' && p.lastAssistantMessage) {
    79	        newMessages.push({ role: 'assistant', content: p.lastAssistantMessage, timestamp: now });
    80	      }
    81	
    82	      const next: SimState = {
    83	        ...state,
    84	        contact: {
    85	          firstName: (contact?.firstName as string) || state.contact.firstName,
    86	          lastName: (contact?.lastName as string) || state.contact.lastName,
    87	          email: (contact?.email as string) || state.contact.email,
    88	          phone: (contact?.phone as string) || state.contact.phone,
    89	          company: (contact?.company as string) || state.contact.company,
    90	          createdAt: state.contact.createdAt,
    91	        },
    92	        lead: lead
    93	          ? {
    94	              id: (lead.id as string) || state.lead?.id || null,
    95	              status: (lead.status as 'NEW' | 'IN_PROGRESS' | 'QUALIFIED') || state.lead?.status || 'IN_PROGRESS',
    96	              serviceInterest: (lead.serviceInterest as string) || state.lead?.serviceInterest || null,
    97	              paymentType: (lead.paymentType as string) || state.lead?.paymentType || null,
    98	              insuranceProvider: (lead.insuranceProvider as string) || state.lead?.insuranceProvider || null,
    99	              relationship: (lead.relationship as string) || state.lead?.relationship || null,
   100	              createdAt: state.lead?.createdAt || now,
   101	            }
   102	          : state.lead,
   103	        conversation: {
   104	          id: (conv?.id as string) || state.conversation.id,
   105	          status: (conv?.status as 'ACTIVE' | 'COMPLETED') || state.conversation.status,
   106	          messageCount: typeof conv?.messageCount === 'number' ? conv.messageCount : state.conversation.messageCount,
   107	          messages: newMessages,
   108	        },
   109	        pipeline: lead
   110	          ? (lead.status === 'QUALIFIED' ? 'qualified' : 'qualifying')
   111	          : (state.conversation.messages.length > 0 ? 'qualifying' : state.pipeline),
   112	        lastUpdate: now,
   113	        highlightFields: [],
   114	      };
   115	      next.highlightFields = detectChanges(state, next);
   116	      return next;
   117	    }
   118	
   119	    case 'DONE': {
   120	      const p = action.payload;
   121	      const lead = p.lead as Record<string, unknown> | undefined;
   122	      const now = new Date().toISOString();
   123	
   124	      const newMessages = [...state.conversation.messages];
   125	      if (typeof p.lastUserMessage === 'string' && p.lastUserMessage) {
   126	        newMessages.push({ role: 'user', content: p.lastUserMessage, timestamp: now });
   127	      }
   128	      if (typeof p.lastAssistantMessage === 'string' && p.lastAssistantMessage) {
   129	        newMessages.push({ role: 'assistant', content: p.lastAssistantMessage, timestamp: now });
   130	      }
   131	
   132	      const next: SimState = {
   133	        ...state,
   134	        lead: lead
   135	          ? {
   136	              id: (lead.id as string) || state.lead?.id || null,
   137	              status: 'QUALIFIED',
   138	              serviceInterest: (lead.serviceInterest as string) || state.lead?.serviceInterest || null,
   139	              paymentType: (lead.paymentType as string) || state.lead?.paymentType || null,
   140	              insuranceProvider: (lead.insuranceProvider as string) || state.lead?.insuranceProvider || null,
   141	              relationship: (lead.relationship as string) || state.lead?.relationship || null,
   142	              createdAt: state.lead?.createdAt || now,
   143	            }
   144	          : state.lead
   145	            ? { ...state.lead, status: 'QUALIFIED' }
   146	            : null,
   147	        conversation: {
   148	          ...state.conversation,
   149	          status: 'COMPLETED',
   150	          messages: newMessages,
   151	        },
   152	        pipeline: 'qualified',
   153	        lastUpdate: now,
   154	        highlightFields: [],
   155	      };
   156	      next.highlightFields = detectChanges(state, next);
   157	      return next;
   158	    }
   159	
   160	    case 'CLEAR_HIGHLIGHTS':
   161	      return { ...state, highlightFields: [] };
   162	
   163	    case 'RESET':
   164	      return { ...initialState, contact: { ...initialState.contact, createdAt: new Date().toISOString() } };
   165	
   166	    default:
   167	      return state;
   168	  }
   169	}
