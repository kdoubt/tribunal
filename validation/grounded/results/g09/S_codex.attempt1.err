    11	
    12	export async function applyInputGuard(
    13	  sanitized: string,
    14	  guardConfig: GuardrailConfig,
    15	  session: ChatSession,
    16	  sessionId: string,
    17	): Promise<Response | null> {
    18	  const inputCheck = await checkInput(sanitized, guardConfig);
    19	  if (!inputCheck.allowed) {
    20	    const guardReply = inputCheck.userMessage || "I'm here to help you get started with our services. What can I help you with?";
    21	
    22	    // Codex C1 remediation (2026-05-25): blocked-path persisted rows are now
    23	    // encrypted-at-rest like every other USER/ASSISTANT message. The earlier
    24	    // code wrote `content: sanitized` (USER) and `content: guardReply` (ASSISTANT)
    25	    // as plaintext, which broke the at-rest encryption invariant for the
    26	    // guardrail-rejection path.
    27	    await prisma.chatMessage.createMany({
    28	      data: [
    29	        { conversationId: session.conversationId, organizationId: session.organizationId, role: 'USER', content: encryptPHI(sanitized) },
    30	        { conversationId: session.conversationId, organizationId: session.organizationId, role: 'ASSISTANT', content: encryptPHI(guardReply) },
    31	      ],
    32	    });
    33	
    34	    session.messageCount += 1;
    35	    await setSession(sessionId, session);
    36	
    37	    console.log(`[guardrail:input] session=${sessionId} flagged=${inputCheck.flagged?.join(',')} reason=${inputCheck.reason}`);
    38	
    39	    return Response.json({ reply: guardReply, done: false });
    40	  }
    41	  return null;
    42	}
    43	
    44	/**
    45	 * Phase 27 DELIVERY-05: now returns the full GuardResult so route.ts can
    46	 * branch on `allowed:false` and persist Conversation.metadata.needsHumanFollowup
    47	 * + emit the guardrail.refusal_fired audit row. Previously returned `string`
    48	 * (the augmented reply); the caller now derives the user-visible reply from
    49	 * `guardResult.userMessage ?? originalReply`.
    50	 */
    51	export async function applyOutputGuard(
    52	  reply: string,
    53	  guardConfig: GuardrailConfig,
    54	  sessionId: string,
    55	): Promise<GuardResult> {
    56	  const outputCheck = await checkOutput(reply, guardConfig);
    57	  if (!outputCheck.allowed) {
    58	    console.log(`[guardrail:output] session=${sessionId} flagged=${outputCheck.flagged?.join(',')} reason=${outputCheck.reason}`);
    59	  } else if (outputCheck.userMessage && outputCheck.flagged && outputCheck.flagged.length > 0) {
    60	    console.log(`[guardrail:output:sanitized] session=${sessionId} flagged=${outputCheck.flagged.join(',')}`);
    61	  }
    62	  return outputCheck;
    63	}

