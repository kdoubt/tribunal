    96	    if (!res.ok) {
    97	      const err = await res.json().catch(() => ({ error: 'Something went wrong', code: 'UNKNOWN' }));
    98	      const isTransient = TRANSIENT_CODES.has(err.code);
    99	      showError(err.error || 'Something went wrong. Please try again.', isTransient);
   100	      if (retryTimer) {
   101	        clearTimeout(retryTimer);
   102	        retryTimer = null;
   103	      }
   104	      if (isTransient && retryCount < 2 && lastFormData) {
   105	        const delay = (2 ** retryCount) * 1000;
   106	        retryCount += 1;
   107	        retryTimer = setTimeout(() => {
   108	          retryTimer = null;
   109	          if (lastFormData) submitForm(lastFormData);
   110	        }, delay);
   111	      }
   112	      return;
   113	    }
   114	
   115	    const result = await res.json();
   116	    retryCount = 0;
   117	    if (retryTimer) {
   118	      clearTimeout(retryTimer);
   119	      retryTimer = null;
   120	    }
   121	
   122	    currentDemoToken = result.demoToken || null;
   123	
   124	    // Reflect the demo token in the browser URL for easy sharing
   125	    if (currentDemoToken) {
   126	      const shareUrl = new URL(window.location.href);
   127	      shareUrl.searchParams.set('d', currentDemoToken);
   128	      window.history.replaceState({}, '', shareUrl.toString());
   129	    }
   130	
   131	    (document.getElementById('url-bar') as HTMLElement).textContent = data.url;
   132	    (document.getElementById('preview-screenshot') as HTMLImageElement).src = result.screenshotUrl;
   133	
   134	    widgetBaseUrl = result.widgetUrl;
   135	
   136	    const detected: string = result.detectedIndustry || '';
   137	    const tokenParam = currentDemoToken ? '&demoToken=' + encodeURIComponent(currentDemoToken) : '';
   138	    const sep = widgetBaseUrl!.includes('?') ? '&' : '?';
   139	    const widgetSrc = detected
   140	      ? widgetBaseUrl + sep + 'templateId=' + encodeURIComponent(detected) + tokenParam
   141	      : widgetBaseUrl + (tokenParam ? sep + tokenParam.slice(1) : '');
   142	
   143	    // Reset replay-mode elements so they don't bleed into a fresh preview
   144	    document.getElementById('replay-cta-overlay')?.classList.add('hidden');
   145	    document.getElementById('replay-chat-panel')?.classList.add('hidden');
   146	    // Restore widget iframe visibility (replay mode hides it)
   147	    (document.getElementById('preview-widget') as HTMLIFrameElement).style.display = '';
   148	
   149	    showStep('preview');
   150	    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
   151	    (document.getElementById('preview-widget') as HTMLIFrameElement).src = widgetSrc;
   152	    triggerWidgetAnimation();
   153	  } catch {
   154	    stopLoadingMessages();
   155	    if (retryTimer) {
   156	      clearTimeout(retryTimer);
   157	      retryTimer = null;
   158	    }
   159	    retryCount = 0;
   160	    showError('Network error. Please check your connection and try again.', true);
   161	  }
   162	}
   163	
   164	export function setupEventHandlers(): void {
   165	  // Form submit
   166	  document.getElementById('preview-form')!.addEventListener('submit', (e) => {
   167	    e.preventDefault();
   168	
   169	    const url = normalizeUrl((document.getElementById('url') as HTMLInputElement).value);
   170	    const businessName = (document.getElementById('businessName') as HTMLInputElement).value.trim();
   171	    const email = (document.getElementById('email') as HTMLInputElement).value.trim();
   172	    const phone = (document.getElementById('phone') as HTMLInputElement).value.trim();
   173	
   174	    const urlErr = validateField('url', url, { required: true });
   175	    const nameErr = validateField('businessName', businessName, { required: true });
   176	    const emailErr = validateField('email', email, { required: true, email: true });
   177	
   178	    showFieldError('url', urlErr);
   179	    showFieldError('businessName', nameErr);
   180	    showFieldError('email', emailErr);
   181	
   182	    if (urlErr || nameErr || emailErr) return;
   183	
   184	    const data: Record<string, string> = { url, businessName, email };
   185	    if (phone) data.phone = phone;
   186	    retryCount = 0;
   187	    if (retryTimer) {
   188	      clearTimeout(retryTimer);
   189	      retryTimer = null;
   190	    }
   191	    submitForm(data);
   192	  });
   193	
   194	  // URL prefetch: start the screenshot/crawl as soon as the user has typed a
   195	  // plausible URL (debounced), so the result is often ready by the time they
   196	  // finish the rest of the form. Also fires on blur (covers paste / tab-out
   197	  // faster than the debounce) and once on load for a prefilled ?url= value.
   198	  // The server is the real cost guard (30/hr per IP, SSRF, MAX_CONCURRENT
   199	  // semaphore); the debounce + startPrefetch's URL dedupe just avoid needless
   200	  // calls while typing. Firing earlier only grows the trust _pst window, never
   201	  // trips prefetch_too_fast.
   202	  const urlInput = document.getElementById('url') as HTMLInputElement;
   203	  const PREFETCH_DEBOUNCE_MS = 700;
   204	  let prefetchDebounce: ReturnType<typeof setTimeout> | null = null;
   205	
   206	  // Only fire once the value parses AND has a dotted host with a 2+ char TLD,
   207	  // so partial input like "yourpra" doesn't burn a capture. SSRF/internal hosts
   208	  // are still rejected server-side regardless.
   209	  const looksLikeUrl = (raw: string): boolean => {
   210	    try {
   211	      return /\.[a-z]{2,}$/i.test(new URL(normalizeUrl(raw)).hostname);
   212	    } catch {
   213	      return false;
   214	    }
   215	  };
   216	
   217	  const maybePrefetch = (): void => {
   218	    if (looksLikeUrl(urlInput.value)) startPrefetch(normalizeUrl(urlInput.value));
   219	  };
   220	
   221	  urlInput.addEventListener('input', () => {
   222	    if (prefetchDebounce) clearTimeout(prefetchDebounce);
   223	    prefetchDebounce = setTimeout(maybePrefetch, PREFETCH_DEBOUNCE_MS);
   224	  });
   225	
   226	  urlInput.addEventListener('blur', () => {
   227	    if (prefetchDebounce) {
   228	      clearTimeout(prefetchDebounce);
   229	      prefetchDebounce = null;
   230	    }
   231	    maybePrefetch();
   232	  });
   233	
   234	  // Prefilled ?url= handoff from the homepage hero: input/blur won't fire on
   235	  // load, so kick off the prefetch immediately for the earliest possible start.
   236	  maybePrefetch();
   237	
   238	  // Retry button
   239	  document.getElementById('retry-btn')!.addEventListener('click', () => {
   240	    if (retryTimer) {
   241	      clearTimeout(retryTimer);
   242	      retryTimer = null;
   243	    }
   244	    if (lastFormData) submitForm(lastFormData);
   245	  });
   246	
   247	  // Back button
   248	  document.getElementById('back-btn')!.addEventListener('click', () => {
   249	    if (retryTimer) {
   250	      clearTimeout(retryTimer);
   251	      retryTimer = null;
   252	    }
   253	    retryCount = 0;
   254	    showStep('form');
   255	  });
   256	
   257	  // Try another URL button
   258	  document.getElementById('try-another-btn')!.addEventListener('click', () => {
   259	    if (retryTimer) {
   260	      clearTimeout(retryTimer);
   261	      retryTimer = null;
   262	    }
   263	    retryCount = 0;
   264	    currentDemoToken = null;
   265	    (document.getElementById('preview-widget') as HTMLIFrameElement).src = '';
   266	    resetWidgetAnimation();
   267	    widgetBaseUrl = null;
   268	    resetPrefetch();
   269	    // Clear token from URL
   270	    const cleanUrl = new URL(window.location.href);
   271	    cleanUrl.searchParams.delete('d');
   272	    window.history.replaceState({}, '', cleanUrl.toString());
   273	    showStep('form');
   274	  });
   275	
   276	  // Share button — appears when conversation is done
   277	  const shareBtn = document.getElementById('share-demo-btn');
   278	  if (shareBtn) {
   279	    document.addEventListener('crm:done', () => {
   280	      if (currentDemoToken) shareBtn.classList.remove('hidden');
   281	    });
   282	    shareBtn.addEventListener('click', () => {
   283	      if (!currentDemoToken) return;
   284	      const shareUrl = `${window.location.origin}/live-preview?d=${currentDemoToken}`;
   285	      navigator.clipboard.writeText(shareUrl).then(() => {
   286	        shareBtn.textContent = 'Link Copied!';
   287	        setTimeout(() => { shareBtn.textContent = 'Share This Demo'; }, 2000);
   288	      });
   289	    });
   290	  }
   291	
   292	  // Replay CTA buttons
   293	  const replayTrySelf = document.getElementById('replay-try-self-btn');
   294	  const replayTryAnother = document.getElementById('replay-try-another-btn');
   295	
   296	  if (replayTrySelf) {
   297	    replayTrySelf.addEventListener('click', () => {
   298	      // Restore widget iframe visibility (replay mode hides it)
   299	      (document.getElementById('preview-widget') as HTMLIFrameElement).style.display = '';
   300	      // Restart with the same URL pre-filled
   301	      const urlBar = document.getElementById('url-bar');
   302	      const websiteUrl = urlBar?.textContent || '';
   303	      const cleanUrl = new URL(window.location.href);
   304	      cleanUrl.searchParams.delete('d');
   305	      window.history.replaceState({}, '', cleanUrl.toString());
   306	      showStep('form');
   307	      if (websiteUrl) {
   308	        (document.getElementById('url') as HTMLInputElement).value = websiteUrl;
   309	      }
   310	    });
   311	  }
   312	
   313	  if (replayTryAnother) {
   314	    replayTryAnother.addEventListener('click', () => {
   315	      // Restore widget iframe visibility (replay mode hides it)
   316	      (document.getElementById('preview-widget') as HTMLIFrameElement).style.display = '';
   317	      const cleanUrl = new URL(window.location.href);
   318	      cleanUrl.searchParams.delete('d');
   319	      window.history.replaceState({}, '', cleanUrl.toString());
   320	      showStep('form');
   321	    });
   322	  }
   323	
   324	  // Show replay CTA overlay when replay completes
   325	  document.addEventListener('crm:replay-complete', () => {
   326	    const overlay = document.getElementById('replay-cta-overlay');
   327	    if (overlay) overlay.classList.remove('hidden');
   328	  });
   329	}
   330	
   331	/** Enter replay mode for a shared demo link */
   332	export async function enterReplayMode(token: string): Promise<void> {
   333	  showStep('loading');
   334	  startLoadingMessages();
   335	
   336	  try {
   337	    const res = await fetch(`/app/api/public/live-preview/share/${encodeURIComponent(token)}`);
   338	    stopLoadingMessages();
   339	
   340	    if (!res.ok) {
   341	      showError('This demo link has expired or is not available.', false);
   342	      return;
   343	    }
   344	
   345	    const data = await res.json();
   346	
   347	    // Set up the preview UI
   348	    (document.getElementById('url-bar') as HTMLElement).textContent = data.websiteUrl;
   349	    (document.getElementById('preview-screenshot') as HTMLImageElement).src = data.screenshotUrl;
   350	
   351	    // Hide the live widget iframe (replay uses the replay panel instead)
   352	    const widget = document.getElementById('preview-widget') as HTMLIFrameElement;
   353	    widget.style.display = 'none';
   354	
   355	    showStep('preview');
   356	    window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
   357	
   358	    // Trigger the initial zoom animation (without widget iframe)
   359	    triggerWidgetAnimation();
   360	
   361	    // Wait for the zoom animation to complete, then start replay
   362	    setTimeout(() => {
   363	      initReplayBridge(
   364	        data.messages || [],
   365	        data.crmSnapshots || [],
   366	        data.brandColor || '#3B82F6',
   367	        data.orgName || '',
   368	      );
   369	    }, 1500);
   370	  } catch {
   371	    stopLoadingMessages();
   372	    showError('Network error. Please check your connection and try again.', false);
   373	  }
   374	}
     1	type CrmEventType = 'crm:init' | 'crm:message' | 'crm:done';
     2	
     3	const EVENT_MAP: Record<string, CrmEventType> = {
     4	  'triagecrm:chat-init': 'crm:init',
     5	  'triagecrm:chat-message': 'crm:message',
     6	  'triagecrm:chat-done': 'crm:done',
     7	};
     8	
     9	// Buffer events that arrive before React components mount.
    10	// CrmSimulator calls flushSimulatorBuffer() once its listeners are ready.
    11	const eventBuffer: { type: CrmEventType; detail: unknown }[] = [];
    12	let reactReady = false;
    13	
    14	export function flushSimulatorBuffer(): void {
    15	  reactReady = true;
    16	  for (const evt of eventBuffer) {
    17	    document.dispatchEvent(new CustomEvent(evt.type, { detail: evt.detail }));
    18	  }
    19	  eventBuffer.length = 0;
    20	}
    21	
    22	function dispatch(eventType: CrmEventType, detail: unknown): void {
    23	  if (reactReady) {
    24	    document.dispatchEvent(new CustomEvent(eventType, { detail }));
    25	  } else {
    26	    eventBuffer.push({ type: eventType, detail });
    27	  }
    28	}
    29	
    30	/**
    31	 * Inject a fetch interceptor into the chat widget iframe (same-origin) so
    32	 * that crm:init events are forwarded to the parent via postMessage.
    33	 *
    34	 * NOTE: chat-message and chat-done are NOT intercepted here because the
    35	 * widget's own code already sends those via window.parent.postMessage.
    36	 * Intercepting them here would cause duplicate events in the CRM simulator.
    37	 */
    38	function injectFetchInterceptor(iframe: HTMLIFrameElement): void {
    39	  const iframeWindow = iframe.contentWindow;
    40	  if (!iframeWindow) return;
    41	
    42	  try {
    43	    const originalFetch = iframeWindow.fetch.bind(iframeWindow);
    44	    let initSent = false;
    45	    iframeWindow.fetch = async function patchedFetch(
    46	      input: RequestInfo | URL,
    47	      init?: RequestInit,
    48	    ): Promise<Response> {
    49	      const res = await originalFetch(input, init);
    50	
    51	      const url = typeof input === 'string' ? input : input instanceof URL ? input.href : input.url;
    52	      if (!url.includes('/api/chat/widget')) return res;
    53	
    54	      // Clone so the original consumer still gets the body
    55	      const clone = res.clone();
    56	      clone.json().then((data: Record<string, unknown>) => {
    57	        // Init endpoint — trigger crm:init with pre-chat contact data
    58	        if (url.includes('/init') && !initSent && data.demoMode) {
    59	          initSent = true;
    60	          window.postMessage({
    61	            type: 'triagecrm:chat-init',
    62	            payload: { firstName: 'Sarah', lastName: 'Johnson', email: '<email>' },
    63	          }, '*');
    64	        }
    65	        // chat-message and chat-done are sent by the widget itself — no interception needed
    66	      }).catch(() => { /* non-critical */ });
    67	
    68	      return res;
    69	    } as typeof fetch;
    70	  } catch {
    71	    // Cross-origin or SecurityError — fall back to native postMessage from widget
    72	  }
    73	}
    74	
    75	export function initSimulatorBridge(): () => void {
    76	  // Clear any stale buffered events from a previous demo session.
    77	  // Do NOT reset reactReady — if the CrmSimulator React component is already
    78	  // mounted and listening, events must be dispatched immediately, not buffered.
    79	  // Resetting reactReady here would cause events to queue forever because
    80	  // flushSimulatorBuffer() is only called once on React mount.
    81	  eventBuffer.length = 0;
    82	
    83	  function handler(event: MessageEvent) {
    84	    if (!event.data?.type?.startsWith('triagecrm:')) return;
    85	
    86	    const eventType = EVENT_MAP[event.data.type];
    87	    if (eventType) {
    88	      dispatch(eventType, event.data.payload);
    89	    }
    90	  }
    91	
    92	  window.addEventListener('message', handler);
    93	
    94	  // Inject fetch interceptor into the iframe once it loads
    95	  const iframe = document.getElementById('preview-widget') as HTMLIFrameElement | null;
    96	  if (iframe) {
    97	    const onLoad = () => injectFetchInterceptor(iframe);
    98	    iframe.addEventListener('load', onLoad);
    99	    // Also try immediately in case the iframe is already loaded
   100	    if (iframe.contentDocument?.readyState === 'complete') {
   101	      injectFetchInterceptor(iframe);
   102	    }
   103	    return () => {
   104	      window.removeEventListener('message', handler);
   105	      iframe.removeEventListener('load', onLoad);
   106	    };
   107	  }
   108	
   109	  return () => window.removeEventListener('message', handler);
   110	}
     1	import { flushSimulatorBuffer } from './simulator-bridge';
     2	import { contrastText } from '@triagecrm/shared';
     3	
     4	interface ReplayMessage {
     5	  role: string;
     6	  content: string;
     7	  timestamp: string;
     8	}
     9	
    10	interface ReplaySnapshot {
    11	  crmData: Record<string, unknown> | null;
    12	  timestamp: string;
    13	}
    14	
    15	const BASE_DELAY = 600; // ms per message at 2x speed
    16	const TYPING_DELAY = 400; // brief "typing" pause for assistant messages
    17	
    18	/**
    19	 * Render a single chat message into the replay chat panel.
    20	 */
    21	function renderReplayMessage(role: string, content: string, brandColor: string): void {
    22	  const container = document.getElementById('replay-chat-messages');
    23	  if (!container) return;
    24	
    25	  const wrapper = document.createElement('div');
    26	  wrapper.className = `flex ${role === 'user' ? 'justify-end' : 'justify-start'} mb-3`;
    27	
    28	  const bubble = document.createElement('div');
    29	  bubble.className = 'max-w-[80%] rounded-2xl px-4 py-2 text-sm';
    30	
    31	  if (role === 'user') {
    32	    bubble.style.backgroundColor = brandColor;
    33	    bubble.style.color = contrastText(brandColor);
    34	  } else {
    35	    bubble.className += ' bg-gray-100 text-gray-900';
    36	  }
    37	  bubble.textContent = content;
    38	
    39	  wrapper.appendChild(bubble);
    40	  container.appendChild(wrapper);
    41	  container.scrollTop = container.scrollHeight;
    42	}
    43	
    44	/**
    45	 * Replay a recorded demo conversation by dispatching the same
    46	 * crm:init, crm:message, crm:done events on a timer, while
    47	 * rendering chat messages into the replay panel.
    48	 */
    49	export function initReplayBridge(
    50	  messages: ReplayMessage[],
    51	  crmSnapshots: ReplaySnapshot[],
    52	  brandColor: string,
    53	  orgName: string,
    54	): void {
    55	  // Set up the replay chat panel header
    56	  const headerName = document.getElementById('replay-org-name');
    57	  if (headerName) headerName.textContent = orgName;
    58	
    59	  const replayPanel = document.getElementById('replay-chat-panel');
    60	  if (replayPanel) replayPanel.classList.remove('hidden');
    61	
    62	  // Set header background + text color for contrast
    63	  const replayHeader = document.getElementById('replay-chat-header');
    64	  if (replayHeader) {
    65	    const textColor = contrastText(brandColor);
    66	    replayHeader.style.backgroundColor = brandColor;
    67	    replayHeader.style.color = textColor;
    68	    // Override Tailwind's hardcoded text-white on child elements
    69	    const orgNameEl = document.getElementById('replay-org-name');
    70	    if (orgNameEl) orgNameEl.style.color = textColor;
    71	    const subtitleEl = replayHeader.querySelector('p:last-child');
    72	    if (subtitleEl instanceof HTMLElement) { subtitleEl.style.color = textColor; subtitleEl.style.opacity = '0.7'; }
    73	    const svgEl = replayHeader.querySelector('svg');
    74	    if (svgEl instanceof SVGElement) svgEl.style.color = textColor;
    75	    const iconBg = replayHeader.querySelector('.rounded-full');
    76	    if (iconBg instanceof HTMLElement) iconBg.style.backgroundColor = textColor === '#ffffff' ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.1)';
    77	  }
    78	
    79	  // Ensure simulator buffer is flushed so events reach React
    80	  flushSimulatorBuffer();
    81	
    82	  let delay = 1500; // initial delay after animation
    83	
    84	  // Fire crm:init from the first snapshot's contact data
    85	  const firstSnapshot = crmSnapshots[0]?.crmData;
    86	  if (firstSnapshot && typeof firstSnapshot === 'object' && 'contact' in firstSnapshot) {
    87	    setTimeout(() => {
    88	      document.dispatchEvent(new CustomEvent('crm:init', {
    89	        detail: firstSnapshot.contact,
    90	      }));
    91	      // Show simulator container
    92	      const container = document.getElementById('crm-simulator-container');
    93	      if (container) container.classList.remove('hidden');
    94	    }, delay);
    95	    delay += BASE_DELAY;
    96	  }
    97	
    98	  // Replay each message
    99	  for (let i = 0; i < messages.length; i++) {
   100	    const msg = messages[i];
   101	    const snapshot = crmSnapshots[i];
   102	    const isLast = i === messages.length - 1;
   103	
   104	    // Capture values for closure
   105	    const capturedDelay = delay;
   106	
   107	    setTimeout(() => {
   108	      // Render chat bubble
   109	      renderReplayMessage(msg.role, msg.content, brandColor);
   110	
   111	      // Dispatch CRM event from snapshot
   112	      if (snapshot?.crmData) {
   113	        const eventType = isLast ? 'crm:done' : 'crm:message';
   114	        document.dispatchEvent(new CustomEvent(eventType, {
   115	          detail: { ...snapshot.crmData, lastUserMessage: msg.role === 'user' ? msg.content : undefined },
   116	        }));
   117	      }
   118	    }, capturedDelay);
   119	
   120	    delay += msg.role === 'assistant' ? BASE_DELAY + TYPING_DELAY : BASE_DELAY;
   121	  }
   122	
   123	  // After replay completes, show end-of-replay CTA
   124	  setTimeout(() => {
   125	    document.dispatchEvent(new CustomEvent('crm:replay-complete'));
   126	  }, delay + 500);
   127	}
     1	export interface PrefetchResult {
     2	  prefetchId: string;
     3	  screenshotUrl: string;
     4	  brandColor: string;
     5	  siteName: string;
     6	  detectedIndustry: string | null;
     7	}
     8	
     9	export let prefetchPromise: Promise<PrefetchResult | null> | null = null;
    10	export let prefetchedUrl: string | null = null;
    11	// Set at page load as baseline; updated when prefetch fires on URL blur
    12	export let prefetchStartedAt: number | null = Date.now();
    13	
    14	export function normalizeUrl(raw: string): string {
    15	  let u = raw.trim();
    16	  if (u && !u.startsWith('https://') && !u.startsWith('http://')) {
    17	    u = 'https://' + u;
    18	  } else if (u && u.startsWith('http://')) {
    19	    u = u.replace('http://', 'https://');
    20	  }
    21	  return u;
    22	}
    23	
    24	export function startPrefetch(url: string): void {
    25	  if (!url || url.length < 10) return;
    26	  if (prefetchedUrl === url) return;
    27	  prefetchedUrl = url;
    28	  prefetchStartedAt = Date.now();
    29	
    30	  prefetchPromise = fetch('/app/api/public/live-preview/prefetch', {
    31	    method: 'POST',
    32	    headers: { 'Content-Type': 'application/json' },
    33	    body: JSON.stringify({ url }),
    34	  }).then(async (res) => {
    35	    if (!res.ok) return null;
    36	    return res.json() as Promise<PrefetchResult>;
    37	  }).catch(() => null);
    38	}
    39	
    40	export function resetPrefetch(): void {
    41	  prefetchPromise = null;
    42	  prefetchedUrl = null;
    43	  prefetchStartedAt = Date.now();
    44	}

