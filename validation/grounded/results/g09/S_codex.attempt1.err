    10	export interface ToolCallResult {
    11	  toolResults: { role: 'tool'; tool_call_id: string; content: string }[];
    12	  leadCreated: boolean;
    13	  leadToolArgs: Record<string, unknown> | null;
    14	}
    15	
    16	export async function executeToolCalls(
    17	  toolCalls: { id: string; type: string; function: { name: string; arguments: string } }[],
    18	  session: ChatSession,
    19	  sessionId: string,
    20	): Promise<ToolCallResult> {
    21	  const toolResults: { role: 'tool'; tool_call_id: string; content: string }[] = [];
    22	  let leadCreated = false;
    23	  let leadToolArgs: Record<string, unknown> | null = null;
    24	
    25	  for (const toolCall of toolCalls) {
    26	    let args: Record<string, unknown>;
    27	    // Phase 27 DELIVERY-04 note: arguments are already JSON-parseable AND
    28	    // schema-valid after the Zod validation in llm-pipeline.ts dropped
    29	    // malformed calls upstream. The JSON.parse below is defense-in-depth —
    30	    // unreachable in normal operation but kept as a safety net for any
    31	    // future caller that bypasses the pipeline-level validation.
    32	    try {
    33	      args = JSON.parse(toolCall.function.arguments);
    34	    } catch {
    35	      toolResults.push({
    36	        role: 'tool',
    37	        tool_call_id: toolCall.id,
    38	        content: JSON.stringify({ error: 'Invalid arguments format' }),
    39	      });
    40	      continue;
    41	    }
    42	
    43	    if (toolCall.function.name === 'create_lead') {
    44	      const preChatMeta = session.metadata?.preChatData as { firstName?: string; lastName?: string; email?: string; paymentType?: string } | undefined;
    45	      const firstName = (typeof args.firstName === 'string' ? args.firstName.trim() : '') || preChatMeta?.firstName || '';
    46	      const lastName = (typeof args.lastName === 'string' ? args.lastName.trim() : '') || preChatMeta?.lastName || '';
    47	      const email = (typeof args.email === 'string' ? args.email.trim() : '') || preChatMeta?.email || '';
    48	      const serviceInterest = typeof args.serviceInterest === 'string' ? args.serviceInterest.trim() : '';
    49	      const paymentType = (typeof args.paymentType === 'string' ? args.paymentType : '') || preChatMeta?.paymentType || '';
    50	
    51	      if (!firstName || !lastName || !email || !serviceInterest || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    52	        toolResults.push({
    53	          role: 'tool',
    54	          tool_call_id: toolCall.id,
    55	          content: JSON.stringify({ success: false, error: 'Missing or invalid required fields (firstName, lastName, email, serviceInterest). Ask the patient for this information.' }),
    56	        });
    57	        continue;
    58	      }
    59	
    60	      try {
    61	        const result = await createLeadFromChat({
    62	          organizationId: session.organizationId,
    63	          conversationId: session.conversationId,
    64	          firstName, lastName, email,
    65	          phone: typeof args.phone === 'string' ? args.phone : undefined,
    66	          serviceInterest,
    67	          paymentType: paymentType || undefined,
    68	          insuranceProvider: typeof args.insuranceProvider === 'string' ? args.insuranceProvider : undefined,
    69	          relationship: typeof args.relationship === 'string' ? args.relationship : undefined,
    70	          notes: typeof args.notes === 'string' ? args.notes : undefined,
    71	        });
    72	
    73	        session.leadId = result.leadId;
    74	        session.contactId = result.contactId;
    75	        leadCreated = true;
    76	        leadToolArgs = args;
    77	
    78	        try {
    79	          const posthog = getPostHog();
    80	          if (posthog) {
    81	            const demoTk = session.metadata?.demoToken as string | undefined;
    82	            posthog.capture({
    83	              distinctId: demoTk || sessionId,
    84	              event: EVENTS.CHAT_WIDGET_LEAD_CREATED,
    85	              properties: { organizationId: session.organizationId, leadId: result.leadId, sessionId, demoToken: demoTk },
    86	            });
    87	          }
    88	        } catch (posthogErr) {
    89	          console.error('[posthog] Lead created tracking failed:', posthogErr);
    90	        }
    91	
    92	        toolResults.push({
    93	          role: 'tool',
    94	          tool_call_id: toolCall.id,
    95	          content: JSON.stringify({ success: true, message: 'Lead created successfully. Thank the patient and let them know someone will be in touch.' }),
    96	        });
    97	      } catch (err) {
    98	        console.error('Failed to create lead from chat:', err);
    99	        toolResults.push({
   100	          role: 'tool',
   101	          tool_call_id: toolCall.id,
   102	          content: JSON.stringify({ success: false, error: 'Failed to save. Ask the patient to try again.' }),
   103	        });
   104	      }
   105	    } else if (toolCall.function.name === 'check_service') {
   106	      const service = typeof args.service === 'string' ? args.service : String(args.service ?? '');
   107	      let serviceInfo = `Yes, we can help with ${service}. If the patient wants to book, proceed to collect any missing required fields then create the lead.`;
   108	      try {
   109	        const context = await retrieveContext(session.organizationId, service, 1);
   110	        if (context) {
   111	          serviceInfo = `Service info: ${context}. If the patient wants to book, proceed to collect any missing required fields then create the lead.`;
   112	        } else {
   113	          const fallback = getDemoServiceFallback(service);
   114	          if (fallback) serviceInfo = fallback;
   115	        }
   116	      } catch {
   117	        const fallback = getDemoServiceFallback(service);
   118	        if (fallback) serviceInfo = fallback;
   119	      }
   120	      toolResults.push({
   121	        role: 'tool',
   122	        tool_call_id: toolCall.id,
   123	        content: JSON.stringify({ available: true, info: serviceInfo }),
   124	      });
   125	    }
   126	  }
   127	
   128	  return { toolResults, leadCreated, leadToolArgs };
   129	}
     1	import { prisma } from '@triagecrm/db';
     2	import {
     3	  getPostHog,
     4	  EVENTS,
     5	  setSession,
     6	  enqueueOutboxEvent,
     7	  type ChatSession,
     8	} from '@triagecrm/ai';
     9	import { encryptPHI } from '@triagecrm/shared/encryption';
    10	import { logEvent, appendMessage as appendShareMessage, completeDemoShare } from '@/lib/live-preview';
    11	
    12	export async function persistAndFinalize(
    13	  session: ChatSession,
    14	  sessionId: string,
    15	  sanitized: string,
    16	  reply: string,
    17	  done: boolean,
    18	  leadToolArgs: Record<string, unknown> | null,
    19	  ip: string,
    20	): Promise<{ crmData?: Record<string, unknown> }> {
    21	  // Save assistant reply — encrypt before insert (HIPAA-01 write boundary).
    22	  await prisma.chatMessage.create({
    23	    data: {
    24	      conversationId: session.conversationId,
    25	      organizationId: session.organizationId,
    26	      role: 'ASSISTANT',
    27	      content: encryptPHI(reply),
    28	    },
    29	  });
    30	
    31	  // Update session
    32	  session.messageCount += 1;
    33	  if (done) {
    34	    session.done = true;
    35	    const isDemoConversation = session.type === 'WIDGET_QUALIFIER' && !!session.metadata?.demoMode;
    36	    await prisma.$transaction(async (tx) => {
    37	      await tx.conversation.update({
    38	        where: { id: session.conversationId },
    39	        data: { status: 'COMPLETED', completedAt: new Date() },
    40	      });
    41	
    42	      await enqueueOutboxEvent(tx, {
    43	        organizationId: session.organizationId,
    44	        event: {
    45	          type: 'CHAT_CONVERSATION_COMPLETED',
    46	          payload: {
    47	            organizationId: session.organizationId,
    48	            conversationId: session.conversationId,
    49	            isDemoConversation,
    50	          },
    51	        },
    52	      });
    53	    });
    54	  }
    55	  await setSession(sessionId, session);
    56	
    57	  // HIPAA audit log
    58	  logEvent('audit:chat_message', { ip, sessionId, messageCount: session.messageCount });
    59	
    60	  // Analytics
    61	  const demoTokenFromSession = session.metadata?.demoToken as string | undefined;
    62	  try {
    63	    const posthog = getPostHog();
    64	    if (posthog) {
    65	      posthog.capture({
    66	        distinctId: demoTokenFromSession || sessionId,
    67	        event: EVENTS.CHAT_WIDGET_MESSAGE,
    68	        properties: { organizationId: session.organizationId, messageCount: session.messageCount, sessionId, demoToken: demoTokenFromSession },
    69	      });
    70	    }
    71	  } catch (posthogErr) {
    72	    console.error('[posthog] Message tracking failed:', posthogErr);
    73	  }
    74	
    75	  // Build crmData for demo sessions
    76	  let crmData: Record<string, unknown> | undefined;
    77	  if (session.metadata?.demoMode) {
    78	    const preChatMeta = session.metadata?.preChatData as
    79	      | { firstName?: string; lastName?: string; email?: string; paymentType?: string }
    80	      | undefined;
    81	    crmData = {
    82	      contact: {
    83	        firstName: preChatMeta?.firstName || null,
    84	        lastName: preChatMeta?.lastName || null,
    85	        email: preChatMeta?.email || null,
    86	        phone: typeof (session.metadata as Record<string, unknown>)?.phone === 'string'
    87	          ? (session.metadata as Record<string, unknown>).phone
    88	          : null,
    89	        company: (session.metadata as Record<string, unknown>)?.orgName || null,
    90	      },
    91	      lead: session.leadId
    92	        ? {
    93	            id: session.leadId,
    94	            status: done ? 'QUALIFIED' : 'IN_PROGRESS',
    95	            serviceInterest: leadToolArgs?.serviceInterest ?? null,
    96	            paymentType: leadToolArgs?.paymentType ?? null,
    97	            insuranceProvider: leadToolArgs?.insuranceProvider ?? null,
    98	            relationship: leadToolArgs?.relationship ?? null,
    99	          }
   100	        : null,
   101	      conversation: {
   102	        id: session.conversationId,
   103	        messageCount: session.messageCount,
   104	        status: done ? 'COMPLETED' : 'ACTIVE',
   105	      },
   106	      lastUserMessage: sanitized,
   107	      lastAssistantMessage: reply,
   108	    };
   109	  }
   110	
   111	  // Record messages to DemoShare for replay
   112	  if (session.metadata?.demoMode && demoTokenFromSession) {
   113	    try {
   114	      await appendShareMessage(demoTokenFromSession, { role: 'user', content: sanitized });
   115	      await appendShareMessage(demoTokenFromSession, { role: 'assistant', content: reply }, crmData);
   116	      if (done) {
   117	        await completeDemoShare(demoTokenFromSession, session.conversationId);
   118	      }
   119	    } catch (shareErr) {
   120	      console.error('[demo-share] Failed to record message:', shareErr);
   121	    }
   122	  }
   123	
   124	  return { crmData };
   125	}
