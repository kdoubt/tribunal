    34	        .create({
    35	          data: {
    36	            action: AUDIT_ACTIONS.SCREENSHOT_LEGACY_ACCESS,
    37	            organizationId: null,
    38	            userId: null,
    39	            resource: 'screenshot',
    40	            resourceId: token,
    41	            metadata: { source: 'legacy_url_pattern' },
    42	          },
    43	        })
    44	        .catch((auditErr) => {
    45	          console.error('[screenshot] legacy-access audit failed:', auditErr);
    46	        });
    47	      return apiError(
    48	        'FORBIDDEN',
    49	        'Legacy screenshot URLs are no longer accepted',
    50	        403,
    51	      );
    52	    }
    53	
    54	    const payload = verifyScreenshotToken(token);
    55	    if (!payload) return apiError('FORBIDDEN', 'Invalid or expired token', 403);
    56	
    57	    // Scope-specific defense-in-depth check.
    58	    if (payload.scope.startsWith('share:')) {
    59	      const shareToken = payload.scope.slice('share:'.length);
    60	      const share = await getDemoShare(shareToken);
