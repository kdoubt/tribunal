     1	import { getRedis } from '@triagecrm/ai';
     2	import { randomBytes } from 'crypto';
     3	
     4	/**
     5	 * Atomic Lua script for Redis-based distributed semaphore.
     6	 * Uses a sorted set where members are holder IDs and scores are expiry timestamps.
     7	 * Expired holders are cleaned up atomically before checking capacity.
     8	 */
     9	const ACQUIRE_LUA = `
    10	local key = KEYS[1]
    11	local now = tonumber(ARGV[1])
    12	local max = tonumber(ARGV[2])
    13	local ttl_ms = tonumber(ARGV[3])
    14	local holder = ARGV[4]
    15	
    16	-- Clean expired holders
    17	redis.call('ZREMRANGEBYSCORE', key, 0, now)
    18	
    19	-- Check capacity
    20	local count = redis.call('ZCARD', key)
    21	if count >= max then
    22	  return 0
    23	end
    24	
    25	-- Add holder with expiry as score
    26	redis.call('ZADD', key, now + ttl_ms, holder)
    27	redis.call('PEXPIRE', key, ttl_ms)
    28	return 1
    29	`;
    30	
    31	const RELEASE_LUA = `
    32	local key = KEYS[1]
    33	local holder = ARGV[1]
    34	redis.call('ZREM', key, holder)
    35	return 1
    36	`;
    37	
    38	/**
    39	 * Try to acquire a slot in the distributed semaphore.
    40	 * Returns the holder ID on success, or null if at capacity.
    41	 */
    42	export async function acquireSemaphore(
    43	  key: string,
    44	  max: number,
    45	  ttlMs: number,
    46	): Promise<string | null> {
    47	  const holder = randomBytes(12).toString('hex');
    48	  const redis = getRedis();
    49	  const now = Date.now();
    50	
    51	  try {
    52	    const result = await redis.eval(
    53	      ACQUIRE_LUA,
    54	      1,
    55	      `semaphore:${key}`,
    56	      now,
    57	      max,
    58	      ttlMs,
    59	      holder,
    60	    );
    61	    return result === 1 ? holder : null;
    62	  } catch (err) {
    63	    console.error('Semaphore acquire failed (fail-closed):', err);
    64	    return null;
    65	  }
    66	}
    67	
    68	/**
    69	 * Release a slot in the distributed semaphore.
    70	 */
    71	export async function releaseSemaphore(key: string, holder: string): Promise<void> {
    72	  const redis = getRedis();
    73	  try {
    74	    await redis.eval(RELEASE_LUA, 1, `semaphore:${key}`, holder);
    75	  } catch (err) {
    76	    console.error('Semaphore release failed:', err);
    77	  }
    78	}
     1	import { validateNotInternal } from './ip';
     2	import { PAGE_FETCH_TIMEOUT } from './constants';
     3	
     4	const MAX_REDIRECTS = 5;
     5	
     6	/**
     7	 * Fetch a page's visible text content for industry detection.
     8	 * Strips HTML tags and returns the first ~5000 chars of text.
     9	 *
    10	 * Manual redirect following (up to 5 hops) with per-hop
    11	 * validateNotInternal() DNS+IP checks to prevent SSRF via redirects.
    12	 * Uses a finally block for timer cleanup to prevent leaks.
    13	 */
    14	export async function fetchPageText(url: string): Promise<string> {
    15	  let timeout: ReturnType<typeof setTimeout> | undefined;
    16	  try {
    17	    const controller = new AbortController();
    18	    timeout = setTimeout(() => controller.abort(), PAGE_FETCH_TIMEOUT);
    19	
    20	    let currentUrl = url;
    21	    let hops = 0;
    22	
    23	    while (true) {
    24	      await validateNotInternal(currentUrl);
    25	
    26	      const res = await fetch(currentUrl, {
    27	        headers: {
    28	          'User-Agent': 'Mozilla/5.0 (compatible; TriageCRM/1.0; +https://triagecrm.com)',
    29	          'Accept': 'text/html',
    30	        },
    31	        signal: controller.signal,
    32	        redirect: 'manual',
    33	      });
    34	
    35	      if (res.status >= 300 && res.status < 400) {
    36	        const location = res.headers.get('Location');
    37	        if (!location) return '';
    38	        hops++;
    39	        if (hops > MAX_REDIRECTS) return '';
    40	        currentUrl = new URL(location, currentUrl).href;
    41	        continue;
    42	      }
    43	
    44	      if (!res.ok) return '';
    45	      const html = await res.text();
    46	      return html
    47	        .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    48	        .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    49	        .replace(/<[^>]+>/g, ' ')
    50	        .replace(/&[a-z]+;/gi, ' ')
    51	        .replace(/\s+/g, ' ')
    52	        .trim()
    53	        .slice(0, 5000);
    54	    }
    55	  } catch {
    56	    return '';
    57	  } finally {
    58	    if (timeout) clearTimeout(timeout);
    59	  }
    60	}
     1	import * as dns from 'dns/promises';
     2	
     3	export function isPrivateIP(ip: string): boolean {
     4	  const normalized = ip.trim().toLowerCase().replace(/^\[|\]$/g, '').split('%')[0];
     5	  if (!normalized) return false;
     6	
     7	  // IPv4
     8	  if (/^\d{1,3}(?:\.\d{1,3}){3}$/.test(normalized)) {
     9	    const octets = normalized.split('.').map(Number);
    10	    if (octets.some((octet) => Number.isNaN(octet) || octet < 0 || octet > 255)) return false;
    11	    const [a, b] = octets;
    12	    return a === 10
    13	      || a === 127
    14	      || (a === 169 && b === 254)
    15	      || (a === 192 && b === 168)
    16	      || (a === 172 && b >= 16 && b <= 31);
    17	  }
    18	
    19	  // IPv4-mapped IPv6
    20	  if (normalized.startsWith('::ffff:')) {
    21	    return isPrivateIP(normalized.slice(7));
    22	  }
    23	
    24	  // IPv6
    25	  if (normalized === '::1') return true;
    26	  if (!normalized.includes(':')) return false;
    27	
    28	  const firstHextetRaw = normalized.split(':', 1)[0];
    29	  const firstHextet = parseInt(firstHextetRaw || '0', 16);
    30	  if (Number.isNaN(firstHextet)) return false;
    31	
    32	  // fc00::/7
    33	  if ((firstHextet & 0xfe00) === 0xfc00) return true;
    34	  // fe80::/10
    35	  if ((firstHextet & 0xffc0) === 0xfe80) return true;
    36	
    37	  return false;
    38	}
    39	
    40	export async function validateNotInternal(url: string): Promise<void> {
    41	  const parsed = new URL(url);
    42	  const hostname = parsed.hostname.trim().toLowerCase();
    43	
    44	  if (hostname === 'localhost' || isPrivateIP(hostname)) {
    45	    throw new Error('Blocked internal hostname');
    46	  }
    47	
    48	  const [v4Result, v6Result] = await Promise.allSettled([
    49	    dns.resolve4(hostname),
    50	    dns.resolve6(hostname),
    51	  ]);
    52	
    53	  if (v4Result.status === 'fulfilled' && v4Result.value.some(isPrivateIP)) {
    54	    throw new Error('Blocked internal IPv4 resolution');
    55	  }
    56	
    57	  if (v6Result.status === 'fulfilled' && v6Result.value.some(isPrivateIP)) {
    58	    throw new Error('Blocked internal IPv6 resolution');
    59	  }
    60	}
     1	const TURNSTILE_SECRET_KEY = process.env.TURNSTILE_SECRET_KEY || '';
     2	const TURNSTILE_VERIFY_URL = 'https://challenges.cloudflare.com/turnstile/v0/siteverify';
     3	
     4	export interface TrustSignals {
     5	  honeypotFilled: boolean;
     6	  prefetchElapsedMs: number | null;
     7	  skipTimingCheck?: boolean;
     8	}
     9	
    10	export interface TrustResult {
    11	  trusted: boolean;
    12	  reason?: string;
    13	}
    14	
    15	/**
    16	 * Evaluate basic trust signals before CRM writes.
    17	 * Checks honeypot field and prefetch timing (must be at least 3s).
    18	 * Fail-closed: missing timing rejects unless skipTimingCheck is set.
    19	 */
    20	export function evaluateTrust(signals: TrustSignals): TrustResult {
    21	  if (signals.honeypotFilled) {
    22	    return { trusted: false, reason: 'honeypot' };
    23	  }
    24	
    25	  if (!signals.skipTimingCheck) {
    26	    if (signals.prefetchElapsedMs === null) {
    27	      return { trusted: false, reason: 'missing_timing' };
    28	    }
    29	    if (signals.prefetchElapsedMs < 3000) {
    30	      return { trusted: false, reason: 'prefetch_too_fast' };
    31	    }
    32	  }
    33	
    34	  return { trusted: true };
    35	}
    36	
    37	/**
    38	 * Verify a Cloudflare Turnstile token server-side.
    39	 * Throws if TURNSTILE_SECRET_KEY is not configured in production.
    40	 */
    41	export async function verifyTurnstile(token: string, ip: string): Promise<boolean> {
    42	  if (!TURNSTILE_SECRET_KEY) {
    43	    throw new Error('TURNSTILE_SECRET_KEY is not configured in production');
    44	  }
    45	
    46	  const controller = new AbortController();
    47	  const timeout = setTimeout(() => controller.abort(), 5000);
    48	
    49	  try {
    50	    const res = await fetch(TURNSTILE_VERIFY_URL, {
    51	      method: 'POST',
    52	      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    53	      signal: controller.signal,
    54	      body: new URLSearchParams({
    55	        secret: TURNSTILE_SECRET_KEY,
    56	        response: token,
    57	        remoteip: ip,
    58	      }),
    59	    });
    60	
    61	    if (!res.ok) return false;
    62	
    63	    const data = await res.json() as { success: boolean };
    64	    return data.success === true;
    65	  } catch (err) {
    66	    console.error('Turnstile verification failed', err);
    67	    return false;
    68	  } finally {
    69	    clearTimeout(timeout);
    70	  }
    71	}
