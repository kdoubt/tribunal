    14	export function triggerWidgetAnimation(): void {
    15	  const widget = document.getElementById('preview-widget')!;
    16	  const overlay = document.getElementById('screenshot-overlay')!;
    17	  const screenshot = document.getElementById('preview-screenshot')!;
    18	  const chrome = document.getElementById('preview-chrome')!;
