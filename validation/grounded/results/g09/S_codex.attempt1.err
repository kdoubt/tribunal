    65	          'Share has been revoked or expired',
    66	          410,
    67	        );
    68	      }
    69	    } else if (payload.scope.startsWith('session:')) {
    70	      const expectedSessionId = payload.scope.slice('session:'.length);
    71	      const session = await validateSession();
    72	      // session is { session, user, ... } | null — the row id is session.session.id.
