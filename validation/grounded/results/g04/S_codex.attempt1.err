    16	/** Convert a spreadsheet File to a CSV File */
    17	async function spreadsheetToCsv(file: File): Promise<File> {
    18	  const buffer = await file.arrayBuffer();
    19	  const workbook = read(buffer);
    20	  const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
    21	  const csv = utils.sheet_to_csv(firstSheet);
    22	  const csvName = file.name.replace(/\.\w+$/, ".csv");
    23	  return new File([csv], csvName, { type: "text/csv" });
    24	}
    25	
    26	/** Re-wrap a File with a corrected MIME type where the browser guessed wrong.
    27	 * .log files are always plain text but browsers may report "" or application/octet-stream. */
    28	function coerceKnownTextExtensions(file: File): File {
    29	  if (/\.log$/i.test(file.name) && !ALL_ACCEPTED_TYPES.has(file.type)) {
    30	    return new File([file], file.name, { type: "text/plain" });
    31	  }
    32	  return file;
    33	}
