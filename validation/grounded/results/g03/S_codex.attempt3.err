     4	
     5	export async function handleListMcpDevices(
     6	  env: Env,
     7	  auth: AuthIdentity | null
     8	): Promise<Response> {
     9	  if (!auth) {
    10	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    11	  }
    12	
    13	  const rows = await env.DB.prepare(
    14	    `SELECT d.id, d.device_name, d.ip_hash, d.created_at, d.last_seen_at,
    15	            d.expires_at, d.status, k.name AS api_key_name
    16	     FROM mcp_devices d
    17	     JOIN api_keys k ON k.id = d.api_key_id
    18	     WHERE d.account_id = ? AND d.status != 'expired'
    19	     ORDER BY d.last_seen_at DESC`
    20	  )
    21	    .bind(auth.accountId)
    22	    .all<{
    23	      id: string;
    24	      device_name: string;
    25	      ip_hash: string | null;
    26	      created_at: string;
    27	      last_seen_at: string;
    28	      expires_at: string;
    29	      status: string;
    30	      api_key_name: string;
    31	    }>();
    32	
    33	  const devices = (rows.results ?? []).map((d) => ({
    34	    id: d.id,
    35	    device_name: d.device_name,
    36	    ip_prefix: d.ip_hash?.slice(0, 8) ?? null,
    37	    created_at: d.created_at,
    38	    last_seen_at: d.last_seen_at,
    39	    expires_at: d.expires_at,
    40	    status: d.status,
    41	    api_key_name: d.api_key_name,
    42	  }));
    43	
    44	  return Response.json({ devices });
    45	}
    46	
    47	export async function handleRevokeMcpDevice(
    48	  deviceId: string,
    49	  env: Env,
    50	  auth: AuthIdentity | null
    51	): Promise<Response> {
    52	  if (!auth) {
    53	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    54	  }
    55	
    56	  const device = await env.DB.prepare(
    57	    "SELECT id, status FROM mcp_devices WHERE id = ? AND account_id = ?"
    58	  )
    59	    .bind(deviceId, auth.accountId)
    60	    .first<{ id: string; status: string }>();
    61	
    62	  if (!device) {
    63	    return apiError(ErrorCodes.ITEM_NOT_FOUND, "Device not found.");
    64	  }
    65	
    66	  if (device.status !== "active") {
    67	    return Response.json({ ok: true, message: "Device is already revoked." });
    68	  }
    69	
    70	  await env.DB.prepare("UPDATE mcp_devices SET status = 'revoked' WHERE id = ?")
    71	    .bind(deviceId)
    72	    .run();
    73	
    74	  return Response.json({ ok: true, message: "Device revoked. It will need to re-authenticate on next request." });
    75	}
