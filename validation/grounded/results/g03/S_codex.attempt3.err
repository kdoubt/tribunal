     5	export async function handleListAccountItems(
     6	  request: Request,
     7	  env: Env,
     8	  auth: AuthIdentity | null
     9	): Promise<Response> {
    10	  if (!auth) {
    11	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    12	  }
    13	
    14	  const url = new URL(request.url);
    15	  const limit = Math.min(parseInt(url.searchParams.get("limit") ?? "50", 10), 100);
    16	  const offset = parseInt(url.searchParams.get("offset") ?? "0", 10);
    17	
    18	  // Build dynamic WHERE from query params
    19	  const conditions = ["account_id = ?", "status NOT IN ('deleted')"];
    20	  const binds: (string | number)[] = [auth.accountId];
    21	
    22	  const category = url.searchParams.get("category");
    23	  if (category) { conditions.push("category = ?"); binds.push(category); }
    24	
    25	  const intent = url.searchParams.get("intent");
    26	  if (intent) { conditions.push("intent = ?"); binds.push(intent); }
    27	
    28	  const priority = url.searchParams.get("priority");
    29	  if (priority) { conditions.push("priority = ?"); binds.push(priority); }
    30	
    31	  const tag = url.searchParams.get("tag");
    32	  if (tag) { conditions.push("tags LIKE ?"); binds.push(`%"${tag}"%`); }
    33	
    34	  const whereClause = conditions.join(" AND ");
    35	
    36	  const items = await env.DB.prepare(
    37	    `SELECT id, status, note, summary, created_at, expires_at, file_count, total_bytes,
    38	            ocr_status, moderation_status, client_type, origin,
    39	            category, intent, priority, tags
    40	     FROM items
    41	     WHERE ${whereClause}
    42	     ORDER BY created_at DESC
    43	     LIMIT ? OFFSET ?`
    44	  )
    45	    .bind(...binds, limit, offset)
    46	    .all<{
    47	      id: string;
    48	      status: string;
    49	      note: string | null;
    50	      summary: string | null;
    51	      created_at: string;
    52	      expires_at: string;
    53	      file_count: number;
    54	      total_bytes: number;
