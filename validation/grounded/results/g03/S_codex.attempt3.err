     4	import { sendMagicLink } from "../lib/email.js";
     5	
     6	export async function handleMagicLinkRequest(
     7	  request: Request,
     8	  env: Env,
     9	  ctx: ExecutionContext
    10	): Promise<Response> {
    11	  let body: { email?: string };
    12	  try {
    13	    body = await request.json() as { email?: string };
    14	  } catch {
    15	    return apiError(ErrorCodes.VALIDATION_ERROR, "Invalid JSON body.");
    16	  }
    17	
    18	  const email = body.email?.trim().toLowerCase();
    19	  if (!email || !email.includes("@") || email.length > 320) {
    20	    return apiError(ErrorCodes.VALIDATION_ERROR, "Valid email required.");
    21	  }
    22	
    23	  // Rate limit: max 3 magic links per email per 15 min
    24	  const fifteenMinAgo = new Date(Date.now() - 15 * 60_000).toISOString();
    25	  const recentTokens = await env.DB.prepare(
    26	    "SELECT COUNT(*) as cnt FROM magic_tokens WHERE email = ? AND created_at > ?"
    27	  )
    28	    .bind(email, fifteenMinAgo)
    29	    .first<{ cnt: number }>();
    30	
    31	  if ((recentTokens?.cnt ?? 0) >= 3) {
    32	    return apiError(ErrorCodes.RATE_LIMITED, "Too many sign-in attempts. Try again in 15 minutes.");
    33	  }
    34	
    35	  // Generate token
    36	  const tokenRaw = generateMagicToken();
    37	  const tokenHash = await hashApiKey(tokenRaw);
    38	  const now = isoNow();
    39	  const expiresAt = new Date(Date.now() + 15 * 60_000).toISOString();
    40	  const ip = request.headers.get("CF-Connecting-IP") ?? "";
    41	  const ipHash = ip ? await hashIp(ip) : null;
    42	
    43	  await env.DB.prepare(
    44	    `INSERT INTO magic_tokens (id, email, token_hash, created_at, expires_at, ip_hash)
    45	     VALUES (?, ?, ?, ?, ?, ?)`
    46	  )
    47	    .bind(generateId(), email, tokenHash, now, expiresAt, ipHash)
    48	    .run();
    49	
    50	  // Send email in background — respond immediately so UI doesn't freeze
    51	  const verifyUrl = `${env.APP_BASE_URL}/api/v1/auth/verify?token=${encodeURIComponent(tokenRaw)}`;
    52	
    53	  if (env.RESEND_API_KEY) {
    54	    ctx.waitUntil(
    55	      sendMagicLink(email, verifyUrl, env.RESEND_API_KEY).catch((err) => {
    56	        console.error("Failed to send magic link email:", err);
    57	      })
    58	    );
    59	  } else {
    60	    console.error("RESEND_API_KEY not configured — magic link not sent");
    61	  }
    62	
    63	  return Response.json({ ok: true, message: "If that email is valid, check your inbox." });
    64	}
     1	import type { Env } from "../env.js";
     2	import { apiError, ErrorCodes } from "@whipnode/protocol";
     3	import { generateId, generateSessionToken, hashApiKey, hashIp, hashUserAgent, isoNow } from "@whipnode/shared";
     4	
     5	export async function handleMagicLinkVerify(
     6	  request: Request,
     7	  env: Env
     8	): Promise<Response> {
     9	  const url = new URL(request.url);
    10	  const tokenRaw = url.searchParams.get("token");
    11	
    12	  if (!tokenRaw) {
    13	    return apiError(ErrorCodes.VALIDATION_ERROR, "Missing token.");
    14	  }
    15	
    16	  const tokenHash = await hashApiKey(tokenRaw);
    17	  const now = isoNow();
    18	
    19	  // Atomically mark token as used — the WHERE clause prevents TOCTOU races
    20	  // where two concurrent requests could both read used_at IS NULL before either writes.
    21	  const result = await env.DB.prepare(
    22	    "UPDATE magic_tokens SET used_at = ? WHERE token_hash = ? AND used_at IS NULL AND expires_at > ?"
    23	  ).bind(now, tokenHash, now).run();
    24	
    25	  if (!result.meta.changes || result.meta.changes === 0) {
    26	    return apiError(ErrorCodes.UNAUTHORIZED, "Invalid, expired, or already used link.");
    27	  }
    28	
    29	  // Fetch email from the now-consumed token
    30	  const token = await env.DB.prepare(
    31	    "SELECT email FROM magic_tokens WHERE token_hash = ?"
    32	  ).bind(tokenHash).first<{ email: string }>();
    33	
    34	  if (!token) {
    35	    return apiError(ErrorCodes.UNAUTHORIZED, "Invalid or expired link.");
    36	  }
    37	
    38	  // Upsert account
    39	  let account = await env.DB.prepare("SELECT id, plan FROM accounts WHERE email = ?")
    40	    .bind(token.email)
    41	    .first<{ id: string; plan: string }>();
    42	
    43	  if (!account) {
    44	    const accountId = generateId();
    45	    await env.DB.prepare(
    46	      "INSERT INTO accounts (id, email, created_at, plan, status) VALUES (?, ?, ?, 'free', 'active')"
    47	    )
    48	      .bind(accountId, token.email, now)
    49	      .run();
    50	    account = { id: accountId, plan: "free" };
    51	  }
    52	
    53	  // Create session
    54	  const sessionTokenRaw = generateSessionToken();
    55	  const sessionHash = await hashApiKey(sessionTokenRaw);
    56	  const sessionExpires = new Date(Date.now() + 30 * 24 * 3600_000).toISOString(); // 30 days
    57	  const ip = request.headers.get("CF-Connecting-IP") ?? "";
    58	  const ipHash = ip ? await hashIp(ip) : null;
    59	  const ua = request.headers.get("User-Agent") ?? "";
    60	
    61	  // Note: the "user_agent" column stores a SHA-256 hash (via hashUserAgent),
    62	  // not the raw User-Agent string. The column name is a legacy misnomer —
    63	  // renaming would require a migration for a non-functional change.
    64	  await env.DB.prepare(
    65	    `INSERT INTO sessions (id, account_id, token_hash, created_at, expires_at, last_seen, ip_hash, user_agent)
    66	     VALUES (?, ?, ?, ?, ?, ?, ?, ?)`
    67	  )
    68	    .bind(generateId(), account.id, sessionHash, now, sessionExpires, now, ipHash, await hashUserAgent(ua))
    69	    .run();
    70	
    71	  // Redirect to dashboard with session cookie
    72	  const headers = new Headers({
    73	    Location: `${env.APP_BASE_URL}/dashboard`,
    74	    "Set-Cookie": `wn_session=${sessionTokenRaw}; HttpOnly; Secure; SameSite=Lax; Path=/; Max-Age=${30 * 24 * 3600}`,
    75	  });
    76	
    77	  return new Response(null, { status: 302, headers });
    78	}
     1	import type { Env } from "../env.js";
     2	import type { ItemRow, ItemFileRow, ItemDerivativeRow } from "@whipnode/protocol";
     3	import { CLEANUP_BATCH_SIZE } from "@whipnode/protocol";
     4	import { groqSummarize, groqClassify } from "../lib/groq.js";
     5	
     6	/**
     7	 * Scheduled cleanup: runs every 15 minutes.
     8	 * Finds expired items, deletes R2 objects, marks items as deleted.
     9	 */
    10	export async function handleScheduled(env: Env): Promise<void> {
    11	  const now = new Date().toISOString();
    12	
    13	  // Find expired items not yet cleaned up
    14	  const expired = await env.DB.prepare(
    15	    `SELECT id FROM items
    16	     WHERE expires_at <= ? AND status NOT IN ('deleted')
    17	     LIMIT ?`
    18	  )
    19	    .bind(now, CLEANUP_BATCH_SIZE)
    20	    .all<{ id: string }>();
    21	
    22	  if (!expired.results || expired.results.length === 0) {
    23	    return;
    24	  }
    25	
    26	  for (const item of expired.results) {
    27	    await cleanupItem(item.id, env);
    28	  }
    29	
    30	  console.log(`Cleanup: processed ${expired.results.length} expired items.`);
    31	
    32	  // Mark stale processing items as error
    33	  // Items stuck in 'processing' for >15 min have likely failed silently
    34	  const stale = await env.DB.prepare(
    35	    `UPDATE items SET status = 'error'
    36	     WHERE status = 'processing'
    37	     AND created_at <= datetime(?, '-15 minutes')`
    38	  )
    39	    .bind(now)
    40	    .run();
    41	
    42	  if (stale.meta.changes && stale.meta.changes > 0) {
    43	    console.log(`Cleanup: marked ${stale.meta.changes} stale processing items as error.`);
    44	  }
    45	
    46	  // Purge expired magic tokens and sessions
    47	  await env.DB.prepare("DELETE FROM magic_tokens WHERE expires_at <= ?").bind(now).run();
    48	  await env.DB.prepare("DELETE FROM sessions WHERE expires_at <= ?").bind(now).run();
    49	
    50	  // Mark expired MCP device sessions
    51	  const expiredDevices = await env.DB.prepare(
    52	    "UPDATE mcp_devices SET status = 'expired' WHERE expires_at <= ? AND status = 'active'"
    53	  ).bind(now).run();
    54	  if (expiredDevices.meta.changes && expiredDevices.meta.changes > 0) {
    55	    console.log(`Cleanup: expired ${expiredDevices.meta.changes} MCP device sessions.`);
    56	  }
    57	
    58	  // Hard-delete devices revoked/expired more than 30 days ago
    59	  await env.DB.prepare(
    60	    "DELETE FROM mcp_devices WHERE status IN ('revoked', 'expired') AND last_seen_at <= datetime(?, '-30 days')"
    61	  ).bind(now).run();
    62	
    63	  // ── Sweep stale staged raw uploads (>24h old) ──────────
    64	  await sweepStagedUploads(env);
    65	
    66	  // ── Backfill: classify items that missed classification ──
    67	  await backfillClassification(env);
    68	}
    69	
    70	/**
    71	 * Delete staged raw uploads (POST /api/v1/uploads) that were never consumed
    72	 * into an item within 24h, plus consumed rows past the same window (their
    73	 * staging R2 objects are already deleted at consume time).
    74	 */
    75	async function sweepStagedUploads(env: Env): Promise<void> {
    76	  const cutoff = new Date(Date.now() - 24 * 3600_000).toISOString();
    77	  const stale = await env.DB.prepare(
    78	    "SELECT id, r2_key FROM uploads WHERE created_at <= ? LIMIT ?"
    79	  )
    80	    .bind(cutoff, CLEANUP_BATCH_SIZE)
    81	    .all<{ id: string; r2_key: string }>();
    82	
    83	  if (!stale.results || stale.results.length === 0) return;
    84	
    85	  for (const row of stale.results) {
    86	    try {
    87	      await env.R2.delete(row.r2_key);
    88	    } catch {
    89	      // Object may already be gone (consumed uploads) — row cleanup proceeds
    90	    }
    91	    await env.DB.prepare("DELETE FROM uploads WHERE id = ?").bind(row.id).run();
    92	  }
    93	  console.log(`Cleanup: swept ${stale.results.length} stale staged uploads.`);
    94	}
    95	
    96	/**
    97	 * Retry classification for items that are ready but have no category.
    98	 * Picks up items that failed classification due to Groq downtime.
    99	 * Processes up to 10 per run (every 15 min) to stay within Groq limits.
   100	 */
   101	async function backfillClassification(env: Env): Promise<void> {
   102	  const unclassified = await env.DB.prepare(
   103	    `SELECT id, note, origin FROM items
   104	     WHERE status = 'ready' AND category IS NULL
   105	     AND created_at > datetime('now', '-24 hours')
   106	     ORDER BY created_at DESC
   107	     LIMIT 10`
   108	  ).all<{ id: string; note: string | null; origin: string | null }>();
   109	
   110	  if (!unclassified.results?.length) return;
   111	
   112	  let classified = 0;
   113	  for (const item of unclassified.results) {
   114	    try {
   115	      // Get file info for context
   116	      const files = await env.DB.prepare(
   117	        "SELECT filename, mime_type FROM item_files WHERE item_id = ?"
   118	      ).bind(item.id).all<{ filename: string; mime_type: string }>();
   119	
   120	      const ocrRow = await env.DB.prepare(
   121	        "SELECT cleaned_ocr FROM items WHERE id = ?"
   122	      ).bind(item.id).first<{ cleaned_ocr: string | null }>();
   123	
   124	      const context = {
   125	        note: item.note,
   126	        ocrText: ocrRow?.cleaned_ocr ?? null,
   127	        filenames: (files.results ?? []).map((f) => f.filename),
   128	        mimeTypes: (files.results ?? []).map((f) => f.mime_type),
   129	        origin: item.origin ?? undefined,
   130	      };
   131	
   132	      const [summary, classification] = await Promise.all([
   133	        groqSummarize(env, context),
   134	        groqClassify(env, context),
   135	      ]);
   136	
   137	      const updates: string[] = [];
   138	      const values: (string | null)[] = [];
   139	      if (summary) { updates.push("summary = ?"); values.push(summary); }
   140	      if (classification) {
   141	        updates.push("category = ?"); values.push(classification.category);
   142	        updates.push("intent = ?"); values.push(classification.intent);
   143	        updates.push("priority = ?"); values.push(classification.priority);
   144	        updates.push("tags = ?"); values.push(JSON.stringify(classification.tags));
   145	      }
   146	
   147	      if (updates.length > 0) {
   148	        await env.DB.prepare(`UPDATE items SET ${updates.join(", ")} WHERE id = ?`)
   149	          .bind(...values, item.id).run();
   150	        classified++;
   151	      }
   152	    } catch {
   153	      // Non-fatal — will retry next scheduled run
   154	    }
   155	  }
   156	
   157	  if (classified > 0) {
   158	    console.log(`Backfill: classified ${classified}/${unclassified.results.length} items.`);
   159	  }
   160	}
   161	
   162	async function cleanupItem(itemId: string, env: Env): Promise<void> {
   163	  // Get all file R2 keys
   164	  const files = await env.DB.prepare(
   165	    "SELECT r2_key FROM item_files WHERE item_id = ?"
   166	  )
   167	    .bind(itemId)
   168	    .all<{ r2_key: string }>();
   169	
   170	  // Get all derivative R2 keys
   171	  const derivatives = await env.DB.prepare(
   172	    "SELECT r2_key FROM item_derivatives WHERE item_id = ?"
   173	  )
   174	    .bind(itemId)
   175	    .all<{ r2_key: string }>();
   176	
   177	  // Delete all R2 objects
   178	  const allKeys = [
   179	    ...(files.results ?? []).map((f) => f.r2_key),
   180	    ...(derivatives.results ?? []).map((d) => d.r2_key),
   181	  ];
   182	
   183	  // R2 delete supports batches of up to 1000 keys
   184	  if (allKeys.length > 0) {
   185	    await env.R2.delete(allKeys);
   186	  }
   187	
   188	  // Mark item as deleted (tombstone for analytics/abuse tracking)
   189	  await env.DB.prepare("UPDATE items SET status = 'deleted' WHERE id = ?")
   190	    .bind(itemId)
   191	    .run();
