    59	      category: string | null;
    60	      intent: string | null;
    61	      priority: string | null;
    62	      tags: string | null;
    63	    }>();
    64	
    65	  const total = await env.DB.prepare(
    66	    `SELECT COUNT(*) as cnt FROM items WHERE ${whereClause}`
    67	  )
    68	    .bind(...binds)
    69	    .first<{ cnt: number }>();
    70	
    71	  const base = env.APP_BASE_URL;
    72	
