    52	  const auth = rawAuth?.type === "rejected" ? null : rawAuth;
    53	
    54	  let response: Response;
    55	
    56	  try {
    57	    // ── MCP endpoint ──────────────────────────────────────
    58	    if (method === "POST" && path === "/api/v1/mcp") {
    59	      response = await handleMcp(request, env, rawAuth);
    60	    }
    61	    // ── Health ──────────────────────────────────────────────
    62	    else if (method === "GET" && path === "/api/v1/health") {
    63	      response = handleHealth();
    64	    }
    65	    // ── Whip count (public) ──────────────────────────────
    66	    else if (method === "GET" && path === "/api/v1/whips") {
    67	      response = await handleGetWhipCount(env);
    68	    }
    69	    // ── Owner stats (protected by CF Access) ───────────────
    70	    else if (method === "GET" && path === "/api/v1/admin/logs") {
    71	      response = await handleGetLogs(request, env, auth);
    72	    }
    73	    else if (method === "GET" && path === "/api/v1/admin/report") {
    74	      response = await handleGetReport(request, env, auth);
    75	    }
    76	    else if (method === "GET" && (path === "/api/v1/owner/stats" || path === "/api/v1/admin/stats")) {
    77	      response = await handleOwnerStats(request, env, auth);
    78	    }
    79	    else if (method === "PATCH" && path.match(/^\/api\/v1\/admin\/accounts\/[^/]+$/)) {
