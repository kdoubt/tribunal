   274	export async function handleMcp(
   275	  request: Request,
   276	  env: Env,
   277	  auth: AuthContext
   278	): Promise<Response> {
   279	  // Check for specific rejection reasons from device auth
   280	  if (auth && auth.type === "rejected") {
   281	    const reason = auth.reason;
   282	    const messages: Record<string, string> = {
   283	      device_revoked: "This device has been revoked. Re-run the install command with your API key to reconnect: claude mcp add whipnode --transport http https://whipnode.com/api/v1/mcp --header \"X-API-Key: YOUR_KEY\"",
   284	      device_expired: "This device session expired (inactive for 90+ days). Re-run the install command to reconnect: claude mcp add whipnode --transport http https://whipnode.com/api/v1/mcp --header \"X-API-Key: YOUR_KEY\"",
   285	      key_revoked: "The API key used to register this device has been revoked. Create a new key at whipnode.com/dashboard#api-keys and re-run the install command.",
   286	      account_inactive: "Your WhipNode account has been deactivated. Contact <email>.",
   287	    };
   288	    return jsonRpcError(null, -32000, messages[reason] ?? "Authentication failed.");
   289	  }
   290	
   291	  if (!auth) {
   292	    return jsonRpcError(null, -32000, "Authentication required. Pass your API key in the X-API-Key header.");
   293	  }
   294	
   295	  // Fix 4: per-account rate limiting
   296	  if (!checkMcpRateLimit(auth.accountId)) {
   297	    return jsonRpcError(null, -32000, "Rate limit exceeded. Maximum 60 MCP requests per minute.");
   298	  }
   299	
   300	  // Reject oversized payloads before parsing
   301	  const contentLength = parseInt(request.headers.get("Content-Length") ?? "0", 10);
   302	  if (contentLength > 1_048_576) {
   303	    return jsonRpcError(null, -32600, "Request too large. Maximum 1MB.");
   304	  }
   305	
   306	  let body: unknown;
   307	  try {
   308	    body = await request.json();
   309	  } catch {
   310	    return jsonRpcError(null, -32700, "Parse error: invalid JSON.");
   311	  }
   312	
   313	  // Fix 2: batch size limit
   314	  let response: Response;
   315	  if (Array.isArray(body)) {
   316	    if (body.length > MAX_BATCH_SIZE) {
   317	      return jsonRpcError(null, -32600, `Batch too large. Maximum ${MAX_BATCH_SIZE} requests per batch.`);
   318	    }
   319	    const results = await Promise.all(
   320	      body.map((req: unknown) => handleSingleRequest(req, env, auth))
   321	    );
   322	    const responses = results.filter((r): r is JsonRpcResponse => r !== null);
   323	    response = responses.length === 0
   324	      ? new Response(null, { status: 202 })
   325	      : Response.json(responses);
   326	  } else {
   327	    const result = await handleSingleRequest(body, env, auth);
   328	    response = result === null
   329	      ? new Response(null, { status: 202 })
   330	      : Response.json(result);
   331	  }
   332	
   333	  // Device enrollment: if authenticated via API key (not yet a device session)
   334	  // and this is an initialize request, create a device and assign Mcp-Session-Id
   335	  if (auth.type === "api_key" && isInitializeRequest(body)) {
   336	    try {
   337	      // Enforce device quota per API key (max 10) — atomic via conditional INSERT
   338	      const sessionToken = generateMcpSessionToken();
   339	      const tokenHash = await hashApiKey(sessionToken);
   340	      const deviceName = parseDeviceName(request.headers.get("User-Agent"));
   341	      const ip = request.headers.get("CF-Connecting-IP") ?? "";
   342	      const ua = request.headers.get("User-Agent") ?? "";
   343	      const now = isoNow();
   344	      const expiresAt = new Date(Date.now() + 90 * 24 * 3600_000).toISOString(); // 90 days
   345	      const deviceId = generateId();
   346	
   347	      // Atomic quota enforcement: INSERT only if count < 10
   348	      const insertResult = await env.DB.prepare(
   349	        `INSERT INTO mcp_devices (id, account_id, api_key_id, session_token_hash,
   350	         device_name, ip_hash, user_agent_hash, created_at, last_seen_at, expires_at, status)
   351	         SELECT ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active'
   352	         WHERE (SELECT COUNT(*) FROM mcp_devices WHERE api_key_id = ? AND status = 'active') < 10`
   353	      )
   354	        .bind(
   355	          deviceId,
   356	          auth.accountId,
   357	          auth.keyId,
   358	          tokenHash,
   359	          deviceName,
   360	          ip ? await hashIp(ip) : null,
   361	          ua ? await hashUserAgent(ua) : null,
   362	          now,
   363	          now,
   364	          expiresAt,
   365	          auth.keyId
   366	        )
   367	        .run();
   368	
   369	      if (!insertResult.meta.changes) {
   370	        log(env, {
   371	          level: "warn", code: LogCodes.MCP_DEVICE_QUOTA_HIT, source: "mcp",
   372	          message: "Device quota reached (10), skipping enrollment",
   373	          accountId: auth.accountId, apiKeyId: auth.keyId,
   374	        });
   375	        return response;
   376	      }
   377	
   378	      log(env, {
   379	        level: "info", code: LogCodes.MCP_DEVICE_ENROLLED, source: "mcp",
   380	        message: `Device enrolled: ${deviceName}`,
   381	        accountId: auth.accountId, apiKeyId: auth.keyId,
   382	        ip: request.headers.get("CF-Connecting-IP"),
   383	      });
   384	
   385	      const headers = new Headers(response.headers);
   386	      headers.set("Mcp-Session-Id", sessionToken);
   387	      return new Response(response.body, { status: response.status, headers });
   388	    } catch (err) {
   389	      log(env, {
   390	        level: "error", code: LogCodes.SYSTEM_ERROR, source: "mcp",
   391	        message: `Device enrollment failed: ${err instanceof Error ? err.message : err}`,
   392	        accountId: auth.accountId,
   393	      });
   394	      // Don't fail the request — return the response without the session
   395	    }
   396	  }
   397	
   398	  return response;
   399	}
