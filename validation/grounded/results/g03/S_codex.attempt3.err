   222	export async function handleCapture(
   223	  request: Request,
   224	  env: Env,
   225	  ctx: ExecutionContext,
   226	  auth: AuthIdentity | null
   227	): Promise<Response> {
   228	  // Captures require authentication
   229	  if (!auth) {
   230	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required. URL captures require an API key.");
   231	  }
   232	
   233	  // Daily upload limit
