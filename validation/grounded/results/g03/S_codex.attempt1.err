   102	  }
   103	  if (row.key_status !== "active") {
   104	    return { type: "rejected", reason: "key_revoked" };
   105	  }
   106	  if (row.account_status !== "active") {
   107	    return { type: "rejected", reason: "account_inactive" };
   108	  }
   109	  if (new Date(row.expires_at) < new Date()) {
   110	    return { type: "rejected", reason: "device_expired" };
   111	  }
   112	  if (row.status !== "active") return null;
