   196	// ── Session Cookie ──────────────────────────────────────────
   197	
   198	async function resolveSession(
   199	  raw: string,
   200	  env: Env
   201	): Promise<AuthContext> {
   202	  const tokenHash = await hashApiKey(raw);
   203	
   204	  const row = await env.DB.prepare(
   205	    `SELECT s.id, s.account_id, s.expires_at,
   206	            a.plan, a.email, a.status AS account_status
   207	     FROM sessions s
   208	     JOIN accounts a ON a.id = s.account_id
   209	     WHERE s.token_hash = ?`
   210	  )
   211	    .bind(tokenHash)
   212	    .first<{
   213	      id: string;
   214	      account_id: string;
   215	      expires_at: string;
   216	      plan: string;
   217	      email: string;
   218	      account_status: string;
   219	    }>();
   220	
   221	  if (!row || row.account_status !== "active") {
   222	    return null;
   223	  }
   224	
   225	  if (new Date(row.expires_at) < new Date()) {
   226	    env.DB.prepare("DELETE FROM sessions WHERE id = ?")
   227	      .bind(row.id)
   228	      .run()
   229	      .catch(() => {});
   230	    return null;
   231	  }
   232	
   233	  env.DB.prepare("UPDATE sessions SET last_seen = datetime('now') WHERE id = ?")
   234	    .bind(row.id)
   235	    .run()
   236	    .catch(() => {});
   237	
   238	  return {
   239	    type: "session",
   240	    accountId: row.account_id,
   241	    plan: row.plan as AccountPlan,
   242	    email: row.email,
   243	  };
   244	}
