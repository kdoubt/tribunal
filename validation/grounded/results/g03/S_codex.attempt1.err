    32	export async function handleApiRequest(
    33	  request: Request,
    34	  env: Env,
    35	  ctx: ExecutionContext
    36	): Promise<Response> {
    37	  // CORS preflight
    38	  if (request.method === "OPTIONS") {
    39	    return handleCors(request, env.APP_BASE_URL);
    40	  }
    41	
    42	  const url = new URL(request.url);
    43	  const path = url.pathname;
    44	  const method = request.method;
    45	
    46	  // Resolve authentication (does not reject anonymous)
    47	  const rawAuth = await resolveAuth(request, env);
    48	
    49	  // MCP gets the full auth (including rejections for error messages).
    50	  // All other routes get null if auth was rejected — they should not
    51	  // see the rejected object since it lacks accountId/email/plan.
    52	  const auth = rawAuth?.type === "rejected" ? null : rawAuth;
    53	
    54	  let response: Response;
    55	
    56	  try {
    57	    // ── MCP endpoint ──────────────────────────────────────
    58	    if (method === "POST" && path === "/api/v1/mcp") {
    59	      response = await handleMcp(request, env, rawAuth);
    60	    }
    61	    // ── Health ──────────────────────────────────────────────
    62	    else if (method === "GET" && path === "/api/v1/health") {
    63	      response = handleHealth();
    64	    }
    65	    // ── Whip count (public) ──────────────────────────────
    66	    else if (method === "GET" && path === "/api/v1/whips") {
    67	      response = await handleGetWhipCount(env);
    68	    }
    69	    // ── Owner stats (protected by CF Access) ───────────────
    70	    else if (method === "GET" && path === "/api/v1/admin/logs") {
    71	      response = await handleGetLogs(request, env, auth);
    72	    }
    73	    else if (method === "GET" && path === "/api/v1/admin/report") {
    74	      response = await handleGetReport(request, env, auth);
    75	    }
    76	    else if (method === "GET" && (path === "/api/v1/owner/stats" || path === "/api/v1/admin/stats")) {
    77	      response = await handleOwnerStats(request, env, auth);
    78	    }
    79	    else if (method === "PATCH" && path.match(/^\/api\/v1\/admin\/accounts\/[^/]+$/)) {
    80	      const email = decodeURIComponent(path.split("/")[5]);
    81	      response = await handleUpdateAccount(email, request, env, auth);
    82	    }
    83	
    84	    // ── Auth routes ────────────────────────────────────────
    85	    else if (method === "POST" && path === "/api/v1/auth/magic-link") {
    86	      response = await handleMagicLinkRequest(request, env, ctx);
    87	    }
    88	    else if (method === "GET" && path === "/api/v1/auth/verify") {
    89	      response = await handleMagicLinkVerify(request, env);
    90	    }
    91	    else if (method === "POST" && path === "/api/v1/auth/logout") {
    92	      response = await handleLogout(request, env, auth);
    93	    }
    94	    else if (method === "GET" && path === "/api/v1/auth/me") {
    95	      response = await handleGetMe(auth);
    96	    }
    97	
    98	    // ── API key routes ─────────────────────────────────────
    99	    else if (method === "POST" && path === "/api/v1/api-keys") {
   100	      response = await handleCreateApiKey(request, env, auth);
   101	    }
   102	    else if (method === "GET" && path === "/api/v1/api-keys") {
   103	      response = await handleListApiKeys(env, auth);
   104	    }
   105	    else if (method === "POST" && path.match(/^\/api\/v1\/api-keys\/[^/]+\/rotate$/)) {
   106	      const keyId = path.split("/")[4];
   107	      response = await handleRotateApiKey(keyId, env, auth);
   108	    }
   109	    else if (method === "DELETE" && path.match(/^\/api\/v1\/api-keys\/[^/]+$/)) {
   110	      const keyId = path.split("/")[4];
   111	      response = await handleRevokeApiKey(keyId, env, auth);
   112	    }
   113	
   114	    // ── MCP device routes ─────────────────────────────────
   115	    else if (method === "GET" && path === "/api/v1/mcp-devices") {
   116	      response = await handleListMcpDevices(env, auth);
   117	    }
   118	    else if (method === "DELETE" && path.match(/^\/api\/v1\/mcp-devices\/[^/]+$/)) {
   119	      const deviceId = path.split("/")[4];
   120	      response = await handleRevokeMcpDevice(deviceId, env, auth);
   121	    }
   122	    else if (method === "PATCH" && path.match(/^\/api\/v1\/mcp-devices\/[^/]+$/)) {
   123	      const deviceId = path.split("/")[4];
   124	      response = await handleRenameMcpDevice(deviceId, request, env, auth);
   125	    }
   126	
   127	    // ── Account routes ─────────────────────────────────────
   128	    else if (method === "GET" && path === "/api/v1/account/usage") {
   129	      response = await handleGetUsage(env, auth);
   130	    }
   131	    else if (method === "GET" && path === "/api/v1/account/items") {
   132	      response = await handleListAccountItems(request, env, auth);
   133	    }
   134	
   135	    // ── Preview routes ─────────────────────────────────────
