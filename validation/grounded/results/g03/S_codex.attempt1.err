    43	// ── Sitemap extraction ──────────────────────────────────────
    44	
    45	interface PageLink {
    46	  href: string;
    47	  text: string;
    48	  context: string; // nav, header, footer, main, other
    49	}
    50	
    51	/**
    52	 * Extract links from a Puppeteer page and build an ASCII sitemap tree.
    53	 * Separates same-origin (internal) links from external links.
    54	 */
    55	async function extractSitemap(page: any, sourceUrl: string): Promise<string> {
    56	  const parsed = new URL(sourceUrl);
    57	  let origin = parsed.origin;
    58	
    59	  // Use canonical URL if available (avoids preview/staging URLs in output)
    60	  const canonical: string | null = await page.evaluate(() => {
    61	    const link = document.querySelector('link[rel="canonical"]') as HTMLLinkElement | null;
    62	    return link?.href ?? null;
    63	  });
    64	  if (canonical) {
    65	    try {
    66	      const canonicalParsed = new URL(canonical);
    67	      origin = canonicalParsed.origin;
    68	      sourceUrl = canonical;
    69	    } catch { /* keep original */ }
    70	  }
    71	
    72	  // Extract all <a> links with context about where they appear in the DOM
    73	  const links: PageLink[] = await page.evaluate(() => {
    74	    const results: Array<{ href: string; text: string; context: string }> = [];
    75	    const anchors = document.querySelectorAll("a[href]");
    76	
    77	    for (const a of Array.from(anchors)) {
    78	      const href = (a as HTMLAnchorElement).href;
    79	      if (!href || href.startsWith("javascript:") || href.startsWith("#") || href === "about:blank") continue;
    80	
    81	      const text = (a.textContent || "").trim().slice(0, 80);
    82	      if (!text) continue;
    83	
    84	      // Determine context
    85	      let context = "other";
    86	      let el: HTMLElement | null = a as HTMLElement;
    87	      while (el) {
    88	        const tag = el.tagName?.toLowerCase();
    89	        if (tag === "nav") { context = "nav"; break; }
    90	        if (tag === "header") { context = "header"; break; }
    91	        if (tag === "footer") { context = "footer"; break; }
    92	        if (tag === "main" || tag === "article") { context = "main"; break; }
    93	        el = el.parentElement;
    94	      }
    95	
    96	      results.push({ href, text, context });
    97	    }
    98	    return results;
    99	  });
   100	
   101	  // Deduplicate by href
   102	  const seen = new Set<string>();
   103	  const unique: PageLink[] = [];
   104	  for (const link of links) {
   105	    const normalized = link.href.replace(/\/$/, "").replace(/#.*$/, "");
   106	    if (seen.has(normalized)) continue;
   107	    seen.add(normalized);
   108	    unique.push({ ...link, href: normalized });
   109	  }
   110	
   111	  // Split into internal and external
   112	  const internal: PageLink[] = [];
   113	  const external: PageLink[] = [];
   114	  for (const link of unique) {
   115	    try {
   116	      const linkOrigin = new URL(link.href).origin;
   117	      if (linkOrigin === origin) {
   118	        internal.push(link);
   119	      } else {
   120	        external.push(link);
   121	      }
   122	    } catch {
   123	      // Invalid URL, skip
   124	    }
   125	  }
   126	
   127	  // Build ASCII path tree from internal links
   128	  const tree = buildPathTree(internal, origin);
   129	
   130	  // Compose the output
   131	  const lines: string[] = [];
   132	  lines.push(`# Sitemap: ${sourceUrl}`);
   133	  lines.push(`# Extracted: ${new Date().toISOString()}`);
   134	  lines.push(`# Internal links: ${internal.length} | External links: ${external.length}`);
   135	  lines.push("");
   136	  lines.push("## Site Structure");
   137	  lines.push("");
   138	  lines.push(tree);
   139	
   140	  if (external.length > 0) {
   141	    lines.push("");
   142	    lines.push("## External Links");
   143	    lines.push("");
   144	    for (const link of external.slice(0, 50)) {
   145	      lines.push(`  ${link.text}`);
   146	      lines.push(`  └─ ${link.href}`);
   147	    }
   148	    if (external.length > 50) {
   149	      lines.push(`  ... and ${external.length - 50} more`);
   150	    }
   151	  }
   152	
   153	  return lines.join("\n");
   154	}
   155	
   156	/**
   157	 * Build an ASCII tree from a list of internal links, organized by path segments.
   158	 */
   159	function buildPathTree(links: PageLink[], origin: string): string {
   160	  // Parse paths into a tree structure
   161	  interface TreeNode {
   162	    children: Map<string, TreeNode>;
   163	    label?: string; // link text
   164	    fullPath: string;
   165	    context?: string;
   166	  }
   167	
   168	  const root: TreeNode = { children: new Map(), fullPath: "/" };
   169	
   170	  for (const link of links) {
   171	    try {
   172	      const u = new URL(link.href);
   173	      const segments = u.pathname.split("/").filter(Boolean);
   174	      let current = root;
   175	
   176	      for (let i = 0; i < segments.length; i++) {
   177	        const seg = segments[i];
   178	        if (!current.children.has(seg)) {
   179	          current.children.set(seg, {
   180	            children: new Map(),
   181	            fullPath: "/" + segments.slice(0, i + 1).join("/"),
   182	          });
   183	        }
   184	        current = current.children.get(seg)!;
   185	      }
   186	
   187	      // Leaf node gets the link text and context
   188	      current.label = link.text;
   189	      current.context = link.context;
   190	    } catch {
   191	      // Skip invalid
   192	    }
   193	  }
   194	
   195	  // Render tree to ASCII
   196	  const lines: string[] = [];
   197	  lines.push(`${origin}/`);
   198	  renderNode(root, "", true, lines);
   199	  return lines.join("\n");
   200	}
   201	
   202	function renderNode(node: { children: Map<string, any>; label?: string; context?: string }, prefix: string, isLast: boolean, lines: string[]): void {
   203	  const entries = [...node.children.entries()].sort(([a], [b]) => a.localeCompare(b));
   204	
   205	  for (let i = 0; i < entries.length; i++) {
   206	    const [segment, child] = entries[i];
   207	    const last = i === entries.length - 1;
   208	    const connector = last ? "└── " : "├── ";
   209	    const label = child.label ? ` (${child.label})` : "";
   210	    const ctx = child.context && child.context !== "other" ? ` [${child.context}]` : "";
   211	    lines.push(`${prefix}${connector}${segment}/${label}${ctx}`);
   212	
   213	    const childPrefix = prefix + (last ? "    " : "│   ");
   214	    if (child.children.size > 0) {
   215	      renderNode(child, childPrefix, last, lines);
   216	    }
   217	  }
   218	}
