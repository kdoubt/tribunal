   145	            a.plan, a.email, a.status AS account_status
   146	     FROM api_keys k
   147	     JOIN accounts a ON a.id = k.account_id
   148	     WHERE k.key_hash = ?`
   149	  )
   150	    .bind(keyHash)
   151	    .first<{
   152	      id: string;
   153	      account_id: string;
   154	      scopes: string;
   155	      status: string;
   156	      plan: string;
   157	      email: string;
   158	      account_status: string;
   159	    }>();
   160	
   161	  // If not found, check previous_key_hash (rotated keys in grace period)
   162	  if (!row) {
   163	    row = await env.DB.prepare(
   164	      `SELECT k.id, k.account_id, k.scopes, k.status, k.grace_expires_at,
   165	              a.plan, a.email, a.status AS account_status
   166	       FROM api_keys k
   167	       JOIN accounts a ON a.id = k.account_id
   168	       WHERE k.previous_key_hash = ? AND k.grace_expires_at > datetime('now')`
   169	    )
   170	      .bind(keyHash)
   171	      .first<any>();
   172	  }
   173	
   174	  if (!row || row.status !== "active" || row.account_status !== "active") {
   175	    return null;
   176	  }
   177	
   178	  // Update last_used_at and use_count
   179	  env.DB.prepare("UPDATE api_keys SET last_used_at = datetime('now'), use_count = use_count + 1 WHERE id = ?")
   180	    .bind(row.id)
   181	    .run()
   182	    .catch(() => {});
   183	
   184	  const scopes = JSON.parse(row.scopes) as string[];
   185	
   186	  return {
   187	    type: "api_key",
   188	    accountId: row.account_id,
   189	    keyId: row.id,
   190	    scopes,
   191	    plan: row.plan as AccountPlan,
   192	    email: row.email,
   193	  };
   194	}
