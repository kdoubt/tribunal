    46	    .bind(ipHash)
    47	    .first<{ cnt: number }>();
    48	
    49	  const processing = processingResult?.cnt ?? 0;
    50	
    51	  if (processing >= ABUSE_BUDGET.MAX_CONCURRENT_PROCESSING_PER_IP) {
    52	    return {
    53	      allowed: false,
    54	      reason: `Too many items processing. Wait for current uploads to complete.`,
    55	    };
    56	  }
    57	
    58	  return { allowed: true };
    59	}
    60	
    61	/**
    62	 * Check daily upload limit for authenticated users.
    63	 * Uses D1 to count uploads created today for the account.
    64	 */
    65	export async function checkDailyUploadLimit(
    66	  accountId: string,
    67	  plan: string,
    68	  env: Env
    69	): Promise<RateLimitResult> {
    70	  const limits = PLAN_LIMITS[plan] ?? PLAN_LIMITS.free;
    71	  const startOfDay = new Date();
    72	  startOfDay.setUTCHours(0, 0, 0, 0);
    73	
    74	  const countResult = await env.DB.prepare(
    75	    "SELECT COUNT(*) as cnt FROM items WHERE account_id = ? AND created_at > ?"
    76	  )
    77	    .bind(accountId, startOfDay.toISOString())
    78	    .first<{ cnt: number }>();
    79	
    80	  const todayUploads = countResult?.cnt ?? 0;
    81	
    82	  if (todayUploads >= limits.uploads_per_day) {
    83	    return {
    84	      allowed: false,
    85	      reason: `Daily upload limit reached. Your ${plan} plan allows ${limits.uploads_per_day} uploads per day.`,
    86	    };
    87	  }
    88	
    89	  return { allowed: true };
    90	}
     1	import type { Env } from "../env.js";
     2	import type { AuthContext, AuthIdentity } from "../middleware/auth.js";
     3	import { apiError, ErrorCodes, PLAN_LIMITS } from "@whipnode/protocol";
     4	import { generateId, generateApiKey, hashApiKey, isoNow } from "@whipnode/shared";
     5	
     6	export async function handleCreateApiKey(
     7	  request: Request,
     8	  env: Env,
     9	  auth: AuthIdentity | null
    10	): Promise<Response> {
    11	  if (!auth) {
    12	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    13	  }
    14	
    15	  let body: { name?: string };
    16	  try {
    17	    body = (await request.json()) as { name?: string };
    18	  } catch {
    19	    body = {};
    20	  }
    21	
    22	  const name = body.name?.trim() || "Default";
    23	  if (name.length > 64) {
    24	    return apiError(ErrorCodes.VALIDATION_ERROR, "Key name must be 64 characters or less.");
    25	  }
    26	
    27	  // Check plan limit (per-account override takes precedence)
    28	  const limits = PLAN_LIMITS[auth.plan] ?? PLAN_LIMITS.free;
    29	  const account = await env.DB.prepare(
    30	    "SELECT max_api_keys_override FROM accounts WHERE id = ?"
    31	  )
    32	    .bind(auth.accountId)
    33	    .first<{ max_api_keys_override: number | null }>();
    34	  const maxKeys = account?.max_api_keys_override ?? limits.max_api_keys;
    35	
    36	  const existing = await env.DB.prepare(
    37	    "SELECT COUNT(*) as cnt FROM api_keys WHERE account_id = ? AND status = 'active'"
    38	  )
    39	    .bind(auth.accountId)
    40	    .first<{ cnt: number }>();
    41	
    42	  if ((existing?.cnt ?? 0) >= maxKeys) {
    43	    return apiError(
    44	      ErrorCodes.FORBIDDEN,
    45	      `Your account allows ${maxKeys} API key(s). Revoke an existing key or upgrade.`
    46	    );
    47	  }
    48	
    49	  const { raw, prefix } = generateApiKey();
    50	  const keyHash = await hashApiKey(raw);
    51	  const now = isoNow();
    52	
    53	  await env.DB.prepare(
    54	    `INSERT INTO api_keys (id, account_id, name, key_hash, created_at, status, scopes)
    55	     VALUES (?, ?, ?, ?, ?, 'active', '["write"]')`
    56	  )
    57	    .bind(generateId(), auth.accountId, name, keyHash, now)
    58	    .run();
    59	
    60	  // Return raw key exactly once
    61	  return Response.json(
    62	    {
    63	      key: raw,
    64	      prefix,
    65	      name,
    66	      message: "Save this key now — it won't be shown again.",
    67	    },
    68	    { status: 201 }
    69	  );
    70	}
    71	
    72	export async function handleListApiKeys(
    73	  env: Env,
    74	  auth: AuthIdentity | null
    75	): Promise<Response> {
    76	  if (!auth) {
    77	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
    78	  }
    79	
    80	  const keys = await env.DB.prepare(
    81	    `SELECT id, name, key_hash, created_at, last_used_at, use_count, status
    82	     FROM api_keys
    83	     WHERE account_id = ? AND status != 'deleted'
    84	     ORDER BY created_at DESC`
    85	  )
    86	    .bind(auth.accountId)
    87	    .all<{
    88	      id: string;
    89	      name: string;
    90	      key_hash: string;
    91	      created_at: string;
    92	      last_used_at: string | null;
    93	      use_count: number;
    94	      status: string;
    95	    }>();
    96	
    97	  const items = (keys.results ?? []).map((k) => ({
    98	    id: k.id,
    99	    name: k.name,
   100	    prefix: `wn_...${k.key_hash.slice(0, 6)}`,
   101	    created_at: k.created_at,
   102	    last_used_at: k.last_used_at,
   103	    use_count: k.use_count,
   104	    status: k.status,
   105	  }));
   106	
   107	  return Response.json({ keys: items });
   108	}
   109	
   110	export async function handleRevokeApiKey(
   111	  keyId: string,
   112	  env: Env,
   113	  auth: AuthIdentity | null
   114	): Promise<Response> {
   115	  if (!auth) {
   116	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
   117	  }
   118	
   119	  // Verify key belongs to this account
   120	  const key = await env.DB.prepare(
   121	    "SELECT id, status FROM api_keys WHERE id = ? AND account_id = ?"
   122	  )
   123	    .bind(keyId, auth.accountId)
   124	    .first<{ id: string; status: string }>();
   125	
   126	  if (!key) {
   127	    return apiError(ErrorCodes.ITEM_NOT_FOUND, "API key not found.");
   128	  }
   129	
   130	  if (key.status === "deleted") {
   131	    return Response.json({ ok: true, message: "API key is already deleted." });
   132	  }
   133	
   134	  if (key.status === "active") {
   135	    // Step 1: Revoke — deactivate but keep visible
   136	    await env.DB.prepare("UPDATE api_keys SET status = 'revoked' WHERE id = ?")
   137	      .bind(keyId)
   138	      .run();
   139	    // Cascade: revoke all MCP devices enrolled by this key
   140	    try {
   141	      await env.DB.prepare("UPDATE mcp_devices SET status = 'revoked' WHERE api_key_id = ? AND status = 'active'")
   142	        .bind(keyId)
   143	        .run();
   144	    } catch (err) {
   145	      console.error(`Failed to cascade-revoke devices for key ${keyId}:`, err);
   146	    }
   147	    return Response.json({ ok: true, message: "API key revoked." });
   148	  }
   149	
   150	  // Step 2: Delete — hide from dashboard (row stays in DB for tracking)
   151	  await env.DB.prepare("UPDATE api_keys SET status = 'deleted' WHERE id = ?")
   152	    .bind(keyId)
   153	    .run();
   154	  return Response.json({ ok: true, message: "API key deleted." });
   155	}
   156	
   157	const GRACE_PERIOD_MINUTES = 15;
   158	
   159	export async function handleRotateApiKey(
   160	  keyId: string,
   161	  env: Env,
   162	  auth: AuthIdentity | null
   163	): Promise<Response> {
   164	  if (!auth) {
   165	    return apiError(ErrorCodes.UNAUTHORIZED, "Authentication required.");
   166	  }
   167	
   168	  const key = await env.DB.prepare(
   169	    "SELECT id, key_hash, status FROM api_keys WHERE id = ? AND account_id = ?"
   170	  )
   171	    .bind(keyId, auth.accountId)
   172	    .first<{ id: string; key_hash: string; status: string }>();
   173	
   174	  if (!key) {
   175	    return apiError(ErrorCodes.ITEM_NOT_FOUND, "API key not found.");
   176	  }
   177	
   178	  if (key.status !== "active") {
   179	    return apiError(ErrorCodes.FORBIDDEN, "Only active keys can be rotated.");
   180	  }
   181	
   182	  // Generate new key
   183	  const { raw, prefix } = generateApiKey();
   184	  const newKeyHash = await hashApiKey(raw);
   185	  const graceExpiresAt = new Date(Date.now() + GRACE_PERIOD_MINUTES * 60_000).toISOString();
   186	
   187	  // Move current hash to previous, set new hash, start grace period
   188	  await env.DB.prepare(
   189	    `UPDATE api_keys
   190	     SET previous_key_hash = key_hash,
   191	         key_hash = ?,
   192	         grace_expires_at = ?
   193	     WHERE id = ?`
   194	  )
   195	    .bind(newKeyHash, graceExpiresAt, keyId)
   196	    .run();
   197	
   198	  return Response.json(
   199	    {
   200	      key: raw,
   201	      prefix,
   202	      message: `New key generated. Your previous key will continue working until ${new Date(graceExpiresAt).toLocaleTimeString()} (${GRACE_PERIOD_MINUTES} minutes).`,
   203	      grace_expires_at: graceExpiresAt,
   204	    },
   205	    { status: 200 }
   206	  );
   207	}
