   302	  if (contentLength > 1_048_576) {
   303	    return jsonRpcError(null, -32600, "Request too large. Maximum 1MB.");
   304	  }
   305	
   306	  let body: unknown;
   307	  try {
   308	    body = await request.json();
   309	  } catch {
   310	    return jsonRpcError(null, -32700, "Parse error: invalid JSON.");
   311	  }
