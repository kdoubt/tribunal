     1	import type { Env } from "../env.js";
     2	import type { AccountPlan, AccountRow, ApiKeyRow } from "@whipnode/protocol";
     3	import { hashApiKey } from "@whipnode/shared";
     4	
     5	export type AuthRejection = { type: "rejected"; reason: "device_revoked" | "key_revoked" | "account_inactive" | "device_expired" };
     6	
     7	export type AuthContext =
     8	  | { type: "session"; accountId: string; plan: AccountPlan; email: string }
     9	  | { type: "api_key"; accountId: string; keyId: string; scopes: string[]; plan: AccountPlan; email: string }
    10	  | { type: "mcp_device"; accountId: string; deviceId: string; keyId: string; scopes: string[]; plan: AccountPlan; email: string }
    11	  | AuthRejection
    12	  | null;
    13	
    14	/**
    15	 * An authenticated identity — AuthContext with rejection and anonymous cases
    16	 * removed. The router strips rejections (router.ts) before invoking non-MCP
    17	 * handlers, so those handlers receive `AuthIdentity | null` (null = anonymous).
    18	 */
    19	export type AuthIdentity = Exclude<AuthContext, AuthRejection | null>;
    20	
    21	/**
    22	 * Resolve authentication from request headers/cookies.
    23	 * Priority: Mcp-Session-Id → X-API-Key → wn_session cookie.
    24	 * Returns null for anonymous requests (does not reject them).
    25	 */
    26	export async function resolveAuth(
    27	  request: Request,
    28	  env: Env
    29	): Promise<AuthContext> {
    30	  // 1. Check Mcp-Session-Id header (MCP device sessions)
    31	  const mcpSessionId = request.headers.get("Mcp-Session-Id");
    32	  if (mcpSessionId) {
    33	    const device = await resolveMcpDevice(mcpSessionId, env);
    34	    if (device) {
    35	      if (device.type === "rejected") {
    36	        // Expired devices silently fall through to API key re-enrollment
    37	        if (device.reason !== "device_expired") {
    38	          return device; // Return rejection for revoked/inactive
    39	        }
    40	        // Fall through to API key for expired devices
    41	      } else {
    42	        return device;
    43	      }
    44	    }
    45	    // If device session unknown or expired, fall through to API key
    46	  }
    47	
    48	  // 2. Check X-API-Key header
    49	  const apiKey = request.headers.get("X-API-Key");
    50	  if (apiKey) {
    51	    return resolveApiKey(apiKey, env);
    52	  }
    53	
    54	  // 3. Check session cookie
    55	  const cookie = request.headers.get("Cookie");
    56	  if (cookie) {
    57	    const sessionToken = parseCookie(cookie, "wn_session");
    58	    if (sessionToken) {
    59	      return resolveSession(sessionToken, env);
    60	    }
    61	  }
    62	
    63	  return null;
    64	}
    65	
    66	// ── MCP Device Session ──────────────────────────────────────
    67	
    68	async function resolveMcpDevice(
    69	  raw: string,
    70	  env: Env
    71	): Promise<AuthContext> {
    72	  const tokenHash = await hashApiKey(raw);
    73	
    74	  const row = await env.DB.prepare(
    75	    `SELECT d.id AS device_id, d.account_id, d.api_key_id, d.status, d.expires_at,
    76	            k.scopes, k.status AS key_status,
    77	            a.plan, a.email, a.status AS account_status
    78	     FROM mcp_devices d
    79	     JOIN api_keys k ON k.id = d.api_key_id
    80	     JOIN accounts a ON a.id = d.account_id
    81	     WHERE d.session_token_hash = ?`
    82	  )
    83	    .bind(tokenHash)
    84	    .first<{
    85	      device_id: string;
    86	      account_id: string;
    87	      api_key_id: string;
    88	      status: string;
    89	      expires_at: string;
    90	      scopes: string;
    91	      key_status: string;
    92	      plan: string;
    93	      email: string;
    94	      account_status: string;
    95	    }>();
    96	
    97	  if (!row) return null;
    98	
    99	  // Return specific rejection reasons so MCP can give helpful messages
   100	  if (row.status === "revoked") {
   101	    return { type: "rejected", reason: "device_revoked" };
   102	  }
   103	  if (row.key_status !== "active") {
   104	    return { type: "rejected", reason: "key_revoked" };
   105	  }
   106	  if (row.account_status !== "active") {
   107	    return { type: "rejected", reason: "account_inactive" };
   108	  }
   109	  if (new Date(row.expires_at) < new Date()) {
   110	    return { type: "rejected", reason: "device_expired" };
   111	  }
   112	  if (row.status !== "active") return null;
   113	
   114	  // Update last_seen and extend session (sliding window — active devices never expire)
   115	  const newExpiry = new Date(Date.now() + 90 * 24 * 3600_000).toISOString();
   116	  env.DB.prepare("UPDATE mcp_devices SET last_seen_at = datetime('now'), expires_at = ? WHERE id = ?")
   117	    .bind(newExpiry, row.device_id)
   118	    .run()
   119	    .catch(() => {});
   120	
   121	  const scopes = JSON.parse(row.scopes) as string[];
   122	
   123	  return {
   124	    type: "mcp_device",
   125	    accountId: row.account_id,
   126	    deviceId: row.device_id,
   127	    keyId: row.api_key_id,
   128	    scopes,
   129	    plan: row.plan as AccountPlan,
   130	    email: row.email,
   131	  };
   132	}
   133	
   134	// ── API Key ─────────────────────────────────────────────────
   135	
   136	async function resolveApiKey(
   137	  raw: string,
   138	  env: Env
   139	): Promise<AuthContext> {
   140	  const keyHash = await hashApiKey(raw);
   141	
   142	  // Check current key_hash first
   143	  let row = await env.DB.prepare(
   144	    `SELECT k.id, k.account_id, k.scopes, k.status,
   145	            a.plan, a.email, a.status AS account_status
   146	     FROM api_keys k
   147	     JOIN accounts a ON a.id = k.account_id
   148	     WHERE k.key_hash = ?`
   149	  )
   150	    .bind(keyHash)
   151	    .first<{
   152	      id: string;
   153	      account_id: string;
   154	      scopes: string;
   155	      status: string;
   156	      plan: string;
   157	      email: string;
   158	      account_status: string;
   159	    }>();
   160	
   161	  // If not found, check previous_key_hash (rotated keys in grace period)
   162	  if (!row) {
   163	    row = await env.DB.prepare(
   164	      `SELECT k.id, k.account_id, k.scopes, k.status, k.grace_expires_at,
   165	              a.plan, a.email, a.status AS account_status
   166	       FROM api_keys k
   167	       JOIN accounts a ON a.id = k.account_id
   168	       WHERE k.previous_key_hash = ? AND k.grace_expires_at > datetime('now')`
   169	    )
   170	      .bind(keyHash)
   171	      .first<any>();
   172	  }
   173	
   174	  if (!row || row.status !== "active" || row.account_status !== "active") {
   175	    return null;
   176	  }
   177	
   178	  // Update last_used_at and use_count
   179	  env.DB.prepare("UPDATE api_keys SET last_used_at = datetime('now'), use_count = use_count + 1 WHERE id = ?")
   180	    .bind(row.id)

