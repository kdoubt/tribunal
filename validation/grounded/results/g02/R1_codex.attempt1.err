   337	      // Enforce device quota per API key (max 10) — atomic via conditional INSERT
   338	      const sessionToken = generateMcpSessionToken();
   339	      const tokenHash = await hashApiKey(sessionToken);
   340	      const deviceName = parseDeviceName(request.headers.get("User-Agent"));
   341	      const ip = request.headers.get("CF-Connecting-IP") ?? "";
   342	      const ua = request.headers.get("User-Agent") ?? "";
   343	      const now = isoNow();
   344	      const expiresAt = new Date(Date.now() + 90 * 24 * 3600_000).toISOString(); // 90 days
   345	      const deviceId = generateId();
   346	
   347	      // Atomic quota enforcement: INSERT only if count < 10
   348	      const insertResult = await env.DB.prepare(
   349	        `INSERT INTO mcp_devices (id, account_id, api_key_id, session_token_hash,
   350	         device_name, ip_hash, user_agent_hash, created_at, last_seen_at, expires_at, status)
   351	         SELECT ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active'
   352	         WHERE (SELECT COUNT(*) FROM mcp_devices WHERE api_key_id = ? AND status = 'active') < 10`
   353	      )
   354	        .bind(
   355	          deviceId,
   356	          auth.accountId,
   357	          auth.keyId,
   358	          tokenHash,
   359	          deviceName,
   360	          ip ? await hashIp(ip) : null,
   361	          ua ? await hashUserAgent(ua) : null,
   362	          now,
   363	          now,
   364	          expiresAt,
   365	          auth.keyId
   366	        )
   367	        .run();
   368	
   369	      if (!insertResult.meta.changes) {
   370	        log(env, {
   371	          level: "warn", code: LogCodes.MCP_DEVICE_QUOTA_HIT, source: "mcp",
   372	          message: "Device quota reached (10), skipping enrollment",
   373	          accountId: auth.accountId, apiKeyId: auth.keyId,
   374	        });
   375	        return response;
   376	      }
   377	
   378	      log(env, {
   379	        level: "info", code: LogCodes.MCP_DEVICE_ENROLLED, source: "mcp",
   380	        message: `Device enrolled: ${deviceName}`,
   381	        accountId: auth.accountId, apiKeyId: auth.keyId,
   382	        ip: request.headers.get("CF-Connecting-IP"),
   383	      });
