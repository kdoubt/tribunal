    32	export async function handleApiRequest(
    33	  request: Request,
    34	  env: Env,
    35	  ctx: ExecutionContext
    36	): Promise<Response> {
    37	  // CORS preflight
    38	  if (request.method === "OPTIONS") {
    39	    return handleCors(request, env.APP_BASE_URL);
    40	  }
    41	
    42	  const url = new URL(request.url);
    43	  const path = url.pathname;
    44	  const method = request.method;
    45	
    46	  // Resolve authentication (does not reject anonymous)
    47	  const rawAuth = await resolveAuth(request, env);
    48	
    49	  // MCP gets the full auth (including rejections for error messages).
    50	  // All other routes get null if auth was rejected — they should not
    51	  // see the rejected object since it lacks accountId/email/plan.
    52	  const auth = rawAuth?.type === "rejected" ? null : rawAuth;
    53	
    54	  let response: Response;
    55	
    56	  try {
    57	    // ── MCP endpoint ──────────────────────────────────────
    58	    if (method === "POST" && path === "/api/v1/mcp") {
    59	      response = await handleMcp(request, env, rawAuth);
    60	    }
    61	    // ── Health ──────────────────────────────────────────────
    62	    else if (method === "GET" && path === "/api/v1/health") {
    63	      response = handleHealth();
    64	    }
    65	    // ── Whip count (public) ──────────────────────────────
    66	    else if (method === "GET" && path === "/api/v1/whips") {
    67	      response = await handleGetWhipCount(env);
    68	    }
    69	    // ── Owner stats (protected by CF Access) ───────────────
    70	    else if (method === "GET" && path === "/api/v1/admin/logs") {
    71	      response = await handleGetLogs(request, env, auth);
    72	    }
    73	    else if (method === "GET" && path === "/api/v1/admin/report") {
    74	      response = await handleGetReport(request, env, auth);
    75	    }
    76	    else if (method === "GET" && (path === "/api/v1/owner/stats" || path === "/api/v1/admin/stats")) {
   143	    // Also serve at /preview/:id (user-friendly URL via Worker route)
