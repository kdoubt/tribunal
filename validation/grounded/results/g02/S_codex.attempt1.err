    21	/**
    22	 * Resolve authentication from request headers/cookies.
    23	 * Priority: Mcp-Session-Id → X-API-Key → wn_session cookie.
    24	 * Returns null for anonymous requests (does not reject them).
    25	 */
    26	export async function resolveAuth(
    27	  request: Request,
    28	  env: Env
    29	): Promise<AuthContext> {
    30	  // 1. Check Mcp-Session-Id header (MCP device sessions)
    31	  const mcpSessionId = request.headers.get("Mcp-Session-Id");
    32	  if (mcpSessionId) {
    33	    const device = await resolveMcpDevice(mcpSessionId, env);
    34	    if (device) {
    35	      if (device.type === "rejected") {
    36	        // Expired devices silently fall through to API key re-enrollment
    37	        if (device.reason !== "device_expired") {
    38	          return device; // Return rejection for revoked/inactive
    39	        }
    40	        // Fall through to API key for expired devices
    41	      } else {
    42	        return device;
    43	      }
    44	    }
    45	    // If device session unknown or expired, fall through to API key
    46	  }
    47	
    48	  // 2. Check X-API-Key header
    49	  const apiKey = request.headers.get("X-API-Key");
    50	  if (apiKey) {
    51	    return resolveApiKey(apiKey, env);
    52	  }
    53	
    54	  // 3. Check session cookie
    55	  const cookie = request.headers.get("Cookie");
    56	  if (cookie) {
    57	    const sessionToken = parseCookie(cookie, "wn_session");
    58	    if (sessionToken) {
    59	      return resolveSession(sessionToken, env);
    60	    }
    61	  }
    62	
    63	  return null;
    64	}
