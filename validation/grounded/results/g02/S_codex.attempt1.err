  1065	// ── whipnode_render ─────────────────────────────────────────
  1066	
  1067	async function toolRender(
  1068	  args: Record<string, unknown>,
  1069	  env: Env,
  1070	  auth: AuthIdentity
  1071	): Promise<{ content: Array<{ type: string; text: string }> }> {
  1072	  if (!args.item_id && !args.html) {
  1073	    return toolError("Error: either item_id or html is required.");
  1074	  }
  1075	
  1076	  const fakeRequest = new Request("https://internal/api/v1/render", {
  1077	    method: "POST",
  1078	    headers: { "Content-Type": "application/json" },
  1079	    body: JSON.stringify({
  1080	      item_id: args.item_id ? String(args.item_id) : undefined,
  1081	      html: args.html ? String(args.html) : undefined,
  1082	      viewports: Array.isArray(args.viewports) ? args.viewports.map(String) : undefined,
  1083	      full_page: args.full_page ?? false,
  1084	      note: args.note ? String(args.note) : undefined,
  1085	    }),
  1086	  });
  1087	
  1088	  const ctx = { waitUntil: () => {}, passThroughOnException: () => {} } as unknown as ExecutionContext;
  1089	
  1090	  try {
  1091	    const resp = await handleRender(fakeRequest, env, ctx, auth);
  1092	
  1093	    if (resp.status !== 201) {
  1094	      const errData = await resp.json().catch(() => null) as { error?: { message?: string } } | null;
  1095	      return toolError(errData?.error?.message ?? `Render failed: ${resp.status}`);
  1096	    }
  1097	
  1098	    const data = await resp.json() as {
  1099	      id: string;
  1100	      viewports: string[];
  1101	      screenshots: Array<{ viewport: string; bytes: number }>;
  1102	      url: string;
  1103	      prompt_url: string;
  1104	    };
  1105	
  1106	    const screenshotList = data.screenshots
  1107	      .map((s) => `  ${s.viewport}: ${(s.bytes / 1024).toFixed(0)} KB`)
  1108	      .join("\n");
  1109	
  1110	    return {
  1111	      content: [{
  1112	        type: "text",
  1113	        text: [
  1114	          `Responsive render complete (${data.viewports.length} viewports):`,
  1115	          screenshotList,
  1116	          "",
  1117	          `View: ${data.url}`,
  1118	          `Prompt pack: ${data.prompt_url}`,
  1119	          "",
  1120	          "Screenshots are being processed with OCR. Fetch the prompt pack URL in a few seconds.",
  1121	        ].join("\n"),
  1122	      }],
  1123	    };
  1124	  } catch (err) {
  1125	    console.error("MCP toolRender error:", err);
  1126	    return toolError("Failed to render page. It may have errors or timed out.");
  1127	  }
  1128	}
  1129	
  1130	// ── whipnode_list ───────────────────────────────────────────
  1131	
  1132	async function toolList(
  1133	  args: Record<string, unknown>,
  1134	  env: Env,
  1135	  auth: AuthIdentity
  1136	): Promise<{ content: Array<{ type: string; text: string }> }> {
  1137	  const limit = Math.min(Math.max(Number(args.limit) || 10, 1), 50);
  1138	
  1139	  // Build dynamic WHERE clause from filters
  1140	  const conditions = ["account_id = ?", "status != 'deleted'"];
  1141	  const binds: (string | number)[] = [auth.accountId];
  1142	
  1143	  // If this device is in a group, scope to items from devices in the same group
  1144	  if (auth.type === "mcp_device") {
  1145	    const thisDevice = await env.DB.prepare(
  1146	      "SELECT group_name FROM mcp_devices WHERE id = ?"
  1147	    ).bind(auth.deviceId).first<{ group_name: string | null }>();
  1148	
  1149	    if (thisDevice?.group_name) {
  1150	      conditions.push(
  1151	        "(device_id IN (SELECT id FROM mcp_devices WHERE account_id = ? AND group_name = ?) OR device_id IS NULL)"
  1152	      );
  1153	      binds.push(auth.accountId, thisDevice.group_name);
  1154	    }
  1155	  }
  1156	
  1157	  if (args.category && typeof args.category === "string") {
  1158	    conditions.push("category = ?");
  1159	    binds.push(args.category);
  1160	  }
  1161	  if (args.intent && typeof args.intent === "string") {
  1162	    conditions.push("intent = ?");
  1163	    binds.push(args.intent);
  1164	  }
  1165	  if (args.priority && typeof args.priority === "string") {
  1166	    conditions.push("priority = ?");
  1167	    binds.push(args.priority);
  1168	  }
  1169	  if (args.tag && typeof args.tag === "string") {
  1170	    conditions.push("tags LIKE ?");
  1171	    binds.push(`%"${args.tag}"%`);
  1172	  }
  1173	  if (args.since && typeof args.since === "string") {
  1174	    conditions.push("created_at > ?");
  1175	    binds.push(args.since);
  1176	  }
  1177	
  1178	  binds.push(limit);
  1179	
  1180	  const rows = await env.DB.prepare(
  1181	    `SELECT id, note, summary, status, created_at, expires_at, category, intent, priority, tags
  1182	     FROM items
  1183	     WHERE ${conditions.join(" AND ")}
  1184	     ORDER BY created_at DESC
  1185	     LIMIT ?`
  1186	  )
  1187	    .bind(...binds)
  1188	    .all<{
  1189	      id: string;
  1190	      note: string | null;
  1191	      summary: string | null;
  1192	      status: string;
  1193	      created_at: string;
  1194	      expires_at: string;
  1195	      category: string | null;
  1196	      intent: string | null;
  1197	      priority: string | null;
  1198	      tags: string | null;
  1199	    }>();
  1200	
  1201	  if (!rows.results?.length) {
  1202	    const filterDesc = args.category || args.intent || args.priority || args.tag
  1203	      ? " matching those filters"
  1204	      : "";
  1205	    return toolError(`No uploads found${filterDesc}.`);
  1206	  }
  1207	
  1208	  const lines = rows.results.map((r) => {
  1209	    const url = `${env.APP_BASE_URL}/p/${r.id}`;
  1210	    const label = r.summary || r.note || "(no description)";
  1211	    const classLine = r.category
  1212	      ? `${r.category}/${r.intent ?? "?"}/${r.priority ?? "normal"}`
  1213	      : "unclassified";
  1214	    const tagList = r.tags ? JSON.parse(r.tags) as string[] : [];
  1215	    const tagStr = tagList.length > 0 ? ` [${tagList.join(", ")}]` : "";
  1216	    return `${r.id} | ${r.status} | ${classLine}${tagStr} | ${r.created_at}\n  "${label}"\n  ${url}`;
  1217	  });
  1218	
  1219	  return {
  1220	    content: [{
  1221	      type: "text",
  1222	      text: `Uploads (${rows.results.length}):\n\n${lines.join("\n\n")}`,
  1223	    }],
  1224	  };
  1225	}

