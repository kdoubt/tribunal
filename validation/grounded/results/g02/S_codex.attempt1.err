    66	// ── MCP Device Session ──────────────────────────────────────
    67	
    68	async function resolveMcpDevice(
    69	  raw: string,
    70	  env: Env
    71	): Promise<AuthContext> {
    72	  const tokenHash = await hashApiKey(raw);
    73	
    74	  const row = await env.DB.prepare(
    75	    `SELECT d.id AS device_id, d.account_id, d.api_key_id, d.status, d.expires_at,
    76	            k.scopes, k.status AS key_status,
    77	            a.plan, a.email, a.status AS account_status
    78	     FROM mcp_devices d
    79	     JOIN api_keys k ON k.id = d.api_key_id
    80	     JOIN accounts a ON a.id = d.account_id
    81	     WHERE d.session_token_hash = ?`
    82	  )
    83	    .bind(tokenHash)
    84	    .first<{
    85	      device_id: string;
    86	      account_id: string;
    87	      api_key_id: string;
    88	      status: string;
    89	      expires_at: string;
    90	      scopes: string;
    91	      key_status: string;
    92	      plan: string;
    93	      email: string;
    94	      account_status: string;
    95	    }>();
    96	
    97	  if (!row) return null;
    98	
    99	  // Return specific rejection reasons so MCP can give helpful messages
   100	  if (row.status === "revoked") {
   101	    return { type: "rejected", reason: "device_revoked" };
   102	  }
   103	  if (row.key_status !== "active") {
   104	    return { type: "rejected", reason: "key_revoked" };
   105	  }
   106	  if (row.account_status !== "active") {
   107	    return { type: "rejected", reason: "account_inactive" };
   108	  }
   109	  if (new Date(row.expires_at) < new Date()) {
   110	    return { type: "rejected", reason: "device_expired" };
   111	  }
   112	  if (row.status !== "active") return null;
   113	
   114	  // Update last_seen and extend session (sliding window — active devices never expire)
   115	  const newExpiry = new Date(Date.now() + 90 * 24 * 3600_000).toISOString();
   116	  env.DB.prepare("UPDATE mcp_devices SET last_seen_at = datetime('now'), expires_at = ? WHERE id = ?")
   117	    .bind(newExpiry, row.device_id)
   118	    .run()
   119	    .catch(() => {});
   120	
   121	  const scopes = JSON.parse(row.scopes) as string[];
   122	
   123	  return {
   124	    type: "mcp_device",
   125	    accountId: row.account_id,
   126	    deviceId: row.device_id,
   127	    keyId: row.api_key_id,
   128	    scopes,
   129	    plan: row.plan as AccountPlan,
   130	    email: row.email,
   131	  };
   132	}
   133	
   134	// ── API Key ─────────────────────────────────────────────────
   135	
   136	async function resolveApiKey(
   137	  raw: string,
   138	  env: Env
   139	): Promise<AuthContext> {
   140	  const keyHash = await hashApiKey(raw);
   141	
   142	  // Check current key_hash first
   143	  let row = await env.DB.prepare(
   144	    `SELECT k.id, k.account_id, k.scopes, k.status,
   145	            a.plan, a.email, a.status AS account_status
   146	     FROM api_keys k
   147	     JOIN accounts a ON a.id = k.account_id
   148	     WHERE k.key_hash = ?`
   149	  )
   150	    .bind(keyHash)
   151	    .first<{
   152	      id: string;
   153	      account_id: string;
   154	      scopes: string;
   155	      status: string;
   156	      plan: string;
   157	      email: string;
   158	      account_status: string;
   159	    }>();
   160	
   161	  // If not found, check previous_key_hash (rotated keys in grace period)
   162	  if (!row) {
   163	    row = await env.DB.prepare(
   164	      `SELECT k.id, k.account_id, k.scopes, k.status, k.grace_expires_at,
   165	              a.plan, a.email, a.status AS account_status
   166	       FROM api_keys k
   167	       JOIN accounts a ON a.id = k.account_id
   168	       WHERE k.previous_key_hash = ? AND k.grace_expires_at > datetime('now')`
   169	    )
   170	      .bind(keyHash)
   171	      .first<any>();
   172	  }
   173	
   174	  if (!row || row.status !== "active" || row.account_status !== "active") {
   175	    return null;
   176	  }
   177	
   178	  // Update last_used_at and use_count
   179	  env.DB.prepare("UPDATE api_keys SET last_used_at = datetime('now'), use_count = use_count + 1 WHERE id = ?")
   180	    .bind(row.id)
   181	    .run()
   182	    .catch(() => {});
   183	
   184	  const scopes = JSON.parse(row.scopes) as string[];
   185	
   186	  return {
   187	    type: "api_key",
   188	    accountId: row.account_id,
   189	    keyId: row.id,
   190	    scopes,
   191	    plan: row.plan as AccountPlan,
   192	    email: row.email,
   193	  };
   194	}
   195	
   196	// ── Session Cookie ──────────────────────────────────────────
   197	
   198	async function resolveSession(
   199	  raw: string,
   200	  env: Env
   201	): Promise<AuthContext> {
   202	  const tokenHash = await hashApiKey(raw);
   203	
   204	  const row = await env.DB.prepare(
   205	    `SELECT s.id, s.account_id, s.expires_at,
   206	            a.plan, a.email, a.status AS account_status
   207	     FROM sessions s
   208	     JOIN accounts a ON a.id = s.account_id
   209	     WHERE s.token_hash = ?`
   210	  )
   211	    .bind(tokenHash)
   212	    .first<{
   213	      id: string;
   214	      account_id: string;
   215	      expires_at: string;
   216	      plan: string;
   217	      email: string;
   218	      account_status: string;
   219	    }>();
   220	
   221	  if (!row || row.account_status !== "active") {
   222	    return null;
   223	  }
   224	
   225	  if (new Date(row.expires_at) < new Date()) {
   226	    env.DB.prepare("DELETE FROM sessions WHERE id = ?")
   227	      .bind(row.id)
   228	      .run()
   229	      .catch(() => {});
   230	    return null;
   231	  }
   232	
   233	  env.DB.prepare("UPDATE sessions SET last_seen = datetime('now') WHERE id = ?")
   234	    .bind(row.id)
   235	    .run()
   236	    .catch(() => {});
   237	
   238	  return {
   239	    type: "session",
   240	    accountId: row.account_id,
   241	    plan: row.plan as AccountPlan,
   242	    email: row.email,
   243	  };
   244	}
   245	
   246	// ── Helpers ─────────────────────────────────────────────────
   247	
   248	function parseCookie(header: string, name: string): string | null {
   249	  for (const part of header.split(";")) {
   250	    const [key, ...rest] = part.trim().split("=");
   251	    if (key === name) return decodeURIComponent(rest.join("="));
   252	  }
   253	  return null;
   254	}
     1	# Abuse Prevention (WhipNode Cloud — Private)
     2	
     3	## Threat Model
     4	
     5	WhipNode is an anonymous upload service with public read URLs. Primary abuse vectors:
     6	
     7	1. **Storage abuse**: Using free tier as free CDN/hosting
     8	2. **Queue flooding**: Overwhelming async processing pipeline
     9	3. **Bandwidth abuse**: Hot-linking files for high-traffic distribution
    10	4. **Content abuse**: Uploading prohibited content
    11	5. **Enumeration**: Attempting to guess item IDs
    12	
    13	## Abuse Budget (enforced in code)
    14	
    15	| Limit | Value | Enforcement Point |
    16	|---|---|---|
    17	| Max free upload size | 25 MiB | items-create.ts |
    18	| Max downloads/item/hour | 200 | rate limiting middleware |
    19	| Max OCR runs/IP/day | 100 | queue consumer |
    20	| Max bandwidth/IP/hour | 500 MiB | rate limiting middleware |
    21	| Max uploads/IP/hour | 20 | items-create.ts |
    22	| Max concurrent processing/IP | 5 | items-create.ts |
    23	
    24	## Controls
    25	
    26	### IP-based rate limiting
    27	- Implemented at the Worker level using CF headers
    28	- Hashed IP stored for correlation, not raw IP
    29	
    30	### Content moderation
    31	- Zoho Catalyst moderation for images
    32	- Nudity-only blocking: faces, technical content, and all non-sexual imagery allowed
    33	- Abuse reporting endpoint for user reports
    34	
    35	### ID security
    36	- 12-character cryptographically random IDs
    37	- 32-character public tokens
    38	- Entropy sufficient to resist brute-force enumeration
    39	
    40	### Expiration
    41	- 24h default, enforced by scheduled cleanup every 15 minutes
    42	- Prevents accumulation of abandoned content
    43	
    44	## Monitoring
    45	
    46	- Track abuse_reports table for patterns
    47	- Monitor upload volume by IP hash
    48	- Monitor queue depth for flooding
    49	- Alert on moderation block rate spikes
    50	
    51	## Escalation
    52	
    53	1. Automated: rate limiting, moderation blocking
    54	2. Manual review: abuse_reports with status "open"
    55	3. IP ban: add to deny list (future implementation)

