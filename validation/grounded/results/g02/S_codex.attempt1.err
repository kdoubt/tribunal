     1	async function sha256Hex(input: string): Promise<string> {
     2	  const encoded = new TextEncoder().encode(input);
     3	  const buffer = await crypto.subtle.digest("SHA-256", encoded);
     4	  return Array.from(new Uint8Array(buffer))
     5	    .map((b) => b.toString(16).padStart(2, "0"))
     6	    .join("");
     7	}
     8	
     9	export async function sha256Bytes(data: ArrayBuffer): Promise<string> {
    10	  const buffer = await crypto.subtle.digest("SHA-256", data);
    11	  return Array.from(new Uint8Array(buffer))
    12	    .map((b) => b.toString(16).padStart(2, "0"))
    13	    .join("");
    14	}
    15	
    16	export async function hashApiKey(raw: string): Promise<string> {
    17	  return sha256Hex(raw);
    18	}
    19	
    20	export async function hashIp(ip: string): Promise<string> {
    21	  return sha256Hex(`ip:${ip}`);
    22	}
    23	
    24	export async function hashUserAgent(ua: string): Promise<string> {
    25	  return sha256Hex(`ua:${ua}`);
    26	}
    27	
    28	/**
    29	 * Timing-safe string comparison to prevent timing attacks on token validation.
    30	 * Compares in constant time regardless of where strings differ.
    31	 */
    32	export function timingSafeCompare(a: string, b: string): boolean {
    33	  if (a.length !== b.length) {
    34	    // Still do a comparison to avoid leaking length info via timing
    35	    b = a;
    36	  }
    37	  const encoder = new TextEncoder();
    38	  const bufA = encoder.encode(a);
    39	  const bufB = encoder.encode(b);
    40	  let result = a.length === b.length ? 0 : 1;
    41	  for (let i = 0; i < bufA.length; i++) {
    42	    result |= bufA[i] ^ bufB[i];
    43	  }
    44	  return result === 0;
    45	}
