   145	      const previewId = path.split("/")[2];
   146	      response = await handleServePreview(previewId, env);
   147	    }
   148	
   149	    // ── URL capture ────────────────────────────────────────
   150	    else if (method === "POST" && path === "/api/v1/captures") {
   151	      response = await handleCapture(request, env, ctx, auth);
   152	    }
   153	    // ── Responsive render ────────────────────────────────
   154	    else if (method === "POST" && path === "/api/v1/render") {
   155	      response = await handleRender(request, env, ctx, auth);
   156	    }
   157	    // ── Raw upload (streaming, for large files) ────────────
   158	    else if (method === "POST" && path === "/api/v1/uploads") {
   159	      response = await handleCreateUpload(request, env, auth);
   160	    }
