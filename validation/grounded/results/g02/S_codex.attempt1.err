    12	export async function handleQueueBatch(
    13	  batch: MessageBatch,
    14	  env: Env,
    15	  _ctx: ExecutionContext
    16	): Promise<void> {
    17	  for (const msg of batch.messages) {
    18	    try {
    19	      const payload = msg.body as ItemProcessingMessage;
    20	      await processItem(payload, env);
    21	      msg.ack();
    22	    } catch (err) {
    23	      const payload = msg.body as ItemProcessingMessage;
    24	      log(env, {
    25	        level: "error", code: LogCodes.QUEUE_PROCESS_ERROR, source: "queue",
    26	        message: `Queue processing failed: ${err instanceof Error ? err.message : err}`,
    27	        itemId: payload?.item_id,
    28	      });
    29	      msg.retry();
    30	    }
    31	  }
    32	}
