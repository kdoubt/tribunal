    64	function hasScope(auth: AuthIdentity, required: string): boolean {
    65	  if (auth.type === "session") return true;
    66	  if (auth.scopes.includes(required)) return true;
    67	  // write implies read
    68	  if (required === "read" && auth.scopes.includes("write")) return true;
    69	  return false;
    70	}
