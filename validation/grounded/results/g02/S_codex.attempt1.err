   272	// ── Entry point ─────────────────────────────────────────────
   273	
   274	export async function handleMcp(
   275	  request: Request,
   276	  env: Env,
   277	  auth: AuthContext
   278	): Promise<Response> {
   279	  // Check for specific rejection reasons from device auth
   280	  if (auth && auth.type === "rejected") {
   281	    const reason = auth.reason;
   282	    const messages: Record<string, string> = {
   283	      device_revoked: "This device has been revoked. Re-run the install command with your API key to reconnect: claude mcp add whipnode --transport http https://whipnode.com/api/v1/mcp --header \"X-API-Key: YOUR_KEY\"",
   284	      device_expired: "This device session expired (inactive for 90+ days). Re-run the install command to reconnect: claude mcp add whipnode --transport http https://whipnode.com/api/v1/mcp --header \"X-API-Key: YOUR_KEY\"",
   285	      key_revoked: "The API key used to register this device has been revoked. Create a new key at whipnode.com/dashboard#api-keys and re-run the install command.",
   286	      account_inactive: "Your WhipNode account has been deactivated. Contact <email>.",
   287	    };
   288	    return jsonRpcError(null, -32000, messages[reason] ?? "Authentication failed.");
   289	  }
   290	
   291	  if (!auth) {
   292	    return jsonRpcError(null, -32000, "Authentication required. Pass your API key in the X-API-Key header.");
   293	  }
   294	
   295	  // Fix 4: per-account rate limiting
   296	  if (!checkMcpRateLimit(auth.accountId)) {
   297	    return jsonRpcError(null, -32000, "Rate limit exceeded. Maximum 60 MCP requests per minute.");
   298	  }
   299	
   300	  // Reject oversized payloads before parsing
   301	  const contentLength = parseInt(request.headers.get("Content-Length") ?? "0", 10);
   302	  if (contentLength > 1_048_576) {
   303	    return jsonRpcError(null, -32600, "Request too large. Maximum 1MB.");
   304	  }
   305	
   306	  let body: unknown;
   307	  try {
   308	    body = await request.json();
   309	  } catch {
   310	    return jsonRpcError(null, -32700, "Parse error: invalid JSON.");
   311	  }
   312	
   313	  // Fix 2: batch size limit
   314	  let response: Response;
   315	  if (Array.isArray(body)) {
   316	    if (body.length > MAX_BATCH_SIZE) {
   317	      return jsonRpcError(null, -32600, `Batch too large. Maximum ${MAX_BATCH_SIZE} requests per batch.`);
   318	    }
   319	    const results = await Promise.all(
   320	      body.map((req: unknown) => handleSingleRequest(req, env, auth))
   321	    );
   322	    const responses = results.filter((r): r is JsonRpcResponse => r !== null);
   323	    response = responses.length === 0
   324	      ? new Response(null, { status: 202 })
   325	      : Response.json(responses);
   326	  } else {
   327	    const result = await handleSingleRequest(body, env, auth);
   328	    response = result === null
   329	      ? new Response(null, { status: 202 })
   330	      : Response.json(result);
   331	  }
   332	
   333	  // Device enrollment: if authenticated via API key (not yet a device session)
   334	  // and this is an initialize request, create a device and assign Mcp-Session-Id
   335	  if (auth.type === "api_key" && isInitializeRequest(body)) {
   336	    try {
   337	      // Enforce device quota per API key (max 10) — atomic via conditional INSERT
   338	      const sessionToken = generateMcpSessionToken();
   339	      const tokenHash = await hashApiKey(sessionToken);
   340	      const deviceName = parseDeviceName(request.headers.get("User-Agent"));
   341	      const ip = request.headers.get("CF-Connecting-IP") ?? "";
   342	      const ua = request.headers.get("User-Agent") ?? "";
   343	      const now = isoNow();
   344	      const expiresAt = new Date(Date.now() + 90 * 24 * 3600_000).toISOString(); // 90 days
   345	      const deviceId = generateId();
   346	
   347	      // Atomic quota enforcement: INSERT only if count < 10
   348	      const insertResult = await env.DB.prepare(
   349	        `INSERT INTO mcp_devices (id, account_id, api_key_id, session_token_hash,
   350	         device_name, ip_hash, user_agent_hash, created_at, last_seen_at, expires_at, status)
   351	         SELECT ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'active'
   352	         WHERE (SELECT COUNT(*) FROM mcp_devices WHERE api_key_id = ? AND status = 'active') < 10`
   353	      )
   354	        .bind(
   355	          deviceId,
   356	          auth.accountId,
   357	          auth.keyId,
   358	          tokenHash,
   359	          deviceName,
   360	          ip ? await hashIp(ip) : null,
   361	          ua ? await hashUserAgent(ua) : null,
   362	          now,
   363	          now,
   364	          expiresAt,
   365	          auth.keyId
   366	        )
   367	        .run();
   368	
   369	      if (!insertResult.meta.changes) {
   370	        log(env, {
   371	          level: "warn", code: LogCodes.MCP_DEVICE_QUOTA_HIT, source: "mcp",
   372	          message: "Device quota reached (10), skipping enrollment",
   373	          accountId: auth.accountId, apiKeyId: auth.keyId,
   374	        });
   375	        return response;
   376	      }
   377	
   378	      log(env, {
   379	        level: "info", code: LogCodes.MCP_DEVICE_ENROLLED, source: "mcp",
   380	        message: `Device enrolled: ${deviceName}`,
   381	        accountId: auth.accountId, apiKeyId: auth.keyId,
   382	        ip: request.headers.get("CF-Connecting-IP"),
   383	      });
   384	
   385	      const headers = new Headers(response.headers);
   386	      headers.set("Mcp-Session-Id", sessionToken);
   387	      return new Response(response.body, { status: response.status, headers });
   388	    } catch (err) {
   389	      log(env, {
   390	        level: "error", code: LogCodes.SYSTEM_ERROR, source: "mcp",
   391	        message: `Device enrollment failed: ${err instanceof Error ? err.message : err}`,
   392	        accountId: auth.accountId,
   393	      });
   394	      // Don't fail the request — return the response without the session
   395	    }
   396	  }
   397	
   398	  return response;
   399	}
   400	
   401	// ── Device enrollment helpers ───────────────────────────────
   402	
   403	function isInitializeRequest(body: unknown): boolean {
   404	  if (Array.isArray(body)) {
   405	    return body.some((r: any) => r?.method === "initialize");
   406	  }
   407	  return (body as any)?.method === "initialize";
   408	}
   409	
   410	function parseDeviceName(ua: string | null): string {
   411	  if (!ua) return "MCP Client";
   412	  const lower = ua.toLowerCase();
   413	  let client = "MCP Client";
   414	  if (lower.includes("claude")) client = "Claude Code";
   415	  else if (lower.includes("cursor")) client = "Cursor";
   416	  else if (lower.includes("codex")) client = "Codex CLI";
   417	  else if (lower.includes("continue")) client = "Continue";
   418	
   419	  let os = "";
   420	  if (lower.includes("mac") || lower.includes("darwin")) os = "macOS";
   421	  else if (lower.includes("windows") || lower.includes("win")) os = "Windows";
   422	  else if (lower.includes("linux")) os = "Linux";
   423	
   424	  return os ? `${client} on ${os}` : client;
   425	}
   426	
   427	// ── Request dispatcher ──────────────────────────────────────
   428	
   429	async function handleSingleRequest(
   430	  rawReq: unknown,
   431	  env: Env,
   432	  auth: AuthIdentity | null
   433	): Promise<JsonRpcResponse | null> {
   434	  // Fix 6: JSON-RPC field validation
   435	  if (typeof rawReq !== "object" || rawReq === null || Array.isArray(rawReq)) {
   436	    return rpcError(null, -32600, "Invalid request: not an object.");
   437	  }
   438	
   439	  const req = rawReq as Record<string, unknown>;
   440	
   441	  if (req.jsonrpc !== "2.0") {
   442	    return rpcError(null, -32600, 'Invalid request: jsonrpc must be "2.0".');
   443	  }
   444	  if (typeof req.method !== "string") {
   445	    return rpcError(null, -32600, "Invalid request: method must be a string.");
   446	  }
   447	  if (req.id !== undefined && typeof req.id !== "string" && typeof req.id !== "number") {
   448	    return rpcError(null, -32600, "Invalid request: id must be a string or number.");
   449	  }
   450	  if (req.params !== undefined && (typeof req.params !== "object" || req.params === null || Array.isArray(req.params))) {
   451	    return rpcError(null, -32600, "Invalid request: params must be an object.");
   452	  }
   453	
   454	  const id = (req.id as string | number | undefined) ?? null;
   455	  const method = req.method as string;
   456	  const params = req.params as Record<string, unknown> | undefined;
   457	
   458	  // Notifications (no id) don't get responses
   459	  if (id === null && method !== "initialize") return null;
   460	
   461	  switch (method) {
   462	    case "initialize":
   463	      return {
   464	        jsonrpc: "2.0",
   465	        id: id!,
   466	        result: {
   467	          protocolVersion: "2025-03-26",
   468	          capabilities: SERVER_CAPABILITIES,
   469	          serverInfo: SERVER_INFO,
   470	          instructions: "WhipNode gives you tools to work with visual context. When the user shares a whipnode.com URL, use whipnode_fetch to read it. When you need to see a website, use whipnode_capture. When checking responsive design, use whipnode_render. Use whipnode_help to show the user what's available.",
   471	        },
   472	      };
   473	
   474	    case "notifications/initialized":
   475	      return null;
   476	
   477	    case "tools/list":
   478	      return { jsonrpc: "2.0", id: id!, result: { tools: TOOLS } };
   479	
   480	    case "tools/call":
   481	      return handleToolCall(id!, params as { name: string; arguments?: Record<string, unknown> }, env, auth);
   482	
   483	    case "ping":
   484	      return { jsonrpc: "2.0", id: id!, result: {} };
   485	
   486	    default:
   487	      return rpcError(id, -32601, `Method not found: ${method}`);
   488	  }
   489	}
   490	
   491	// ── Tool execution ──────────────────────────────────────────
   492	
   493	async function handleToolCall(
   494	  id: string | number,
   495	  params: { name: string; arguments?: Record<string, unknown> },
   496	  env: Env,
   497	  auth: AuthIdentity | null
   498	): Promise<JsonRpcResponse> {
   499	  // Fix 10: runtime auth guard (defense-in-depth)
   500	  if (!auth) {
   501	    return rpcError(id, -32000, "Authentication required.");
   502	  }
   503	
   504	  if (!params || typeof params.name !== "string") {
   505	    return rpcError(id, -32602, "Invalid params: name is required.");
   506	  }
   507	
   508	  const toolName = params.name;
   509	  const args = params.arguments ?? {};
   510	  const accountId = auth.accountId;
   511	  const keyRef = auth.type === "api_key" ? auth.keyId : auth.type === "mcp_device" ? auth.deviceId : "session";
   512	
   513	  // Log every tool call with sanitized args for usage analytics
   514	  log(env, {
   515	    level: "info", code: LogCodes.MCP_TOOL_CALL, source: "mcp",
   516	    message: `${toolName}`,
   517	    accountId,
   518	    apiKeyId: auth.type === "api_key" ? auth.keyId : auth.type === "mcp_device" ? auth.keyId : undefined,
   519	    deviceId: auth.type === "mcp_device" ? auth.deviceId : undefined,
   520	    metadata: {
   521	      tool: toolName,
   522	      // Log arg keys (not values) to see what params users pass without leaking content
   523	      arg_keys: Object.keys(args),
   524	    },
   525	  });
   526	
   527	  switch (toolName) {
   528	    case "whipnode_fetch": {
   529	      if (!hasScope(auth, "read")) {
   530	        return rpcError(id, -32600, "Insufficient scope. 'read' or 'write' scope required.");
   531	      }
   532	      return { jsonrpc: "2.0", id, result: await toolFetch(args, env) };
   533	    }
   534	
   535	    case "whipnode_upload": {
   536	      if (!hasScope(auth, "write")) {
   537	        return rpcError(id, -32600, "Insufficient scope. 'write' scope required.");
   538	      }
   539	      return { jsonrpc: "2.0", id, result: await toolUpload(args, env, auth) };
   540	    }
   541	
   542	    case "whipnode_help": {
   543	      return { jsonrpc: "2.0", id, result: toolHelp() };
   544	    }
   545	
   546	    case "whipnode_status": {
   547	      return { jsonrpc: "2.0", id, result: await toolStatus(args, env, auth) };
   548	    }
   549	
   550	    case "whipnode_capture": {
   551	      if (!hasScope(auth, "write")) {
   552	        return rpcError(id, -32600, "Insufficient scope. 'write' scope required.");
   553	      }
   554	      return { jsonrpc: "2.0", id, result: await toolCapture(args, env, auth) };
   555	    }
   556	
   557	    case "whipnode_render": {
   558	      if (!hasScope(auth, "write")) {
   559	        return rpcError(id, -32600, "Insufficient scope. 'write' scope required.");
   560	      }
   561	      return { jsonrpc: "2.0", id, result: await toolRender(args, env, auth) };
   562	    }
   563	
   564	    case "whipnode_list": {
   565	      if (!hasScope(auth, "read")) {
   566	        return rpcError(id, -32600, "Insufficient scope. 'read' or 'write' scope required.");
   567	      }
   568	      return { jsonrpc: "2.0", id, result: await toolList(args, env, auth) };
   569	    }
   570	
   571	    default:
   572	      // Log unknown tool requests — these are feature signals
   573	      log(env, {
   574	        level: "warn", code: LogCodes.MCP_UNKNOWN_TOOL, source: "mcp",
   575	        message: `Unknown tool requested: ${toolName}`,
   576	        accountId,
   577	        metadata: { tool: toolName, arg_keys: Object.keys(args) },
   578	      });
   579	      return rpcError(id, -32602, `Unknown tool: ${toolName}`);
   580	  }
   581	}
   582	
   583	// ── whipnode_help ────────────────────────────────────────────
   584	
   585	function toolHelp(): { content: Array<{ type: string; text: string }> } {
   586	  return {
   587	    content: [{
   588	      type: "text",
   589	      text: [
   590	        "WhipNode — Context relay for AI agents",
   591	        "",
   592	        "Available tools:",
   593	        "",
   594	        "  whipnode_fetch    Read a WhipNode item (paste a whipnode.com URL)",
   595	        "  whipnode_upload   Upload a file and get a shareable URL",
   596	        "  whipnode_capture  Screenshot a live website (single or multi-viewport)",
   597	        "                    Also auto-exports Google Sheets as CSV",
   598	        "                    Extracts sitemap of page navigation links",
   599	        "  whipnode_render   Render HTML at multiple device sizes (responsive check)",
   600	        "  whipnode_list     List your recent uploads",
   601	        "  whipnode_help     Show this help message",
   602	        "",
   603	        "Common workflows:",
   604	        "",
   605	        "  User shares a screenshot  → they upload at whipnode.com, paste the URL here",
   606	        "  You need to see a website → use whipnode_capture with the URL",
   607	        "  Responsive design check   → use whipnode_capture with viewports: ['desktop','tablet','mobile']",
   608	        "  Google Sheets data        → use whipnode_capture with the sheet URL (auto CSV export)",
   609	        "  Check HTML at all sizes   → use whipnode_render with HTML or a preview ID",
   610	        "  Share a file with user    → use whipnode_upload to create a shareable link",
   611	        "",
   612	        "Dashboard: whipnode.com/dashboard",
   613	        "Docs: whipnode.com/docs",
   614	      ].join("\n"),
   615	    }],
   616	  };
   617	}
   618	
   619	// ── whipnode_status ──────────────────────────────────────────
   620	
   621	async function toolStatus(
   622	  args: Record<string, unknown>,
   623	  env: Env,
   624	  auth: AuthIdentity
   625	): Promise<{ content: Array<{ type: string; text: string }> }> {
   626	  // Get account info
   627	  const account = await env.DB.prepare(
   628	    "SELECT email, plan FROM accounts WHERE id = ?"
   629	  ).bind(auth.accountId).first<{ email: string; plan: string }>();
   630	
   631	  // Get all active devices
   632	  const devices = await env.DB.prepare(
   633	    `SELECT d.id, d.device_name, d.group_name, d.last_seen_at, d.created_at, d.status, k.name as key_name
   634	     FROM mcp_devices d
   635	     JOIN api_keys k ON k.id = d.api_key_id
   636	     WHERE d.account_id = ? AND d.status = 'active'
   637	     ORDER BY d.last_seen_at DESC`
   638	  ).bind(auth.accountId).all<{
   639	    id: string;
   640	    device_name: string;
   641	    group_name: string | null;
   642	    last_seen_at: string;
   643	    created_at: string;
   644	    status: string;
   645	    key_name: string;
   646	  }>();
   647	
   648	  // Get recent upload count
   649	  const uploadCount = await env.DB.prepare(
   650	    "SELECT COUNT(*) as cnt FROM items WHERE account_id = ? AND created_at > datetime('now', '-24 hours') AND status != 'deleted'"
   651	  ).bind(auth.accountId).first<{ cnt: number }>();
   652	
   653	  const currentDeviceId = auth.type === "mcp_device" ? auth.deviceId : null;
   654	
   655	  // ── Apply a previously confirmed configuration ──
   656	  if (args.apply_config && typeof args.apply_config === "string") {
   657	    return applyDeviceConfig(args.apply_config, devices.results ?? [], auth.accountId, env);
   658	  }
   659	
   660	  // ── Propose a new configuration (does NOT apply — requires user confirmation) ──
   661	  if (args.configure && typeof args.configure === "string") {
   662	    return proposeDeviceConfig(
   663	      args.configure,
   664	      devices.results ?? [],
   665	      currentDeviceId,
   666	      env
   667	    );
   668	  }
   669	
   670	  // ── Build status output ──
   671	  const lines: string[] = [];
   672	  lines.push(`WhipNode Status`);
   673	  lines.push(`Account: ${account?.email ?? "unknown"} (${account?.plan ?? "free"} plan)`);
   674	  lines.push(`Uploads today: ${uploadCount?.cnt ?? 0}`);
   675	  lines.push("");
   676	
   677	  // Group devices
   678	  const grouped = new Map<string, typeof devices.results>();
   679	  for (const d of devices.results ?? []) {
   680	    const group = d.group_name ?? "(ungrouped)";
   681	    if (!grouped.has(group)) grouped.set(group, []);
   682	    grouped.get(group)!.push(d);
   683	  }
   684	
   685	  lines.push(`Active devices (${devices.results?.length ?? 0}):`);
   686	  lines.push("");
   687	
   688	  for (const [group, devs] of grouped) {
   689	    if (grouped.size > 1 || group !== "(ungrouped)") {
   690	      lines.push(`  Group: ${group}`);
   691	    }
   692	    for (const d of devs) {
   693	      const isThis = d.id === currentDeviceId;
   694	      const marker = isThis ? " ← this device" : "";
   695	      const ago = timeAgo(d.last_seen_at);
   696	      lines.push(`  ${isThis ? "●" : "○"} ${d.device_name} (key: ${d.key_name}) — ${ago}${marker}`);
   697	    }
   698	    lines.push("");
   699	  }
   700	
   701	  lines.push("Visibility: devices in the same group share uploads via whipnode_list.");
   702	  lines.push("Ungrouped devices see all uploads on the account.");
   703	  lines.push("");
   704	  lines.push("To configure groups, call whipnode_status with a configure message.");
   705	  lines.push("Example: \"Put my laptop and CI server in the same group called 'dev'\"");
   706	
   707	  return {
   708	    content: [{ type: "text", text: lines.join("\n") }],
   709	  };
   710	}
   711	
   712	/**
   713	 * Step 1: Parse natural language → propose group assignments (does NOT apply).
   714	 * Returns a human-readable proposal + a JSON config string for step 2.
   715	 */
   716	async function proposeDeviceConfig(
   717	  instruction: string,
   718	  devices: Array<{ id: string; device_name: string; group_name: string | null }>,
   719	  currentDeviceId: string | null,
   720	  env: Env
   721	): Promise<{ content: Array<{ type: string; text: string }> }> {
   722	  if (devices.length === 0) {
   723	    return { content: [{ type: "text", text: "No active devices to configure." }] };
   724	  }
   725	
   726	  const deviceList = devices.map((d) => ({
   727	    id: d.id,
   728	    name: d.device_name,
   729	    current_group: d.group_name ?? null,
   730	    is_current: d.id === currentDeviceId,
   731	  }));
   732	
   733	  const raw = await groqComplete(env, [
   734	    {
   735	      role: "system",
   736	      content: `You manage device groups for a context-sharing tool. Users describe in natural language how their devices should be grouped. Devices in the same group share uploads with each other.
   737	
   738	Given the user's instruction and the list of active devices, return a JSON array of group assignments:
   739	[{"device_id": "...", "device_name": "...", "group_name": "..."}]
   740	
   741	Rules:
   742	- group_name should be a short lowercase label (e.g. "dev", "personal", "ci", "team")
   743	- If the user says "all devices" or "same group", put them all in one group
   744	- If a device isn't mentioned, keep its current group (or null if ungrouped)
   745	- If the user says "separate" or "keep apart", set group_name to a unique group for that device
   746	- null means ungrouped (sees everything)
   747	- Always include device_name for readability
   748	
   749	Respond with ONLY the JSON array. No explanation.`,
   750	    },
   751	    {
   752	      role: "user",
   753	      content: `Devices:\n${JSON.stringify(deviceList, null, 2)}\n\nInstruction: ${instruction}`,
   754	    },
   755	  ], { maxTokens: 300, temperature: 0.1 });
   756	
   757	  if (!raw) {
   758	    return { content: [{ type: "text", text: "Failed to parse your instruction. Try being more specific, e.g.: \"Put my laptop and CI server in a group called dev\"" }] };
   759	  }
   760	
   761	  try {
   762	    const cleaned = raw.replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/i, "").trim();
   763	    const assignments = JSON.parse(cleaned) as Array<{ device_id: string; device_name?: string; group_name: string | null }>;
   764	
   765	    const validIds = new Set(devices.map((d) => d.id));
   766	    // Validate device IDs and sanitize group names
   767	    const GROUP_RE = /^[a-z0-9][a-z0-9-]{0,31}$/;
   768	    const valid = assignments
   769	      .filter((a) => validIds.has(a.device_id))
   770	      .map((a) => ({
   771	        ...a,
   772	        group_name: a.group_name
   773	          ? a.group_name.toLowerCase().replace(/[^a-z0-9-]/g, "-").slice(0, 32)
   774	          : null,
   775	      }));
   776	
   777	    // Reject invalid group names
   778	    for (const a of valid) {
   779	      if (a.group_name && !GROUP_RE.test(a.group_name)) {
   780	        return { content: [{ type: "text", text: `Invalid group name "${a.group_name}". Use lowercase letters, numbers, and hyphens (max 32 chars).` }] };
   781	      }
   782	    }
   783	
   784	    if (valid.length === 0) {
   785	      return { content: [{ type: "text", text: "No valid device assignments found. Try referencing devices by name." }] };
   786	    }
   787	
   788	    // Build a human-readable proposal
   789	    const lines: string[] = [];
   790	    lines.push("PROPOSED device group changes:");
   791	    lines.push("");
   792	    for (const a of valid) {
   793	      const device = devices.find((d) => d.id === a.device_id);
   794	      const name = device?.device_name ?? a.device_name ?? a.device_id;
   795	      const oldGroup = device?.group_name ?? "(ungrouped)";
   796	      const newGroup = a.group_name ?? "(ungrouped)";
   797	      const changed = oldGroup !== newGroup;
   798	      lines.push(`  ${name}: ${oldGroup} → ${newGroup}${changed ? "" : " (no change)"}`);
   799	    }
   800	    lines.push("");
   801	    lines.push("Effect: devices in the same group see only each other's uploads.");
   802	    lines.push("Ungrouped devices see all uploads on the account.");
   803	    lines.push("");
   804	    lines.push("Show this to the user and ask them to confirm.");
   805	    lines.push("If confirmed, call whipnode_status with apply_config set to:");
   806	    lines.push(JSON.stringify(valid.map((a) => ({ device_id: a.device_id, group_name: a.group_name }))));
   807	
   808	    return { content: [{ type: "text", text: lines.join("\n") }] };
   809	  } catch {
   810	    return { content: [{ type: "text", text: "Failed to parse configuration. Try something like: \"Put my laptop and CI server in a group called dev\"" }] };
   811	  }
   812	}
   813	
   814	/**
   815	 * Step 2: Apply a confirmed configuration. Only called after user confirms.
   816	 */
   817	async function applyDeviceConfig(
   818	  configJson: string,
   819	  devices: Array<{ id: string; device_name: string; group_name: string | null }>,
   820	  accountId: string,
   821	  env: Env
   822	): Promise<{ content: Array<{ type: string; text: string }> }> {
   823	  try {
   824	    const assignments = JSON.parse(configJson) as Array<{ device_id: string; group_name: string | null }>;
   825	    const validIds = new Set(devices.map((d) => d.id));
   826	    const valid = assignments.filter((a) => validIds.has(a.device_id));
   827	
   828	    if (valid.length === 0) {
   829	      return { content: [{ type: "text", text: "No valid assignments to apply." }] };
   830	    }
   831	
   832	    for (const a of valid) {
   833	      await env.DB.prepare(
   834	        "UPDATE mcp_devices SET group_name = ? WHERE id = ? AND account_id = ?"
   835	      ).bind(a.group_name, a.device_id, accountId).run();
   836	    }
   837	
   838	    // Audit log
   839	    log(env, {
   840	      level: "info",
   841	      code: LogCodes.MCP_DEVICE_ENROLLED, // Reusing closest code — device config change
   842	      source: "mcp",
   843	      message: `Device groups configured: ${valid.map((a) => `${a.device_id}→${a.group_name ?? "ungrouped"}`).join(", ")}`,
   844	      accountId,
   845	    });
   846	
   847	    const lines: string[] = ["Device groups updated:"];
   848	    for (const a of valid) {
   849	      const device = devices.find((d) => d.id === a.device_id);
   850	      const groupLabel = a.group_name ?? "(ungrouped)";
   851	      lines.push(`  ${device?.device_name ?? a.device_id} → ${groupLabel}`);
   852	    }
   853	    lines.push("");
   854	    lines.push("Changes are active immediately.");
   855	
   856	    return { content: [{ type: "text", text: lines.join("\n") }] };
   857	  } catch {
   858	    return { content: [{ type: "text", text: "Invalid configuration format. Run configure again with your instructions." }] };
   859	  }
   860	}
   861	
   862	function timeAgo(iso: string): string {
   863	  const seconds = Math.floor((Date.now() - new Date(iso).getTime()) / 1000);
   864	  if (seconds < 60) return "just now";
   865	  const minutes = Math.floor(seconds / 60);
   866	  if (minutes < 60) return `${minutes}m ago`;
   867	  const hours = Math.floor(minutes / 60);
   868	  if (hours < 24) return `${hours}h ago`;
   869	  const days = Math.floor(hours / 24);
   870	  return `${days}d ago`;
   871	}
   872	
   873	// ── whipnode_fetch ───────────────────────────────────────────
   874	
   875	async function toolFetch(
   876	  args: Record<string, unknown>,
   877	  env: Env
   878	): Promise<{ content: Array<{ type: string; text: string }> }> {
   879	  const rawUrl = String(args.url ?? "");
   880	  const format = String(args.format ?? "prompt.md");
   881	
   882	  // Fix 1: validate format against enum
   883	  if (!VALID_FORMATS.has(format)) {
   884	    return toolError("Invalid format. Must be one of: json, md, yaml, txt, prompt.md");
   885	  }
   886	
   887	  // Extract item ID from URL or raw ID
   888	  let itemId = rawUrl;
   889	  const urlMatch = rawUrl.match(/(?:whipnode\.com\/p\/)([a-zA-Z0-9_-]+)/);
   890	  if (urlMatch) itemId = urlMatch[1];
   891	  itemId = itemId.replace(/^\//, "");
   892	
   893	  if (!itemId) {
   894	    return toolError("Error: No item URL or ID provided.");
   895	  }
   896	
   897	  // Fix 1: validate itemId — prevent path traversal and SSRF
   898	  if (!ITEM_ID_RE.test(itemId)) {
   899	    return toolError("Invalid item ID. Only alphanumeric characters, hyphens, and underscores are allowed.");
   900	  }
   901	
   902	  // Access model: items are intentionally public-by-URL. Anyone with the item ID
   903	  // can read the content — this is by design, not an oversight. The URL is the
   904	  // capability. No per-account ownership check is needed here.
   905	  //
   906	  // Call handlers directly instead of self-fetching via HTTP — Workers fetching
   907	  // their own origin can fail due to recursive routing issues on Cloudflare.
   908	  try {
   909	    const resp = format === "json"
   910	      ? await handleGetItem(itemId, env)
   911	      : await handleGetItemFormat(itemId, format, env);
   912	
   913	    if (!resp.ok) {
   914	      return toolError(`Error fetching item: ${resp.status} ${resp.statusText}`);
   915	    }
   916	    const text = await resp.text();
   917	    return { content: [{ type: "text", text }] };
   918	  } catch (err) {
   919	    // Fix 7: sanitize error — log internally, return generic message
   920	    console.error("MCP toolFetch error:", err);
   921	    return toolError("Error fetching item. Please check the item ID and try again.");
   922	  }
   923	}
   924	
   925	// ── whipnode_upload ─────────────────────────────────────────
   926	
   927	async function toolUpload(
   928	  args: Record<string, unknown>,
   929	  env: Env,
   930	  auth: AuthIdentity
   931	): Promise<{ content: Array<{ type: string; text: string }> }> {
   932	  const filename = String(args.filename ?? "");
   933	  const contentBase64 = String(args.content_base64 ?? "");
   934	  const mimeType = String(args.mime_type ?? "application/octet-stream");
   935	  const note = args.note ? String(args.note).slice(0, 4000) : undefined;
   936	
   937	  if (!filename || !contentBase64) {
   938	    return toolError("Error: filename and content_base64 are required. Read the file, base64-encode it, then call this tool.");
   939	  }
   940	
   941	  // Build a CreateItemRequest and call the items endpoint
   942	  const reqBody = {
   943	    files: [{ name: filename, mime_type: mimeType, content_base64: contentBase64 }],
   944	    note,
   945	    source: { client_type: "agent" as const, origin: "mcp" as const },
   946	  };
   947	
   948	  const fakeRequest = new Request("https://internal/api/v1/items", {
   949	    method: "POST",
   950	    headers: { "Content-Type": "application/json" },
   951	    body: JSON.stringify(reqBody),
   952	  });
