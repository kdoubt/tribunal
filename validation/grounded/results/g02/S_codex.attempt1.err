     5	
     6	export async function handleMagicLinkRequest(
     7	  request: Request,
     8	  env: Env,
     9	  ctx: ExecutionContext
    10	): Promise<Response> {
    11	  let body: { email?: string };
    12	  try {
    13	    body = await request.json() as { email?: string };
    14	  } catch {
    15	    return apiError(ErrorCodes.VALIDATION_ERROR, "Invalid JSON body.");
    16	  }
    17	
    18	  const email = body.email?.trim().toLowerCase();
    19	  if (!email || !email.includes("@") || email.length > 320) {
    20	    return apiError(ErrorCodes.VALIDATION_ERROR, "Valid email required.");
    21	  }
    22	
    23	  // Rate limit: max 3 magic links per email per 15 min
    24	  const fifteenMinAgo = new Date(Date.now() - 15 * 60_000).toISOString();
    25	  const recentTokens = await env.DB.prepare(
    26	    "SELECT COUNT(*) as cnt FROM magic_tokens WHERE email = ? AND created_at > ?"
    27	  )
    28	    .bind(email, fifteenMinAgo)
    29	    .first<{ cnt: number }>();
    30	
    31	  if ((recentTokens?.cnt ?? 0) >= 3) {
    32	    return apiError(ErrorCodes.RATE_LIMITED, "Too many sign-in attempts. Try again in 15 minutes.");
    33	  }
    34	
    35	  // Generate token
    36	  const tokenRaw = generateMagicToken();
    37	  const tokenHash = await hashApiKey(tokenRaw);
    38	  const now = isoNow();
    39	  const expiresAt = new Date(Date.now() + 15 * 60_000).toISOString();
    40	  const ip = request.headers.get("CF-Connecting-IP") ?? "";
    41	  const ipHash = ip ? await hashIp(ip) : null;
    42	
    43	  await env.DB.prepare(
    44	    `INSERT INTO magic_tokens (id, email, token_hash, created_at, expires_at, ip_hash)
    45	     VALUES (?, ?, ?, ?, ?, ?)`
    46	  )
    47	    .bind(generateId(), email, tokenHash, now, expiresAt, ipHash)
    48	    .run();
    49	
    50	  // Send email in background — respond immediately so UI doesn't freeze
    51	  const verifyUrl = `${env.APP_BASE_URL}/api/v1/auth/verify?token=${encodeURIComponent(tokenRaw)}`;
    52	
    53	  if (env.RESEND_API_KEY) {
    54	    ctx.waitUntil(
    55	      sendMagicLink(email, verifyUrl, env.RESEND_API_KEY).catch((err) => {
    56	        console.error("Failed to send magic link email:", err);
    57	      })
    58	    );
    59	  } else {
    60	    console.error("RESEND_API_KEY not configured — magic link not sent");
    61	  }
    62	
    63	  return Response.json({ ok: true, message: "If that email is valid, check your inbox." });
    64	}
