     4	
     5	interface RateLimitResult {
     6	  allowed: boolean;
     7	  reason?: string;
     8	}
     9	
    10	/**
    11	 * Check upload rate limit by IP hash.
    12	 * Uses D1 to count recent uploads from the same IP.
    13	 * This is a simple approach — for high-throughput,
    14	 * move to Workers KV or a rate-limit binding.
    15	 */
    16	export async function checkUploadRateLimit(
    17	  request: Request,
    18	  env: Env
    19	): Promise<RateLimitResult> {
    20	  const ip = request.headers.get("CF-Connecting-IP");
    21	  if (!ip) return { allowed: true };
    22	
    23	  const ipHash = await hashIp(ip);
    24	
    25	  // Check uploads in the last hour
    26	  const oneHourAgo = new Date(Date.now() - 3600_000).toISOString();
    27	  const countResult = await env.DB.prepare(
    28	    "SELECT COUNT(*) as cnt FROM items WHERE source_ip_hash = ? AND created_at > ?"
    29	  )
    30	    .bind(ipHash, oneHourAgo)
    31	    .first<{ cnt: number }>();
    32	
    33	  const recentUploads = countResult?.cnt ?? 0;
    34	
    35	  if (recentUploads >= ABUSE_BUDGET.MAX_UPLOADS_PER_IP_PER_HOUR) {
    36	    return {
    37	      allowed: false,
    38	      reason: `Rate limit exceeded. Maximum ${ABUSE_BUDGET.MAX_UPLOADS_PER_IP_PER_HOUR} uploads per hour.`,
    39	    };
    40	  }
    41	
    42	  // Check concurrent processing items
    43	  const processingResult = await env.DB.prepare(
    44	    "SELECT COUNT(*) as cnt FROM items WHERE source_ip_hash = ? AND status = 'processing'"
    45	  )
    46	    .bind(ipHash)
    47	    .first<{ cnt: number }>();
    48	
    49	  const processing = processingResult?.cnt ?? 0;
    50	
    51	  if (processing >= ABUSE_BUDGET.MAX_CONCURRENT_PROCESSING_PER_IP) {
    52	    return {
    53	      allowed: false,
    54	      reason: `Too many items processing. Wait for current uploads to complete.`,
    55	    };
    56	  }
    57	
    58	  return { allowed: true };
    59	}
    60	
    61	/**
    62	 * Check daily upload limit for authenticated users.
    63	 * Uses D1 to count uploads created today for the account.
    64	 */
    65	export async function checkDailyUploadLimit(
    66	  accountId: string,
    67	  plan: string,
    68	  env: Env
    69	): Promise<RateLimitResult> {
    70	  const limits = PLAN_LIMITS[plan] ?? PLAN_LIMITS.free;
    71	  const startOfDay = new Date();
    72	  startOfDay.setUTCHours(0, 0, 0, 0);
    73	
    74	  const countResult = await env.DB.prepare(
    75	    "SELECT COUNT(*) as cnt FROM items WHERE account_id = ? AND created_at > ?"
    76	  )
    77	    .bind(accountId, startOfDay.toISOString())
    78	    .first<{ cnt: number }>();
    79	
    80	  const todayUploads = countResult?.cnt ?? 0;
    81	
    82	  if (todayUploads >= limits.uploads_per_day) {
    83	    return {
    84	      allowed: false,
    85	      reason: `Daily upload limit reached. Your ${plan} plan allows ${limits.uploads_per_day} uploads per day.`,
    86	    };
    87	  }
    88	
    89	  return { allowed: true };
    90	}
