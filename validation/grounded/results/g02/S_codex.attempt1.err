    30	const VALID_FORMATS = new Set(["json", "md", "yaml", "txt", "prompt.md"]);
    31	const ITEM_ID_RE = /^[a-zA-Z0-9_-]+$/;
    32	const MAX_BATCH_SIZE = 20;
    33	const MCP_MAX_REQUESTS_PER_MINUTE = 60;
    34	
    35	// ── Rate limiter (in-memory, per-isolate) ───────────────────
    36	
    37	const rateLimitMap: Record<string, { count: number; resetAt: number }> = {};
    38	
    39	function checkMcpRateLimit(accountId: string): boolean {
    40	  const now = Date.now();
    41	
    42	  // Periodic cleanup: evict expired entries to prevent unbounded growth
    43	  if (Object.keys(rateLimitMap).length > 1000) {
    44	    for (const key in rateLimitMap) {
    45	      if (now > rateLimitMap[key].resetAt) delete rateLimitMap[key];
    46	    }
    47	  }
    48	
    49	  const entry = rateLimitMap[accountId];
    50	  if (!entry || now > entry.resetAt) {
    51	    rateLimitMap[accountId] = { count: 1, resetAt: now + 60_000 };
    52	    return true;
    53	  }
    54	  entry.count++;
    55	  return entry.count <= MCP_MAX_REQUESTS_PER_MINUTE;
    56	}
