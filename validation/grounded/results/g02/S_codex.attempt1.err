   115	    try {
   116	      const linkOrigin = new URL(link.href).origin;
   117	      if (linkOrigin === origin) {
   118	        internal.push(link);
   119	      } else {
   120	        external.push(link);
   121	      }
   122	    } catch {
   123	      // Invalid URL, skip
   124	    }
   125	  }
   126	
   127	  // Build ASCII path tree from internal links
   128	  const tree = buildPathTree(internal, origin);
   129	
   130	  // Compose the output
   131	  const lines: string[] = [];
   132	  lines.push(`# Sitemap: ${sourceUrl}`);
   133	  lines.push(`# Extracted: ${new Date().toISOString()}`);
   134	  lines.push(`# Internal links: ${internal.length} | External links: ${external.length}`);
   135	  lines.push("");
   136	  lines.push("## Site Structure");
   137	  lines.push("");
   138	  lines.push(tree);
   139	
   140	  if (external.length > 0) {
   141	    lines.push("");
   142	    lines.push("## External Links");
   143	    lines.push("");
   144	    for (const link of external.slice(0, 50)) {
   145	      lines.push(`  ${link.text}`);
   146	      lines.push(`  └─ ${link.href}`);
   147	    }
   148	    if (external.length > 50) {
   149	      lines.push(`  ... and ${external.length - 50} more`);
   150	    }
   151	  }
   152	
   153	  return lines.join("\n");
   154	}
   155	
   156	/**
   157	 * Build an ASCII tree from a list of internal links, organized by path segments.
   158	 */
   159	function buildPathTree(links: PageLink[], origin: string): string {
   160	  // Parse paths into a tree structure
   161	  interface TreeNode {
   162	    children: Map<string, TreeNode>;
   163	    label?: string; // link text
   164	    fullPath: string;
   165	    context?: string;
   166	  }
   167	
   168	  const root: TreeNode = { children: new Map(), fullPath: "/" };
   169	
   170	  for (const link of links) {
   171	    try {
   172	      const u = new URL(link.href);
   173	      const segments = u.pathname.split("/").filter(Boolean);
   174	      let current = root;
   175	
   176	      for (let i = 0; i < segments.length; i++) {
   177	        const seg = segments[i];
   178	        if (!current.children.has(seg)) {
   179	          current.children.set(seg, {
   180	            children: new Map(),
   181	            fullPath: "/" + segments.slice(0, i + 1).join("/"),
   182	          });
   183	        }
   184	        current = current.children.get(seg)!;
   185	      }
   186	
   187	      // Leaf node gets the link text and context
   188	      current.label = link.text;
   189	      current.context = link.context;
   190	    } catch {
   191	      // Skip invalid
   192	    }
   193	  }
   194	
   195	  // Render tree to ASCII
   196	  const lines: string[] = [];
   197	  lines.push(`${origin}/`);
   198	  renderNode(root, "", true, lines);
   199	  return lines.join("\n");
   200	}
   201	
   202	function renderNode(node: { children: Map<string, any>; label?: string; context?: string }, prefix: string, isLast: boolean, lines: string[]): void {
   203	  const entries = [...node.children.entries()].sort(([a], [b]) => a.localeCompare(b));
   204	
   205	  for (let i = 0; i < entries.length; i++) {
   206	    const [segment, child] = entries[i];
   207	    const last = i === entries.length - 1;
   208	    const connector = last ? "└── " : "├── ";
   209	    const label = child.label ? ` (${child.label})` : "";
   210	    const ctx = child.context && child.context !== "other" ? ` [${child.context}]` : "";
   211	    lines.push(`${prefix}${connector}${segment}/${label}${ctx}`);
   212	
   213	    const childPrefix = prefix + (last ? "    " : "│   ");
   214	    if (child.children.size > 0) {
   215	      renderNode(child, childPrefix, last, lines);
   216	    }
   217	  }
   218	}
